        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CategorizacaoCusto"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
