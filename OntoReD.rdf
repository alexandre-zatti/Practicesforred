    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InformarResponsavelPagamentoReD -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InformarResponsavelPagamentoReD">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
