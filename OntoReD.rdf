        <untitled-ontology-3:classificacaoPratica>Específica</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>Manter e descrever com clareza o documento de especificação de requisitos</untitled-ontology-3:descricao>
        <untitled-ontology-3:fluxoAtividades>&lt;p style=&quot;text-align: right;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;Figura 1 - Fluxo de atividades da pr&amp;aacute;tica &amp;ldquo;Manter e descrever com clareza o documento de especifica&amp;ccedil;&amp;atilde;o de requisitos&amp;rdquo;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXf8wBkf2RsHUKqITxbGkvYCvBC26dFItz7Z35dvDQ-ti-AdBUiCizrodBQ2AsTdkxh7iKYW9jXCc9vyoVBy7cWvJajJoqPmgh7v5OMsDSDHYqyEpje4ZtnlosZHaxuiFDADzlt6?key=LwtbXbTv-BvuWWo5voqBG3yl&quot; width=&quot;449&quot; height=&quot;582&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Fonte: Elaborado pelo autor (2024)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:fluxoAtividades>
