        <untitled-ontology-3:nome>Tipo da dívida técnica</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TodasHUCumpridas -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TodasHUCumpridas">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarParteCasoUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;O sistema de software cumpre todas as hist&amp;oacute;rias contadas pelo caso de uso.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Todas as hist&amp;oacute;rias:&lt;/strong&gt; Todas as hist&amp;oacute;rias que define foram implementadas e testadas com sucesso.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Todas as partes de casos de uso s&amp;atilde;o &amp;apos;verificadas&amp;apos;:&amp;nbsp;&lt;/strong&gt;Todas as fatias de casos de uso do caso de uso est&amp;atilde;o no estado verificado.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;&lt;b&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Todas as hist&amp;oacute;rias cumpridas&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ToleranciaErro -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ToleranciaErro">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Pagamento"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InserirEstrategiasExcecaoTempo"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Inserir estrat&amp;eacute;gias de exce&amp;ccedil;&amp;atilde;o de tempo e execu&amp;ccedil;&amp;atilde;o local da d&amp;iacute;vida.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Tolerância a erros</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TotalmenteDescrito -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TotalmenteDescrito">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EcontrarAtoreseUC"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;As narrativas de casos de uso podem ser usadas para fornecer especifica&amp;ccedil;&amp;otilde;es de requisitos altamente detalhadas, evoluindo-as para seu n&amp;iacute;vel de detalhe mais abrangente, ou seja, Totalmente Descrito. Os detalhes adicionais podem ser necess&amp;aacute;rios para explicar a aus&amp;ecirc;ncia de conhecimentos especializados dentro da equipa, a falta de acesso &amp;agrave;s partes interessadas ou para comunicar eficazmente requisitos complexos.&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Este n&amp;iacute;vel de detalhe &amp;eacute; particularmente &amp;uacute;til para aqueles casos de utiliza&amp;ccedil;&amp;atilde;o em que um mal-entendido do conte&amp;uacute;do pode ter graves consequ&amp;ecirc;ncias de seguran&amp;ccedil;a, financeiras ou jur&amp;iacute;dicas. Tamb&amp;eacute;m pode ser &amp;uacute;til ao terceirizar ou terceirizar o desenvolvimento de software.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;Cada etapa de cada fluxo de eventos foi descrita em detalhes&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Os fluxos de eventos capturam todas as entradas e sa&amp;iacute;das do Sistema de Software.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Todos os pontos de decis&amp;atilde;o e c&amp;aacute;lculos est&amp;atilde;o completos e claramente definidos.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;&amp;Eacute; test&amp;aacute;vel de forma independente, compreens&amp;iacute;vel, inequ&amp;iacute;voco, correto, completo e ating&amp;iacute;vel.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Totalmente descrito&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TreinamentoPadroesER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TreinamentoPadroesER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConfirmacaoInformacaoER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecutadoFonteInformacaoER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecutadoTecnicaER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FinalizadoFonteInformacaoER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FinalizadoTecnicaER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FonteInformacaoER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OrientacoesER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PadraoOrientacoesRegistroER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoFonteInformacaoER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoTecnicaER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoTER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizacaoER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegistroInformacaoER"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TecnicaER"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MelhorarProcessoDesenvolvimento"/>
        <untitled-ontology-3:podeMitigar rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DificuldadeCompreensaoDemanda"/>
        <untitled-ontology-3:podeMitigar rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FalhaIdentificacaoRequisitos"/>
        <untitled-ontology-3:podeMitigar rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#SistemaGerenciamentoRequisitosAusenteIneficaz"/>
        <untitled-ontology-3:apresentacao>&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;A organiza&amp;ccedil;&amp;atilde;o dos elementos da pr&amp;aacute;tica&amp;nbsp;&lt;strong&gt;Treinamento de padr&amp;otilde;es de elicita&amp;ccedil;&amp;atilde;o de requisitos &amp;eacute; apresentada na Figura 1&lt;/strong&gt; .&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Figura 1 - Organiza&amp;ccedil;&amp;atilde;o dos elementos da pr&amp;aacute;tica treinamento de padr&amp;otilde;es de elicita&amp;ccedil;&amp;atilde;o de requisitos&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;&lt;span style=&quot;border:none;display:inline-block;overflow:hidden;width:417px;height:373px;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; style=&quot;width: 397px; height: 366.667px;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Fonte: Elaborado pelo autor (2024)&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:apresentacao>
        <untitled-ontology-3:apresentacao>&lt;p&gt;A elicita&amp;ccedil;&amp;atilde;o de requisitos &amp;eacute; a etapa inicial do processo de requisitos e tem como objetivo compreender o problema, identificar as partes interessadas e coletar informa&amp;ccedil;&amp;otilde;es essenciais para definir corretamente o software a ser desenvolvido. O documento destaca que ela &amp;eacute; a primeira atividade na constru&amp;ccedil;&amp;atilde;o de uma compreens&amp;atilde;o do problema que o software precisa resolver e que uma elicita&amp;ccedil;&amp;atilde;o bem conduzida ajuda a minimizar a incompletude dos requisitos.&lt;/p&gt;</untitled-ontology-3:apresentacao>
        <untitled-ontology-3:classificacaoPratica>Específica</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Sugere-se treinamento de padr&amp;otilde;es de elicita&amp;ccedil;&amp;atilde;o de requisitos para sinalizar e padronizar a forma como os requisitos devem ser elicitados e especificados.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:fluxoAtividades>&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;
        &lt;font dir=&quot;auto&quot; style=&quot;vertical-align: inherit;&quot;&gt;
            &lt;font dir=&quot;auto&quot; style=&quot;vertical-align: inherit;&quot;&gt;O fluxo de atividades &amp;eacute; apresentado na Figura 2. A sequ&amp;ecirc;ncia das atividades est&amp;aacute; sinalizada pelo n&amp;uacute;mero.&amp;nbsp;&lt;/font&gt;
        &lt;/font&gt;
    &lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;
        &lt;font dir=&quot;auto&quot; style=&quot;vertical-align: inherit;&quot;&gt;
            &lt;font dir=&quot;auto&quot; style=&quot;vertical-align: inherit;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Figura 2 - Fluxo de atividades do treinamento de padr&amp;otilde;es de elicita&amp;ccedil;&amp;atilde;o de requisitos&lt;/font&gt;
        &lt;/font&gt;
    &lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;&lt;span style=&quot;border:none;display:inline-block;overflow:hidden;width:417px;height:373px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; style=&quot;width: 355px; height: 317.462px;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;
        &lt;font dir=&quot;auto&quot; style=&quot;vertical-align: inherit;&quot;&gt;
            &lt;font dir=&quot;auto&quot; style=&quot;vertical-align: inherit;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Fonte: Elaborado pelo autor (2024)&lt;/font&gt;
        &lt;/font&gt;
    &lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:fluxoAtividades>
        <untitled-ontology-3:glossario>&lt;div align=&quot;left&quot;&gt;
    &lt;table style=&quot;border: none; border-collapse: collapse; width: 100%;&quot;&gt;
        &lt;tbody&gt;
            &lt;tr&gt;
                &lt;td colspan=&quot;3&quot; style=&quot;color:#d9d9d9;background-color:#d9d9d9;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Gloss&amp;aacute;rio dos elementos da pr&amp;aacute;tica&lt;/span&gt;&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;color:#d9d9d9;background-color:#d9d9d9;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Elemento&lt;/span&gt;&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;color:#d9d9d9;background-color:#d9d9d9;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;Iacute;cone&lt;/span&gt;&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;color:#d9d9d9;background-color:#d9d9d9;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Descri&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
