    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ComunicacaoFaceFace -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ComunicacaoFaceFace">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Identificacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ComunicacaoPartesInteressadasStakeholders"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarCerimonias"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;A comunica&amp;ccedil;&amp;atilde;o face a face consiste na comunica&amp;ccedil;&amp;atilde;o sobre os requisitos de maneira hier&amp;aacute;rquica e baseada em e-mails e documentos.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;&amp;Eacute; recomend&amp;aacute;vel que os profissionais de software se comuniquem diretamente com seus pares e partes interessadas.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;A comunica&amp;ccedil;&amp;atilde;o face a face &amp;eacute; eficiente na troca de informa&amp;ccedil;&amp;otilde;es entre diferentes stakeholders, auxiliando na identifica&amp;ccedil;&amp;atilde;o das d&amp;iacute;vidas t&amp;eacute;cnicas, sendo considerada essencial.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Comunicação face a face</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ComunicacaoPartesInteressadasStakeholders -->

