            &lt;tr&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Pr&amp;aacute;tica para mitigar a d&amp;iacute;vida&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXcqBQbeSm49XZWSjo42k1KchYMBxE5pVvd89roJ_bfN0mrfw1yjeCOYriFcUdvDiNi5ANBhicYMXF8C_KXOgsBErsevueiSL3t3wVIw2vvQIA1v5B8kgKjOxSsbs43i_mSYe_ihtg?key=3fwmoAqsw09K6pLWlOyGIhYi&quot; width=&quot;34&quot; height=&quot;33&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo;Uma pr&amp;aacute;tica &amp;eacute; uma abordagem repet&amp;iacute;vel para fazer algo com um objetivo espec&amp;iacute;fico em mente. Uma pr&amp;aacute;tica descrita como lidar com um aspecto espec&amp;iacute;fico de um empreendimento de engenharia de software, incluindo as especifica&amp;ccedil;&amp;otilde;es de todos os elementos relevantes necess&amp;aacute;rios para expressar a orienta&amp;ccedil;&amp;atilde;o de trabalho desejada para atingir o objetivo da pr&amp;aacute;tica. Uma pr&amp;aacute;tica pode ser definida como uma composi&amp;ccedil;&amp;atilde;o de outras pr&amp;aacute;ticas&amp;rdquo; (Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Produto de trabalho&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXfIM3G9LuhtZFvMffqC0zOT6-azEu6g7jBmdNs2hXrWXD4UTBXbpVw_8J2M8kj0TjkTpQFoFoooZBd4E6023Jlj2wLktmiG6Rk4NXwTVmbVaLYu_0Vfngfl5qdWFBHeymbSQf9wJw?key=3fwmoAqsw09K6pLWlOyGIhYi&quot; width=&quot;25&quot; height=&quot;25&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border-left:solid #000000 1pt;border-right:solid #000000 1pt;border-top:solid #000000 1pt;border-bottom:solid #000000 0.5pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;color:#333333;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Um produto de trabalho &amp;eacute; um artefato de valor e relev&amp;acirc;ncia para um empreendimento de engenharia de software. Um produto de trabalho pode ser um documento ou um peda&amp;ccedil;o de software, ou outras entidades criadas. &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;rdquo;(Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Atividade do produto de trabalho&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border-left:solid #000000 1pt;border-right:solid #000000 0.5pt;border-top:solid #000000 1pt;border-bottom:solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXcsEAWwYthGRw7yf-2cJVYZaphA1CLYdStgWXemD1-PC2z86csO0Fc5faHlsuYsTA6T799ZlUyv0kS2J9aebIqF43YtOoJIS5M5tdxjx-QryG6lvPSb3qOGWIp43qaUXx4nxcS-pg?key=3fwmoAqsw09K6pLWlOyGIhYi&quot; width=&quot;25&quot; height=&quot;25&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 0.5pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;color:#333333;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Uma atividade define uma ou mais abordagens para executar algum trabalho a ser executado e pode recomendar a&amp;ccedil;&amp;otilde;es sobre alfas e/ou produtos de trabalho para executar esse trabalho. &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;rdquo;(Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Espa&amp;ccedil;o atividade&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXdHEF6sLBhnegkQPDup2iOux_IgVZ4Ewxnbr4iH0BcY-UE7AngXpuhrDIhueJa8eHHAPm1mvwCuz29clY5VVrWSb6gqDYJd2hOFkLICztCnI71fJfpPdkF-UvZyc2Hq-xkBAbV0RA?key=3fwmoAqsw09K6pLWlOyGIhYi&quot; width=&quot;25&quot; height=&quot;25&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border-left:solid #000000 1pt;border-right:solid #000000 1pt;border-top:solid #000000 0.5pt;border-bottom:solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;color:#333333;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo;Um espa&amp;ccedil;o reservado para algo a ser feito no empreendimento de engenharia de software. &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;rdquo;(Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;&lt;br&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Alfa&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXf-80w0n-VulIvVl3axoJ5ToMEHZSeVejS5vG3rloexhqj6PHwI2v5-AiLZlZ5wBkDxKn-l8unLY4wPHC5eJjAOdpo04m5RKEs-AGTWnjdjpIgJc1yPdSc2W8h-tlmkmR9Un-rBIg?key=3fwmoAqsw09K6pLWlOyGIhYi&quot; width=&quot;25&quot; height=&quot;25&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;color:#333333;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Um alfa representa e mant&amp;eacute;m o estado de algum elemento, apar&amp;ecirc;ncia ou abstra&amp;ccedil;&amp;atilde;o em um empreendimento que tem um estado discern&amp;iacute;vel e o conhecimento de cujo estado &amp;eacute; necess&amp;aacute;rio para entender o estado de progresso e/ou sa&amp;uacute;de do empreendimento&amp;rdquo;&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;(Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Estado Alpha&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color:#333333;background-color:#ffffff;font-size:10.5pt;font-family:&apos;Helvetica Neue&apos;,sans-serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXdrHm5ey3ePKToqK4164qe01anSdG7ipdC5OUqXT2-A-oxfKsHHhTosa0fkPzBwPicaFCqbzB42TGHqbwnj8HCQlJnaYm_jrAIc-DSxncukxq7odOoM7qgtVhuW8SelHiOTzpEG?key=3fwmoAqsw09K6pLWlOyGIhYi&quot; width=&quot;25&quot; height=&quot;25&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;color:#333333;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo;Um estado alfa &amp;eacute; uma previs&amp;atilde;o do estado de progresso de um alfa. O estado de um alfa &amp;eacute; determinado pela avalia&amp;ccedil;&amp;atilde;o de itens da lista de verifica&amp;ccedil;&amp;atilde;o&amp;rdquo;&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;(Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
        &lt;/tbody&gt;
    &lt;/table&gt;
&lt;/div&gt;</untitled-ontology-3:glossario>
        <untitled-ontology-3:introducao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Introdu&amp;ccedil;&amp;atilde;o&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Esta pr&amp;aacute;tica permite &amp;agrave;s equipes:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Descrever exatamente o que um sistema de software deve fazer.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Agrupar partes dos requisitos.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Alterar a prioridade do que o cliente deseja a qualquer momento.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Produzir um modelo visual simples e requisitos significativos que sejam compreens&amp;iacute;veis tanto para desenvolvedores quanto para clientes.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Aproveitar os benef&amp;iacute;cios do desenvolvimento iterativo.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:introducao>
        <untitled-ontology-3:nome>Elaborar artefato da UML - Diagrama de caso de uso</untitled-ontology-3:nome>
        <untitled-ontology-3:quandoAplicar>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Quando aplicar&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;A Pr&amp;aacute;tica do Caso de Uso deve ser usada quando as equipes pretendem:&lt;/strong&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Garanta que os clientes obtenham exatamente o que desejam, na ordem e quando desejam.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Entregue software testado antecipadamente.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Prove que o novo software funcionar&amp;aacute; bem no in&amp;iacute;cio do projeto.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Permitir e gerenciar mudan&amp;ccedil;as nos requisitos de software durante o projeto.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Capture os requisitos antecipadamente e rapidamente, de uma forma aceit&amp;aacute;vel e acess&amp;iacute;vel tanto para o cliente quanto para a equipe de desenvolvimento.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:quandoAplicar>
        <untitled-ontology-3:referenciaRE>&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Use-Case 2.0 eBook: &lt;u&gt;&lt;a href=&quot;https://www.ivarjacobson.com/publications/white-papers/use-case-ebook&quot; target=&quot;_blank&quot; style=&quot;color: rgb(75, 110, 198);&quot;&gt;https://www.ivarjacobson.com/publications/white-papers/use-case-ebook&lt;/a&gt;&lt;/u&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Use-Case 2.0: The Hub of Software Development: &lt;u&gt;&lt;a href=&quot;https://www.ivarjacobson.com/publications/white-papers/use-case-hub-software-development&quot; target=&quot;_blank&quot; style=&quot;color: rgb(75, 110, 198);&quot;&gt;https://www.ivarjacobson.com/publications/white-papers/use-case-hub-software-development&lt;/a&gt;&lt;/u&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;For details of the training, support and mentoring available for Use Case 2.0 Essentials visit &lt;u&gt;&lt;a href=&quot;http://www.ivarjacobson.com/&quot; target=&quot;_blank&quot; style=&quot;color: rgb(75, 110, 198);&quot;&gt;www.ivarjacobson.com&lt;/a&gt;&lt;/u&gt;.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:referenciaRE>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ElementosImplementacaoIdentificados -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ElementosImplementacaoIdentificados">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarParteCasoUso"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;O n&amp;iacute;vel de detalhe mais leve que captura apenas os elementos do sistema, novos e existentes, que participar&amp;atilde;o do caso de uso.&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Este n&amp;iacute;vel de detalhe &amp;eacute; adequado para pequenas equipes que trabalham em estreita colabora&amp;ccedil;&amp;atilde;o e desenvolvem sistemas simples com uma arquitetura conhecida. Pode ser necess&amp;aacute;rio adicionar mais detalhes se o seu sistema for complexo ou se a sua equipe for grande ou distribu&amp;iacute;da.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;Os elementos participantes foram definidos.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Novos elementos necess&amp;aacute;rios foram sugeridos.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Elementos de implementa&amp;ccedil;&amp;atilde;o identificados&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ElicitacaoREQ -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ElicitacaoREQ">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FaseEngenhariaRequisitos"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DesconhecimentoNegocio"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DificuldadeCompreensaoDemanda"/>
        <untitled-ontology-3:faseER rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:faseER>
        <untitled-ontology-3:nome>Elicitação de Requisitos</untitled-ontology-3:nome>
        <untitled-ontology-3:sigla>ER</untitled-ontology-3:sigla>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmDesenvolvimentoIA -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmDesenvolvimentoIA">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItemArtefatoRastreado"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Em desenvolvimento&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;font-size: 12px;&quot;&gt;&lt;span style=&apos;color: rgb(0, 0, 0);font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os itens ou artefatos est&amp;atilde;o sendo acompanhados e atualizados conforme solicita&amp;ccedil;&amp;atilde;o de mudan&amp;ccedil;as.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmDesenvolvimentoRIA -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmDesenvolvimentoRIA">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RelacionamentoItensArtefatos"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Em desenvolvimento&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;font-size: 12px;&quot;&gt;&lt;span style=&apos;color: rgb(0, 0, 0);font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;O relacionamento entre os itens ou projetos est&amp;aacute; sendo acompanhado e atualizado conforme solicita&amp;ccedil;&amp;atilde;o de mudan&amp;ccedil;as.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmExecucao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmExecucao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MatrizRastreabilidade"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A matriz de rastreabilidade &amp;eacute; constru&amp;iacute;da considerando o tipo de rastreabilidade, os itens a serem rastreados e seus relacionamentos.&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;No entanto, a matriz deve ser preenchida quando todos os requisitos forem negociados e acordados com o cliente no in&amp;iacute;cio do ciclo de desenvolvimento de software&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 8px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(KECHI, 2011)&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Na primeira coluna, s&amp;atilde;o informados todos os itens que ser&amp;atilde;o rastreados, os quais podem ser:&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
        &lt;ul style=&quot;font-size: initial;&quot;&gt;
            &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os requisitos de neg&amp;oacute;cios, requisitos funcionais, requisitos n&amp;atilde;o funcionais, casos de uso, casos de teste ou m&amp;oacute;dulos de c&amp;oacute;digo.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Na primeira linha s&amp;atilde;o listados os mesmos elementos ou aqueles que pretende-se rastrear o relacionamento entre eles, conforme a finalidade dessa rastreabilidade.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ap&amp;oacute;s, s&amp;atilde;o sinalizados com um &amp;ldquo;X&amp;rdquo; a c&amp;eacute;lula da matriz que deseja-se rastrear o relacionamento entre determinados itens.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Em execu&amp;ccedil;&amp;atilde;o&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmExecucaoGR -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmExecucaoGR">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GrafoRastreabilidade"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O Grafo de rastreabilidade &amp;eacute; constru&amp;iacute;do considerando os tipos de relacionamentos para cada tipo de artefato a serem rastreados.&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;No entanto, o grafo deve ser preenchido quando todos os requisitos forem negociados e acordados com o cliente no in&amp;iacute;cio do ciclo de desenvolvimento de software&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-size: 8px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(KECHI, 2011)&lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Em execu&amp;ccedil;&amp;atilde;o&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmitirNotificacoesLimitesNaoAlcancados -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmitirNotificacoesLimitesNaoAlcancados">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemLimiar"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Emitir notificações de limites não realizados</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EntenderElementosCasoUso -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EntenderElementosCasoUso">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EspacoAtividade"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcompanharManterRastreabilidadeRequisitos"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarRastreabilidadeRequisitos"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EntenderRequisitos -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EntenderRequisitos">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EspacoAtividade"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcompanharManterRastreabilidadeRequisitos"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ColetarConsolidarProblemas"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConcordarDefinicaoConcluidoPB"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinirEscopoRevisao"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DetectarFalhasRevReq"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EcontrarAtoreseUC"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararItemProductBacklog"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RefinarProductBacklog"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Espaco Atividade&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &lt;strong&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Estabelecer um entendimento compartilhado sobre o que o sistema a ser produzido deve fazer. &amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;&lt;strong&gt;&amp;nbsp; Entender os requisitos para: &amp;nbsp;&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Definir o escopo do sistema.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Entender como o sistema ir&amp;aacute; gerar valor.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Combinar o que o sistema far&amp;aacute;.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Identificar as maneiras espec&amp;iacute;ficas de usar e testar o sistema.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Conduzir o desenvolvimento do sistema.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Atividades dispon&amp;iacute;veis - Contempla:&lt;/u&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;;color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&apos;&gt;&lt;strong&gt;Encontrar atores e casos de uso:&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;;color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&apos;&gt;Concordar com os objetivos e o valor do sistema, identificando formas de us&amp;aacute;-lo e test&amp;aacute;-lo.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Inspecionar e adaptar os casos de uso:&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&apos;&gt;Lidar com as mudan&amp;ccedil;as e acompanhe o progresso ajustando o modelo de casos de uso, os casos de uso e as fatias de casos de uso.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Preparar uma fatia de caso de uso:&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&apos;&gt;Uma fatia de caso de uso &amp;eacute; preparada para desenvolvimento elaborando sua narrativa e casos de teste.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Dividir os casos de uso:&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&apos;&gt;Identificar fatias de casos de uso com base em casos de uso para auxiliar na implementa&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;font-size: 1em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;&lt;strong&gt;Refer&amp;ecirc;ncias:&lt;/strong&gt;&lt;/u&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Essence Standard (OMG), consulte &lt;u&gt;&lt;a href=&quot;http://www.omg.org/spec/Essence/1.1/&quot; target=&quot;_blank&quot; style=&quot;color: rgb(75, 110, 198);&quot;&gt;http://www.omg.org/spec/Essence/1.1/&lt;/a&gt;&lt;/u&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;A Ess&amp;ecirc;ncia da Engenharia de Software: Aplicando o Kernel SEMAT, por Ivar Jacobson, Pan-Wei Ng, Paul E. McMahon, Ian Spence e Svante Lidman, Addison-Wesley 2013.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Entender os Requisitos&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequenciaEspacoAtividade rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequenciaEspacoAtividade>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Erro -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Erro">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Alpha"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApresentarResultadoRevReq"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ColetarConsolidarProblemas"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConsolidarRegistrarUnificacaoProblemas"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CorrigirErrosUnificacao"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinirEscopoRevisao"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DetectarFalhasRevReq"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConcluidoRevReq"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Definido"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProntoparaCorrecao"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Apresenta&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Erro caracteriza-se como um problema em produtos de trabalho voltado aos requisitos, como um documento de especifica&amp;ccedil;&amp;atilde;o de requisitos.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 14px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Um erro pode ser categorizado em&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-size: 10px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(Geraldi; Oliveira 2017)&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 10px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;:&lt;/span&gt;&lt;span style=&apos;font-size: 14px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;De omiss&amp;atilde;o:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;qualquer informa&amp;ccedil;&amp;atilde;o necess&amp;aacute;ria que tenha sido omitida.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Fato Incorreto:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;informa&amp;ccedil;&amp;atilde;o contradit&amp;oacute;ria com o conhecimento que se tem no dom&amp;iacute;nio de aplica&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Inconsist&amp;ecirc;ncia:&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; font-size: 12px;&apos;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;informa&amp;ccedil;&amp;atilde;o que consta de forma repetitiva, escrita de forma diferente.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ambiguidade:&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; font-size: 12px;&apos;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;quando a informa&amp;ccedil;&amp;atilde;o pode levar a m&amp;uacute;ltiplas interpreta&amp;ccedil;&amp;otilde;es.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Informa&amp;ccedil;&amp;atilde;o Estranha:&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; font-size: 12px;&apos;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;qualquer informa&amp;ccedil;&amp;atilde;o que, embora relacionada ao dom&amp;iacute;nio, n&amp;atilde;o &amp;eacute; necess&amp;aacute;ria para o sistema.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Outros:&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; font-size: 12px;&apos;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;qualquer outro tipo de erro que n&amp;atilde;o se encaixe nas outras categorias. Exemplo: declara&amp;ccedil;&amp;otilde;es em se&amp;ccedil;&amp;otilde;es erradas.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Erro&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EsbocoEssencial -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EsbocoEssencial">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EcontrarAtoreseUC"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&amp;Agrave;s vezes &amp;eacute; necess&amp;aacute;rio esclarecer as responsabilidades do sistema e dos seus intervenientes durante a realiza&amp;ccedil;&amp;atilde;o do caso de uso. Um esbo&amp;ccedil;o com marcadores captura essas responsabilidades, mas n&amp;atilde;o define claramente quais partes do caso de uso s&amp;atilde;o assumidas pelo sistema e quais s&amp;atilde;o assumidas pelo(s) ator(es).&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 17.6px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Neste n&amp;iacute;vel de detalhe a narrativa torna-se uma descri&amp;ccedil;&amp;atilde;o do di&amp;aacute;logo entre o sistema e os seus atores. &amp;Eacute; particularmente &amp;uacute;til ao estabelecer a arquitetura de um novo sistema ou ao tentar estabelecer uma nova experi&amp;ecirc;ncia de usu&amp;aacute;rio.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;O caso de uso foi expresso como um di&amp;aacute;logo entre os atores e o sistema.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Existem etapas individuais para cada ator e responsabilidade do sistema.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Esbo&amp;ccedil;o essencial&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EsbocoMarcadores -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EsbocoMarcadores">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EcontrarAtoreseUC"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&lt;strong&gt;Esbo&amp;ccedil;o com marcadores&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;O caso de uso deve ser delineado para entender seu tamanho e complexidade. Este n&amp;iacute;vel de detalhe tamb&amp;eacute;m permite uma gest&amp;atilde;o eficaz do &amp;acirc;mbito, uma vez que o esbo&amp;ccedil;o permite que as diferentes partes do caso de utiliza&amp;ccedil;&amp;atilde;o sejam priorizadas umas contra as outras e, se necess&amp;aacute;rio, programadas para diferentes lan&amp;ccedil;amentos.&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Este &amp;eacute; o n&amp;iacute;vel de detalhe mais leve que permite que o caso de uso seja dividido e o desenvolvimento avance. &amp;Eacute; adequado para aquelas equipes que est&amp;atilde;o em estreita colabora&amp;ccedil;&amp;atilde;o com seus usu&amp;aacute;rios e s&amp;atilde;o capazes de preencher quaisquer detalhes faltantes por meio de conversas e da conclus&amp;atilde;o de casos de teste que os acompanham.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;O fluxo b&amp;aacute;sico do caso de uso foi descrito usando frases simples organizadas em etapas sequenciais.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Os fluxos alternativos s&amp;atilde;o identificados e nomeados.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 17.6px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;O caso de uso deve ser delineado para entender seu tamanho e complexidade. Este n&amp;iacute;vel de detalhe tamb&amp;eacute;m permite uma gest&amp;atilde;o eficaz do &amp;acirc;mbito, uma vez que o esbo&amp;ccedil;o permite que as diferentes partes do caso de utiliza&amp;ccedil;&amp;atilde;o sejam priorizadas umas contra as outras e, se necess&amp;aacute;rio, programadas para diferentes lan&amp;ccedil;amentos.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 17.6px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Este &amp;eacute; o n&amp;iacute;vel de detalhe mais leve que permite que o caso de uso seja dividido e o desenvolvimento avance. &amp;Eacute; adequado para aquelas equipes que est&amp;atilde;o em estreita colabora&amp;ccedil;&amp;atilde;o com seus usu&amp;aacute;rios e s&amp;atilde;o capazes de preencher quaisquer detalhes faltantes por meio de conversas e da conclus&amp;atilde;o de casos de teste que os acompanham.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Espera-se que: &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;O fluxo b&amp;aacute;sico do caso de uso foi descrito usando frases simples organizadas em etapas sequenciais.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;Os fluxos alternativos s&amp;atilde;o identificados e nomeados.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Esbo&amp;ccedil;o com marcadores&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Escopo -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Escopo">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; font-weight: bold;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;&lt;strong&gt;A fatia do caso de uso foi definida e a extens&amp;atilde;o das hist&amp;oacute;rias cobertas foi esclarecida.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;&lt;strong&gt;Hist&amp;oacute;rias&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;strong&gt;&amp;nbsp;foram identificadas:&amp;nbsp;&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;As hist&amp;oacute;rias (uma ou mais) que formam a fatia foram identificadas.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Os requisitos cobertos s&amp;atilde;o claros:&lt;/strong&gt; Est&amp;aacute; claro quais fluxos de casos de uso, requisitos especiais e defini&amp;ccedil;&amp;otilde;es de apoio s&amp;atilde;o cobertos pela fatia.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;A prioridade relativa &amp;eacute; conhecida:&amp;nbsp;&lt;/strong&gt;A prioridade da fatia em rela&amp;ccedil;&amp;atilde;o &amp;agrave;s outras fatias &amp;eacute; conhecida.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;O trabalho de implementa&amp;ccedil;&amp;atilde;o foi estimado:&lt;/strong&gt; O trabalho necess&amp;aacute;rio para concluir a implementa&amp;ccedil;&amp;atilde;o e teste da fatia foi estimado. &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Escopo&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EspecificacaoREQ -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EspecificacaoREQ">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FaseEngenhariaRequisitos"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AusenciaDocumentoESR"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DocumentoESRInadequada"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DocumentoESRMalElaborado"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequirementsSmells"/>
        <untitled-ontology-3:faseER rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:faseER>
        <untitled-ontology-3:nome>Especificação de Requisitos</untitled-ontology-3:nome>
        <untitled-ontology-3:sigla>ESR</untitled-ontology-3:sigla>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstabelecerRegrasPropagacaoReD -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstabelecerRegrasPropagacaoReD">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegrasPropagacao"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Estabelecer regras de propagação da dívida de requisitos</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstimarDTExperiencia -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstimarDTExperiencia">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Mensuracao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarEstimativaCustoItemReD"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Estimar d&amp;iacute;vida de requisitos de acordo com a experi&amp;ecirc;ncia e especializa&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Estimar a dívida de requisitos</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstimarTiposCustoManuseioDivida -->

