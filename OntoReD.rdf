        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#VerificarListaCenariosDividaOcorre"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;A lista de controle permite a verifica&amp;ccedil;&amp;atilde;o de uma lista de cen&amp;aacute;rios predefinidos em que ocorre.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Lista de Controle</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


