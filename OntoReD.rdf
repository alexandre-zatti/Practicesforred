        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Refinamento requisitos por meio da defini&amp;ccedil;&amp;atilde;o iterativa de requisitos. Podem trabalhar com sprints/releases e t&amp;eacute;cnicas de UX (Experi&amp;ecirc;ncia do Usu&amp;aacute;rio).&lt;/span&gt;&lt;/p&gt; &lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Refinamento dos requisitos</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RefinarProductBacklog -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RefinarProductBacklog">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AtividadeProdutoTrabalho"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProductBacklogX"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Atividade Produto Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;p style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: start; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Obter e manter o Backlog do Produto vis&amp;iacute;vel, atualizado e em boas condi&amp;ccedil;&amp;otilde;es de funcionamento, com itens de alta prioridade bem compreendidos.&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Refinar o Backlog do Produto&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegistradoCA -->

