    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstruturaHUCompreendida -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstruturaHUCompreendida">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;&lt;strong&gt;A estrutura da narrativa do caso de uso foi compreendida o suficiente para que a equipe comece a trabalhar identificando e implementando as primeiras fatias do caso de uso.&lt;/strong&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;strong&gt;Fluxo b&amp;aacute;sico determinado: &lt;/strong&gt;As principais etapas do fluxo b&amp;aacute;sico foram determinadas.&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;strong&gt;Natureza de outros fluxos determinada:&lt;/strong&gt; Foram determinados o tipo e a natureza dos demais fluxos que comp&amp;otilde;em o caso de uso.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;strong&gt;O in&amp;iacute;cio e o fim s&amp;atilde;o claros:&lt;/strong&gt; O in&amp;iacute;cio e o fim do caso de uso s&amp;atilde;o claros.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;strong&gt;As fatias mais importantes s&amp;atilde;o &amp;apos;Preparadas&amp;apos;:&lt;/strong&gt; As fatias de caso de uso mais importantes (aquelas que cobrem o comportamento essencial do caso de uso) est&amp;atilde;o no estado Preparado.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;b&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;&lt;strong&gt;Estrutura da hist&amp;oacute;ria compreendida&lt;/strong&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Estruturada -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Estruturada">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EcontrarAtoreseUC"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloCasoUso"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;O modelo de casos de uso geralmente cont&amp;eacute;m informa&amp;ccedil;&amp;otilde;es redundantes, como sequ&amp;ecirc;ncias comuns ou padr&amp;otilde;es de intera&amp;ccedil;&amp;atilde;o. Estruturar o modelo de casos de uso &amp;eacute; a maneira de lidar com essas redund&amp;acirc;ncias.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Para sistemas grandes e complexos, especialmente aqueles que s&amp;atilde;o usados para fornecer funcionalidades semelhantes em muitos contextos diferentes, a estrutura&amp;ccedil;&amp;atilde;o do modelo de casos de uso pode ajudar na compreens&amp;atilde;o, eliminar desperd&amp;iacute;cios e ajudar a encontrar elementos reutiliz&amp;aacute;veis.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Espera-se que:&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Os relacionamentos de &amp;apos;include&amp;apos; e &amp;apos;generaliza&amp;ccedil;&amp;atilde;o&amp;apos; s&amp;atilde;o usados para melhorar a clareza do modelo de casos de uso. A pergunta a ser feita ao estruturar o modelo &amp;eacute;: &amp;apos;Como podemos tornar o modelo de casos de uso mais compreens&amp;iacute;vel para as partes interessadas, eliminando os pontos em comum?&amp;apos;&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Os relacionamentos &amp;apos;extend&amp;apos; s&amp;atilde;o usados para expressar o comportamento de extens&amp;atilde;o, ou seja, fluxos de eventos adicionados a casos de uso completos e existentes.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;O modelo de casos de uso ainda &amp;eacute; compreens&amp;iacute;vel para uma parte interessada novata. Isto pode ser alcan&amp;ccedil;ado atrav&amp;eacute;s de uma refatora&amp;ccedil;&amp;atilde;o cautelosa e da explica&amp;ccedil;&amp;atilde;o do modelo de casos de uso em um ou mais diagramas.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;Estruturada&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EvoluirSoftware -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EvoluirSoftware">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Reengenharia"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Evoluir o software</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecucaoER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecucaoER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PadraoOrientacoesRegistroER"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Durante a execu&amp;ccedil;&amp;atilde;o das atividades de elicita&amp;ccedil;&amp;atilde;o, o foco &amp;eacute; coletar informa&amp;ccedil;&amp;otilde;es proativamente junto aos stakeholders utilizando as t&amp;eacute;cnicas de elicita&amp;ccedil;&amp;atilde;o definidas na prepara&amp;ccedil;&amp;atilde;o.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A metodologia e caracter&amp;iacute;sticas de cada t&amp;eacute;cnica devem ser observadas e consideradas, pois cada t&amp;eacute;cnica tem suas especificidades.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Recomenda&amp;ccedil;&amp;otilde;es para execu&amp;ccedil;&amp;atilde;o da t&amp;eacute;cnica&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 8px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(VAZQUEZ; SIM&amp;Otilde;ES 2016)&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;:&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Durante a execu&amp;ccedil;&amp;atilde;o da t&amp;eacute;cnica, evitar o desvio do escopo do projeto.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O projeto nem sempre tem o objetivo de resolver todos os problemas relatados pelos stakeholders, pois alguns podem estar fora do escopo do projeto, por isso, &amp;eacute; importante conscientizar os stakeholders do objetivo do projeto.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Manter a rastreabilidade dos requisitos dos stakeholders para os requisitos de neg&amp;oacute;cios, pois &amp;eacute; a garantia que o escopo do projeto n&amp;atilde;o ser&amp;aacute; desviado.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ficar atento para capturar os atributos dos requisitos, os quais podem ser apoiados e identificados seguindo o plano de gerenciamento de requisitos. Exemplos de atributos: origem, prioridade, autor, propriet&amp;aacute;rio, estado, risco, etc.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Na captura dos requisitos e seus atributos deve-se utilizar um mecanismo para registro dessas informa&amp;ccedil;&amp;otilde;es, como anot&amp;aacute;-las em um papel, documento, ferramenta, gravar (desde que autorizado pelos stakeholders).&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;N&amp;atilde;o esperar que a parte interessada relate tudo o que &amp;eacute; necess&amp;aacute;rio para atender o escopo do projeto, voluntariamente. Requisitos impl&amp;iacute;citos, como a omiss&amp;atilde;o de requisitos fundamentais, ocasionados pela falta de informa&amp;ccedil;&amp;otilde;es por parte dos stakeholders, &amp;eacute; um problema que ocorre durante a elicita&amp;ccedil;&amp;atilde;o. O papel do analista &amp;eacute; fundamental nesses momentos, pois deve ter sensibilidade e expertise para identificar o que a parte interessada pensa que &amp;eacute; &amp;oacute;bvio e n&amp;atilde;o menciona. Isso evitar&amp;aacute; retrabalho &amp;agrave; frente no projeto.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Deve haver tempo e recurso para que o analista amplie ou melhore seu conhecimento do neg&amp;oacute;cio. Para isso, sugere-se organizar as partes de informa&amp;ccedil;&amp;atilde;o coletadas em diferentes vis&amp;otilde;es visando identificar lacunas.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Recomenda&amp;ccedil;&amp;otilde;es para a documenta&amp;ccedil;&amp;atilde;o dos requisitos da elicita&amp;ccedil;&amp;atilde;o durante a execu&amp;ccedil;&amp;atilde;o da elicita&amp;ccedil;&amp;atilde;o&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 8px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(VAZQUEZ; SIM&amp;Otilde;ES 2016):&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;As t&amp;eacute;cnicas adotadas durante a execu&amp;ccedil;&amp;atilde;o da elicita&amp;ccedil;&amp;atilde;o de requisitos, definem o tipo de documenta&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;H&amp;aacute; abordagens em que os produtos da elicita&amp;ccedil;&amp;atilde;o s&amp;atilde;o produtos finais, como as hist&amp;oacute;rias de usu&amp;aacute;rios adotadas nos m&amp;eacute;todos &amp;aacute;geis.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Abordagens em que os produtos da elicita&amp;ccedil;&amp;atilde;o s&amp;atilde;o requisitos intermedi&amp;aacute;rios, a fim de registrar decis&amp;otilde;es sobre assuntos, at&amp;eacute; ent&amp;atilde;o, pendentes, devem documentar por meio de atas de reuni&amp;otilde;es, relat&amp;oacute;rios, registro de &amp;aacute;udio ou v&amp;iacute;deo, quadro de anota&amp;ccedil;&amp;otilde;es, por exemplo.&lt;/span&gt;&lt;/p&gt;
        &lt;ul style=&quot;font-size: initial;&quot;&gt;
            &lt;li style=&apos;list-style-type: circle;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Nesse caso, esse tipo de documenta&amp;ccedil;&amp;atilde;o ser&amp;aacute; utilizado para confirmar a compreens&amp;atilde;o do analista com os stakeholders sobre as informa&amp;ccedil;&amp;otilde;es coletadas.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Devem ser registradas tamb&amp;eacute;m, quest&amp;otilde;es em aberto e d&amp;uacute;vidas que surgiram durante essas cerim&amp;ocirc;nias e que n&amp;atilde;o foram esclarecidas at&amp;eacute; ent&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&apos;font-size: 14px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Execu&amp;ccedil;&amp;atilde;o da elicita&amp;ccedil;&amp;atilde;o de requisitos&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequenciaAtividadeUC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequenciaAtividadeUC>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecucaoRevReq -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecucaoRevReq">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRevisaoRequisitos"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;No n&amp;iacute;vel de execu&amp;ccedil;&amp;atilde;o, os revisores procuram por falhas nos requisitos, apoiadas no artefato que est&amp;aacute; sendo revisado, por exemplo, diagrama de caso de uso, documento de especifica&amp;ccedil;&amp;atilde;o de requisitos, etc. A revis&amp;atilde;o pode ser realizada individualmente por cada revisor, parte dos revisores ou pelo time todo.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Durante o n&amp;iacute;vel de execu&amp;ccedil;&amp;atilde;o, todas as falhas devem ser registradas para serem corrigidas posteriormente e, para isso, recomenda-se registrar as seguintes informa&amp;ccedil;&amp;otilde;es:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Nome do revisor e seu papel.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Artefato revisado, sua vers&amp;atilde;o,o projeto ao qual est&amp;aacute; vinculado e vers&amp;atilde;o do projeto.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Registro de falhas: Para cada falha, informar a descri&amp;ccedil;&amp;atilde;o da falha, a localiza&amp;ccedil;&amp;atilde;o da falha no artefato, a p&amp;aacute;gina, quando houver, e o tipo de falha - omiss&amp;atilde;o, ambiguidade&amp;hellip;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Informar as depend&amp;ecirc;ncias: Por exemplo: Se o artefato revisado for um diagrama de caso de uso, pode informar as depend&amp;ecirc;ncias ou refer&amp;ecirc;ncias daquele caso de uso como os requisitos funcionais e n&amp;atilde;o funcionais associados a ele.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Data da revis&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Estimativa de esfo&amp;ccedil;o prevista inicialmente para a revis&amp;atilde;o e o esfor&amp;ccedil;o real dedicado &amp;agrave; revis&amp;atilde;o. &lt;/span&gt;&lt;/p&gt;
        &lt;ul style=&quot;font-size: initial;&quot;&gt;
            &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O esfor&amp;ccedil;o pode ser apresentado em horas, minutos ou dia, por&amp;eacute;m, &amp;eacute; preciso padronizar.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Execu&amp;ccedil;&amp;atilde;o&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecutadoFonteInformacaoER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecutadoFonteInformacaoER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizacaoER"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegistroInformacaoER"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FonteInformacaoER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A fonte de informa&amp;ccedil;&amp;atilde;o definida &amp;eacute; respons&amp;aacute;vel pela realiza&amp;ccedil;&amp;atilde;o da t&amp;eacute;cnica de elicita&amp;ccedil;&amp;atilde;o de requisitos e pelo registro das informa&amp;ccedil;&amp;otilde;es coletadas.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Executado&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecutadoTecnicaER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecutadoTecnicaER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizacaoER"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegistroInformacaoER"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TecnicaER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;A t&amp;eacute;cnica de elicita&amp;ccedil;&amp;atilde;o foi realizada conforme o seu planejamento, as informa&amp;ccedil;&amp;otilde;es foram coletadas e, ap&amp;oacute;s, documentadas seguindo o padr&amp;atilde;o estabelecido pela empresa.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Executado&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FalhaIdentificacaoRequisitos -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FalhaIdentificacaoRequisitos">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CausaReD"/>
        <untitled-ontology-3:estaAssociadaA rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnaliseREQ"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AvaliarMelhorarElicitacaoREQ"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ComunicacaoPartesInteressadasStakeholders"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConstrucaoFluxoProcesso"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterDescreverClarezaDREQ"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MonitorarProgressoREQ"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrototipoValidacaoREQ"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarCerimonias"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RefinamentoRequisitos"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequisitosBemDefinidos"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RevisaoRequisitos"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TreinamentoPadroesER"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ImplementacaoIncompativelComEspecificacao"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InconsistenciaRequisitos"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NaoAtendemRequisitosCliente"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequirementsSmells"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Retrabalho"/>
        <untitled-ontology-3:descricao>Falha na identificação dos requisitos funcionais e de qualidade pode ocorrer devido sua volatilidade considerando, requisitos mal formulados, incompletos, com pouca clareza ou ambíguo.</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Falha na identificação dos requisitos</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FechamentoRevReq -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FechamentoRevReq">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRevisaoRequisitos"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;No n&amp;iacute;vel de fechamento da revis&amp;atilde;o de requisitos, os revisores se re&amp;uacute;nem para compartilharem e analisarem suas revis&amp;otilde;es observando os registros individuais de problemas - semelhantes ou n&amp;atilde;o, &amp;nbsp;para unific&amp;aacute;-los posteriormente.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ap&amp;oacute;s essa confer&amp;ecirc;ncia, os revisores sintetizam as falhas em um &amp;uacute;nico registro e simplificam as redund&amp;acirc;ncias de registros dos problemas identificados nas revis&amp;otilde;es individuais.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Para o registro de fechamento, recomenda-se manter as seguintes informa&amp;ccedil;&amp;otilde;es, destacadas na execu&amp;ccedil;&amp;atilde;o: &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Nome e papel dos revisores.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Artefato revisado, sua vers&amp;atilde;o e o projeto ao qual est&amp;aacute; vinculado e vers&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Registro de problema: Para cada problema, informar a descri&amp;ccedil;&amp;atilde;o do problema, a localiza&amp;ccedil;&amp;atilde;o do problema no artefato, a p&amp;aacute;gina, quando houver e o tipo de falha - omiss&amp;atilde;o, ambiguidade&amp;hellip;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Informar as depend&amp;ecirc;ncias: Por exemplo: Se o artefato revisado for um diagrama de caso de uso, pode informar as depend&amp;ecirc;ncias ou refer&amp;ecirc;ncias daquele caso de uso como os requisitos funcionais e n&amp;atilde;o funcionais associados a ele.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Medidas corretivas para os problemas identificados.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Data do fechamento da revis&amp;atilde;o de requisitos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Estimativa de esfor&amp;ccedil;o total considerando os revisores envolvidos e o esfor&amp;ccedil;o real.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
        &lt;ul style=&quot;font-size: initial;&quot;&gt;
            &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O esfor&amp;ccedil;o pode ser apresentado em horas, minutos ou dia, por&amp;eacute;m, &amp;eacute; preciso padronizar.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Fechamento da revis&amp;atilde;o de requisitos&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FinalizadoFonteInformacaoER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FinalizadoFonteInformacaoER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConfirmacaoInformacaoER"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FonteInformacaoER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;&amp;nbsp;Uma fonte de informa&amp;ccedil;&amp;atilde;o disponibiliza o registro das informa&amp;ccedil;&amp;otilde;es elicitadas&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Finalizado&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FinalizadoTecnicaER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FinalizadoTecnicaER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConfirmacaoInformacaoER"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TecnicaER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;As informa&amp;ccedil;&amp;otilde;es foram confirmadas com os stakeholders, ajustadas e atualizadas quando necess&amp;aacute;rias. Ap&amp;oacute;s, &amp;eacute; dado sequ&amp;ecirc;ncia ao desenvolvimento do projeto de software.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Finalizado&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FluxoProcessoCompreensaoDemanda -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FluxoProcessoCompreensaoDemanda">
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MelhorarProcessoDesenvolvimento"/>
        <untitled-ontology-3:podeMitigar rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FalhaIdentificacaoRequisitos"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FonteInformacaoER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FonteInformacaoER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Alpha"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConfirmacaoInformacaoER"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoTER"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizacaoER"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegistroInformacaoER"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecutadoFonteInformacaoER"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FinalizadoFonteInformacaoER"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoFonteInformacaoER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;Eacute; importante que a origem dos requisitos esteja clara e que os potenciais stakeholders sejam envolvidos logo no in&amp;iacute;cio do processo de elicita&amp;ccedil;&amp;atilde;o de requisitos.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Pohl e Rupp (2015) definem tr&amp;ecirc;s tipos de fontes de informa&amp;ccedil;&amp;atilde;o:&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Stakeholders:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;s&amp;atilde;o pessoas ou organiza&amp;ccedil;&amp;otilde;es que interferem (direta ou indiretamente) nos requisitos do sistema. Como exemplos, destacam-se os usu&amp;aacute;rios, operadores do sistema, desenvolvedores, arquitetos, clientes, testadores.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Documentos:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;mant&amp;eacute;m informa&amp;ccedil;&amp;otilde;es que podem conter requisitos, como, por exemplo, documentos legais ou regulat&amp;oacute;rios, normas, assim como documentos espec&amp;iacute;ficos do dom&amp;iacute;nio de neg&amp;oacute;cio ou da pr&amp;oacute;pria empresa, como documentos de requisitos ou documentos de erros em sistemas legados.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Sistemas em opera&amp;ccedil;&amp;atilde;o:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;sistemas legados ou antecessores.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;No m&amp;eacute;todo &amp;aacute;gil SCRUM, utiliza-se o papel do product owner (PO) ou seja, o dono do produto, que &amp;eacute; respons&amp;aacute;vel por gerenciar o product backlog. As principais atribui&amp;ccedil;&amp;otilde;es do PO concentram-se no gerenciamento e prioridades do product backlog e garantir a compreens&amp;atilde;o adequada de cada item do backlog por parte da equipe de desenvolvimento&lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;(&lt;span style=&quot;color:#0c343d;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Reinher&amp;nbsp;&lt;/span&gt;2018)&lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Envolvimento dos stakeholders&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;(&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Leffin-Gwell 2011 apud &lt;span style=&quot;color:#0c343d;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Reinher&amp;nbsp;&lt;/span&gt;2018)&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;:&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Stakeholders que devem ser mantidos informados:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;aqueles que precisam acompanhar o status do projeto e precisam ser mantidos atualizados e informados sobre as decis&amp;otilde;es, embora nem sempre tomem parte dessas decis&amp;otilde;es.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Stakeholders que devem ser consultados:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;aqueles que devem ser envolvidos devido &amp;agrave;s &amp;aacute;reas de expertise, como ocorre com arquitetos, projetistas de interface, marketing e especialistas do dom&amp;iacute;nio. Devem ser inclu&amp;iacute;dos nas decis&amp;otilde;es contribuindo com a sua &amp;aacute;rea de expertise.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Stakeholders que ser&amp;atilde;o parceiros no desenvolvimento:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;aqueles que devem ser envolvidos por serem partes do processo. Por exemplo, os product owners de outros projetos, outras equipes de desenvolvimento, analistas de neg&amp;oacute;cios ou requisitos e provedores de solu&amp;ccedil;&amp;otilde;es que interagem com o sistema.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Stakeholders que controlam os resultados:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;aqueles que tomam as decis&amp;otilde;es sobre a solu&amp;ccedil;&amp;atilde;o desejada. Por exemplo, os executivos, gerentes de libera&amp;ccedil;&amp;atilde;o, usu&amp;aacute;rios-chave que v&amp;atilde;o utilizar a solu&amp;ccedil;&amp;atilde;o e business owners.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Orienta&amp;ccedil;&amp;otilde;es para definir as &amp;nbsp;fontes de informa&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Para identificar quais s&amp;atilde;o as fontes de informa&amp;ccedil;&amp;atilde;o dos requisitos para determinado projeto, recomenda-se conversar com o respons&amp;aacute;vel pela aquisi&amp;ccedil;&amp;atilde;o do projeto para que ele determine as &amp;aacute;reas de neg&amp;oacute;cios que ter&amp;atilde;o alguma interface com o neg&amp;oacute;cio que est&amp;aacute; sendo tratado pelo software e identifique poss&amp;iacute;veis leis ou regulamenta&amp;ccedil;&amp;otilde;es que precisam ser atendidas.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Recomenda&amp;ccedil;&amp;otilde;es de quest&amp;otilde;es para a identifica&amp;ccedil;&amp;atilde;o dos stakeholders&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;(Leffin-Gwell 2011 apud &lt;span style=&quot;color:#0c343d;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Reinher&amp;nbsp;&lt;/span&gt;2018):&lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color:#0c343d;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Tabela &amp;nbsp;1: Quest&amp;otilde;es para identifica&amp;ccedil;&amp;atilde;o dos stakeholders&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXduITF_svr9ZizGf51HtAnXADeD0k697NLo-M2SySz6WKIScwZUn6mggi2F6qfQIgmpTOHpWm18byhQUGtMW_uSueFJk0qeqzdLwVwDAIGX5sHKwSUB3OqmAfTYSd5qq5h43DNuMkb0IKmjuzjThVYBtB-J?key=bWYZdeVOtJgVilXi-41QBQ&quot; width=&quot;395&quot; height=&quot;299&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color:#0c343d;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Fonte: Reinher, 2018&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Fontes de informa&amp;ccedil;&amp;atilde;o&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GerenciaREQ -->

