        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#IndicarDTMetricas"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Indicar a dívida técnica usando métricas de qualidade do procuto</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


