&lt;/ul&gt;</untitled-ontology-3:descricao>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GrafoRastreabilidade -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GrafoRastreabilidade">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmExecucaoGR"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoGR"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizadoGR"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItemArtefatoRastreado"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RelacionamentoItensArtefatos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcompanharManterRastreabilidadeRequisitos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Representado por um gr&amp;aacute;fico no qual os n&amp;oacute;s representam artefatos (itens a serem rastreados) e as linhas do relacionamento entre eles.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A diferen&amp;ccedil;a entre artefatos e os tipos de rastreabilidade pode ser definida por meio da designa&amp;ccedil;&amp;atilde;o de diferentes atributos para os n&amp;oacute;s e linhas do grafo.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Apresenta&amp;ccedil;&amp;atilde;o&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;No grafo, um tipo de n&amp;oacute; deve ser definido para cada tipo de artefato de desenvolvimento. A letra &amp;ldquo;C&amp;rdquo; representa informa&amp;ccedil;&amp;otilde;es sobre o contexto do software; &amp;ldquo;Req-n&amp;rdquo; representa o requisito; e &amp;ldquo;Comp-n&amp;rdquo;, componentes.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Tamb&amp;eacute;m, s&amp;atilde;o definidas tr&amp;ecirc;s tipos de linhas que representam tr&amp;ecirc;s tipos de relacionamento:&amp;nbsp;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;executado por&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;;&amp;nbsp;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;eacute; origem&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;;&amp;nbsp;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;refina&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Figura 1: Grafo de rastreabilidade de requisitos&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXdNxWixpbGfgKJAcB6D5oU0h_h6VFFLc4C5mQy3d4AZ-0P9UmawjUpdlZOP-jMRhfVD1rRKVClIe27VAiUUcfo8ie2wm1CZswxXH9WTIxkQ9oqlNirqWZG67XrmKGTLgFz0pS32wPFbLXckXRB8OouZ7dhd?key=bWYZdeVOtJgVilXi-41QBQ&quot; width=&quot;338&quot; height=&quot;164&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Fonte: Pohl &amp;amp; Rupp, 2015&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Grafo de rastreabilidade&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#HUSimplesCumprida -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#HUSimplesCumprida">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarParteCasoUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;&lt;strong&gt;O sistema de software cumpre a hist&amp;oacute;ria mais simples que permite ao usu&amp;aacute;rio atingir o objetivo.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px; line-height: 150%; font-family: Merriweather; color: black;&quot;&gt;&lt;strong&gt;A fatia de caso de uso aplic&amp;aacute;vel &amp;eacute; &amp;apos;Verificada&amp;apos;: &lt;/strong&gt;&lt;strong&gt;A fatia de caso de uso que representa a hist&amp;oacute;ria mais simples est&amp;aacute; no estado Verificado.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;&lt;b&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Hist&amp;oacute;ria mais simples cumprida&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#HUSuficientesCumpridas -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#HUSuficientesCumpridas">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarParteCasoUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;b&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;O sistema de software cumpre hist&amp;oacute;rias suficientes para fornecer uma solu&amp;ccedil;&amp;atilde;o utiliz&amp;aacute;vel.&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Fluxo b&amp;aacute;sico implementado e testado: &lt;/strong&gt;O fluxo b&amp;aacute;sico e as hist&amp;oacute;rias que ele define foram implementados e testados com sucesso.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Fluxos alternativos suficientes implementados:&lt;/strong&gt; Uma quantidade suficiente do comportamento adicional definido pelos fluxos alternativos foi implementada e testada com sucesso para que o sistema seja utiliz&amp;aacute;vel.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Tratamento de erros suficiente implementado:&lt;/strong&gt; Uma parte suficiente do comportamento de tratamento de erros definido pelos fluxos alternativos foi implementada e testada com sucesso para que o sistema seja utiliz&amp;aacute;vel.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Partes de casos de uso suficientes s&amp;atilde;o &amp;apos;verificadas&amp;apos;:&lt;/strong&gt; Um n&amp;uacute;mero suficiente de partes de casos de uso foi verificado para que a implementa&amp;ccedil;&amp;atilde;o resultante do caso de uso pelo sistema de software seja utiliz&amp;aacute;vel e &amp;uacute;til para as partes interessadas. &amp;nbsp;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;&lt;b&gt;&lt;span style=&quot;text-align: left; color: rgb(234, 117, 2); font-size: 14px;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;&lt;strong&gt;Hist&amp;oacute;rias suficientes cumpridas&lt;/strong&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#IdeiasTesteCapturadasCTPB -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#IdeiasTesteCapturadasCTPB">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararItemProductBacklog"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoTestePB"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;O racioc&amp;iacute;nio que justifica o caso de teste foi formulado, incluindo por que o caso de teste existe e qual aspecto ou parte dos requisitos deve ser testado.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span&gt;&lt;span style=&quot;text-align: left;color: rgb(0, 0, 0);font-size: 14.4px;&quot;&gt;Os principais itens que precisamos testar foram documentados.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span&gt;&lt;span&gt;&lt;span style=&quot;text-align: left;color: rgb(0, 0, 0);font-size: 14.4px;&quot;&gt;As ideias de teste cobrem os cen&amp;aacute;rios de uso que devem ser suportados para atingir o valor.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span&gt;&lt;span&gt;&lt;span&gt;&lt;span style=&quot;text-align: left;color: rgb(0, 0, 0);font-size: 14.4px;&quot;&gt;As partes interessadas est&amp;atilde;o satisfeitas porque as ideias de teste juntas verificam uma implementa&amp;ccedil;&amp;atilde;o aceit&amp;aacute;vel do item a ser implementado. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#IdeiasTesteFormuladas -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#IdeiasTesteFormuladas">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;O menor n&amp;iacute;vel de detalhe apenas captura a ideia inicial que informar&amp;aacute; o caso de teste. Ao definir um caso de teste, &amp;eacute; necess&amp;aacute;rio deixar claro qual &amp;eacute; a ideia por tr&amp;aacute;s do caso de teste e a qual fatia dos requisitos ele se aplica.&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Um caso de teste pode ser considerado uma pergunta que voc&amp;ecirc; faz ao sistema.&amp;nbsp;O objetivo da execu&amp;ccedil;&amp;atilde;o do caso de teste &amp;eacute; obter informa&amp;ccedil;&amp;otilde;es, por exemplo, se o sistema funciona conforme especificado ou n&amp;atilde;o.&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Deve haver um motivo para a cria&amp;ccedil;&amp;atilde;o do caso de teste.&amp;nbsp;Alguns casos de teste existem para abordar riscos espec&amp;iacute;ficos do projeto, enquanto outros s&amp;atilde;o baseados em experi&amp;ecirc;ncias, palpites, resultados de testes ou t&amp;eacute;cnicas de teste usadas para produzir casos de teste metodicamente.&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Esse racioc&amp;iacute;nio pode ser resumido como a ideia de teste por tr&amp;aacute;s do caso de teste e &amp;eacute; a forma mais antiga que um caso de teste pode assumir.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;A raz&amp;atilde;o da exist&amp;ecirc;ncia do caso de teste &amp;eacute; clara.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;As informa&amp;ccedil;&amp;otilde;es a serem reveladas pelo caso de teste s&amp;atilde;o claras. &lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Ideias de teste formuladas&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Identificacao -->

