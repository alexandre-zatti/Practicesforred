    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Mensuracao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Mensuracao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AreaGestaoReD"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CalcularDividaTecnica"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CategorizacaoCusto"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CompararSolucoes"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstimarDTExperiencia"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#IndicarDTMetricas"/>
        <untitled-ontology-3:descricao>&lt;p&gt;Respons&amp;aacute;vel por analisar e quantificar os custos e esfor&amp;ccedil;os necess&amp;aacute;rios para auxiliar na tomada de decis&amp;atilde;o referente ao ressarcimento da d&amp;iacute;vida.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Mensura&amp;ccedil;&amp;atilde;o&lt;/p&gt;</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MetaEstabelecida -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MetaEstabelecida">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EcontrarAtoreseUC"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Em primeiro lugar, a meta do caso de uso deve ser estabelecida.&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;strong&gt;Atores prim&amp;aacute;rios nomeados:&amp;nbsp;&lt;/strong&gt;Os principais atores do caso de uso foram identificados e nomeados.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;strong&gt;Objetivo e valor claramente descritos:&lt;/strong&gt; O objetivo do caso de uso e o valor que ele fornecer&amp;aacute; foram claramente descritos (ou seja, a narrativa do caso de uso &amp;eacute; detalhada em Descrito Resumidamente).&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;strong&gt;As partes interessadas concordam com o objetivo:&amp;nbsp;&lt;/strong&gt;Todas as partes interessadas relevantes concordam com a meta que o caso de uso deve cumprir.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;strong&gt;Dentro ou fora do escopo?:&lt;/strong&gt; Est&amp;aacute; claro se o caso de uso est&amp;aacute; dentro ou fora do escopo&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;strong&gt;A narrativa do caso de uso &amp;eacute; brevemente descrita:&lt;/strong&gt; A narrativa do caso de uso &amp;eacute; descrita resumidamente ou al&amp;eacute;m.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Meta Estabelecida&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloCasoUso -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloCasoUso">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Estruturada"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#LimiteValorEstabelecido"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValorEstabelecido"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoUso"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EcontrarAtoreseUC"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:apresentacao>&lt;p&gt;Pr&amp;aacute;tica &amp;aacute;gil que utiliza casos de uso para capturar um conjunto de requisitos e impulsionar o desenvolvimento incremental de um sistema para atend&amp;ecirc;-los.&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:apresentacao>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Modelo de caso de uso&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Um modelo que captura e visualiza todas as formas &amp;uacute;teis de usar um sistema.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Permite que as equipes cheguem a um acordo sobre as funcionalidades e caracter&amp;iacute;sticas necess&amp;aacute;rias de um sistema.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Estabelece claramente os limites e o escopo do sistema, fornecendo uma imagem completa de seus atores (estando fora do sistema) e casos de uso (estando dentro do sistema).&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Fornece o contexto para a elabora&amp;ccedil;&amp;atilde;o dos casos de uso individuais.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Permite o gerenciamento &amp;aacute;gil de requisitos.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Apresenta&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-weight: bold;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;O objetivo de um modelo de casos de uso &amp;eacute; capturar todas as maneiras &amp;uacute;teis de usar um sistema em um formato acess&amp;iacute;vel que capture os requisitos de um sistema e possa ser usado para orientar seu desenvolvimento e testes.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Um modelo de casos de uso &amp;eacute; composto principalmente por um conjunto de atores e casos de uso juntamente com seus relacionamentos e diagramas que ilustram esses elementos. Os modelos de casos de uso podem ser capturados de muitas maneiras diferentes, como um Wiki, um quadro branco ou flipchart, um conjunto de slides do Microsoft PowerPoint, um documento do Microsoft Word ou uma ferramenta de modelagem.&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Considerando que seu modelo de caso de uso mostre claramente o valor que as partes interessadas receber&amp;atilde;o de seu sistema novo ou atualizado, ele estar&amp;aacute; fazendo seu trabalho. Deve-se ter cuidado ao adicionar detalhes ao modelo. Somente avance para o limite do sistema estabelecido ou estruturado se esses n&amp;iacute;veis de detalhe claramente agregarem valor e ajudarem voc&amp;ecirc; a entregar o novo sistema com mais efici&amp;ecirc;ncia.&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Informa&amp;ccedil;&amp;otilde;es adicionais&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;h2 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.75em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Conte&amp;uacute;do essencial&lt;/u&gt;&lt;/span&gt;&lt;/h2&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Defini&amp;ccedil;&amp;otilde;es de ator: Um ator &amp;eacute; algu&amp;eacute;m ou algo fora do sistema que interage com o sistema em uma fun&amp;ccedil;&amp;atilde;o espec&amp;iacute;fica. Os atores s&amp;atilde;o usados para: a) Estabelecer os limites do sistema e b) Permitir a identifica&amp;ccedil;&amp;atilde;o dos casos de uso que fornecem valor (para os atores)&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Defini&amp;ccedil;&amp;otilde;es de casos de uso: Um caso de uso s&amp;atilde;o todas as maneiras de usar um sistema para atingir um objetivo espec&amp;iacute;fico para um usu&amp;aacute;rio espec&amp;iacute;fico.&amp;nbsp;Consulte tamb&amp;eacute;m a diretriz narrativa de casos de uso.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Associa&amp;ccedil;&amp;otilde;es: Associa&amp;ccedil;&amp;otilde;es e relacionamentos entre atores e casos de uso que denotam intera&amp;ccedil;&amp;atilde;o (frequentemente chamadas de associa&amp;ccedil;&amp;otilde;es de comunica&amp;ccedil;&amp;atilde;o).&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1 Explica&amp;ccedil;&amp;atilde;o do Modelo: Texto e ilustra&amp;ccedil;&amp;otilde;es explicando o modelo.&lt;/li&gt;
&lt;/ul&gt;
&lt;h2 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.75em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;u&gt;Conte&amp;uacute;do adicional&lt;/u&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/h2&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Diagramas de Casos de Uso: Ilustra&amp;ccedil;&amp;otilde;es de atores, casos de uso e seus relacionamentos.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Pacotes de Casos de Uso: Pacotes de casos de uso e atores usados para organizar o modelo.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Relacionamentos de Casos de Uso: Um relacionamento de &amp;apos;inclus&amp;atilde;o&amp;apos; entre casos de uso expressa a reutiliza&amp;ccedil;&amp;atilde;o de descri&amp;ccedil;&amp;otilde;es de comportamento comuns.&amp;nbsp;Um relacionamento &amp;apos;estende&amp;apos; expressa como um caso de uso adiciona comportamento a outro.&amp;nbsp;A generaliza&amp;ccedil;&amp;atilde;o entre casos de uso expressa que a sequ&amp;ecirc;ncia de um caso de uso &amp;eacute; reutilizada por outro&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Relacionamentos entre atores: A generaliza&amp;ccedil;&amp;atilde;o entre atores expressa que um ator pode desempenhar o papel do outro ator.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Modelo de caso de uso&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:referenciaRE>&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;sup&gt;&lt;sup style=&quot;font-size: smaller;&quot;&gt;1&lt;/sup&gt;&lt;/sup&gt; Use Case Modeling, de Kurt Bittner e Ian Spence, Addison-Wesley Professional, cap&amp;iacute;tulos 4-5.&lt;/p&gt;

&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;sup&gt;&lt;sup style=&quot;font-size: smaller;&quot;&gt;2&lt;/sup&gt;&lt;/sup&gt; Use Case Patterns and Blueprints, por Gunnar &amp;Ouml;vergaard e Karin Palmkvist, Addison Wesley, cap&amp;iacute;tulos 16-44.&lt;/p&gt;</untitled-ontology-3:referenciaRE>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloDocumentacao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloDocumentacao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DocumentacaoIdentificacao"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;O modelo de documenta&amp;ccedil;&amp;atilde;o cont&amp;eacute;m diversos dados, principalmente referentes &amp;agrave; medi&amp;ccedil;&amp;atilde;o e&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&amp;eacute; proposto por Seaman e Guo (2011).&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Modelo de documentação</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloEspecificacaoRequisitos -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloEspecificacaoRequisitos">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NotacoesModeloESR"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RecomendacoesModeloESR"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValorEstabelecidoModeloESR"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CriteriosAceitacao"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequisitosSistema"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequisitosUsuario"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CategorizarRequisitosSistema"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DescreverInformacoesAdd"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DescreverObjetivoSoftware"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DesenvolverModelagemRequisitos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#IdentificarRequisitosSoftware"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RevisaoInspecaoManterClarezaDER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:apresentacao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A concep&amp;ccedil;&amp;atilde;o de requisitos &amp;eacute; o processo de escrever os requisitos do usu&amp;aacute;rio e do sistema em um documento de requisitos. Idealmente, os requisitos do usu&amp;aacute;rio e do sistema devem &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;ser claros, inequ&amp;iacute;vocos, simples de entender, completos e consistentes.&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Deve manter o registro dos requisitos de usu&amp;aacute;rio e de sistema, bem como suas representa&amp;ccedil;&amp;otilde;es.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:apresentacao>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Modelo de especifica&amp;ccedil;&amp;atilde;o de requisitos&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Na engenharia de software, &amp;ldquo;especifica&amp;ccedil;&amp;atilde;o de requisitos de software&amp;rdquo; normalmente se refere &amp;agrave; produ&amp;ccedil;&amp;atilde;o de um documento que pode ser sistematicamente revisado, avaliado e aprovado.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A concep&amp;ccedil;&amp;atilde;o de requisitos de software permite uma avalia&amp;ccedil;&amp;atilde;o rigorosa dos requisitos antes que o design possa come&amp;ccedil;ar, rapidamente ou redesenho posterior. Ela tamb&amp;eacute;m deve fornecer uma base realista para estimar custos, riscos e cronogramas do produto.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;As organiza&amp;ccedil;&amp;otilde;es tamb&amp;eacute;m podem usar um documento de concep&amp;ccedil;&amp;atilde;o de requisitos de software como base para desenvolver planos de verifica&amp;ccedil;&amp;atilde;o e valida&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Modelo de especifica&amp;ccedil;&amp;atilde;o de requisitos&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRastreabilidade -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRastreabilidade">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ClassificarRelacionamentoRastreabilReq"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinirTecnicaRastreabilRequisitos"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RastreabilidadeRequisitosDefinidaFinalidade"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegistrarInformRastreabilReq"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItemArtefatoRastreado"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RelacionamentoItensArtefatos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcompanharManterRastreabilidadeRequisitos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Modelo de Rastreabilidade de Requisitos&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Um modelo que captura e visualiza todas as formas &amp;uacute;teis de usar um sistema.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Permite que as equipes cheguem a um acordo sobre as funcionalidades e possibilidades de um sistema.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Estabelece claramente os limites e o escopo do sistema, fornecendo uma imagem completa de seus atores (estando fora do sistema) e casos de uso (estando dentro do sistema).&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Fornecer o contexto para a elabora&amp;ccedil;&amp;atilde;o dos casos de uso individuais.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Permite o gerenciamento &amp;aacute;gil de requisitos.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Modelo de rastreabilidade&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRevisaoRequisitos -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRevisaoRequisitos">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApresentacaoResultadosRevReq"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecucaoRevReq"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FechamentoRevReq"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejamentoPreparacaoRevReq"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Erro"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApresentarResultadoRevReq"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ColetarConsolidarProblemas"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConsolidarRegistrarUnificacaoProblemas"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CorrigirErrosUnificacao"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinirEscopoRevisao"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DetectarFalhasRevReq"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:apresentacao>&lt;p&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Pr&amp;aacute;tica que permite a revis&amp;atilde;o em diferentes artefatos das atividades da Engenharia de Requisitos.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:apresentacao>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Modelo de revis&amp;atilde;o de requisitos&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A revis&amp;atilde;o de requisitos &amp;eacute; composta por um grupo de revisores &amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(SWEBOK 2024), que valida os requisitos e &amp;eacute; formada por engenheiros de software, clientes, usu&amp;aacute;rios e outros envolvidos que examinam a especifica&amp;ccedil;&amp;atilde;o em busca de erros no conte&amp;uacute;do ou na interpreta&amp;ccedil;&amp;atilde;o, de &amp;aacute;reas em que talvez sejam necess&amp;aacute;rios esclarecimentos, de informa&amp;ccedil;&amp;otilde;es ausentes, de inconsist&amp;ecirc;ncias, de requisitos conflitantes&amp;nbsp;(PRESSMAN; MAXIM &amp;nbsp;2021).&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O artefato a ser revisado pode ser um documento, um diagrama, um prot&amp;oacute;tipo ou qualquer outro artefato que especifique requisitos.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Modelo de revis&amp;atilde;o de requisitos&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:referenciaRE>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Refer&amp;ecirc;ncias&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;sup&gt;&lt;sup style=&quot;font-size: smaller;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;1&lt;/span&gt;&lt;/sup&gt;&lt;/sup&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;PRESSMAN, Roger S.; MAXIM, Bruce R. Engenharia de software. 9th ed. Porto Alegre: AMGH, 2021.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;sup&gt;&lt;sup style=&quot;font-size: smaller;&quot;&gt;2&lt;/sup&gt;&lt;/sup&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;SWEBOK. Guide to the Software Engineering Body of Knowledge v4.0. Editors: Hironori Washizaki, Waseda University (IEEE Computer Society 2024 President-Elect, 2025 President). 2024.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:referenciaRE>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MoldarSistema -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MoldarSistema">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EspacoAtividade"/>
        <untitled-ontology-3:contempla rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarParteCasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Espaco Atividade&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;p style=&quot;font-size: 1em;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Modelar o sistema para que seja f&amp;aacute;cil de desenvolver, alterar e manter, e possa lidar com as demandas atuais e futuras.&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
    &lt;ul&gt;
        &lt;li style=&quot;font-size: 12px;&quot;&gt;Isso inclui o design geral e a arquitetura do sistema a ser desenvolvido.&lt;/li&gt;
    &lt;/ul&gt;
&lt;/div&gt;
&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Modelar o sistema para:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Estruturar o sistema e identifique os principais elementos do sistema.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Atribuir requisitos aos elementos do sistema.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Certificar-se de que a arquitetura seja adequadamente robusta e flex&amp;iacute;vel.&lt;/li&gt;
&lt;/ul&gt;
&lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;h1 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 2.375em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Atividade dispon&amp;iacute;vel - Contempla:&lt;/span&gt;&lt;/h1&gt;
    &lt;ul&gt;
        &lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Analisar uma fatia de caso de uso:&lt;/strong&gt; Analisar o impacto de uma fatia de Caso de Uso e moldar sua implementa&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
    &lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Refer&amp;ecirc;ncias:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
    &lt;ul&gt;
        &lt;li style=&quot;font-size: 12px; color: rgb(0, 0, 0);&quot;&gt;Essence Standard (OMG), consulte &lt;u&gt;&lt;a href=&quot;http://www.omg.org/spec/Essence/1.1/&quot; target=&quot;_blank&quot; style=&quot;color: rgb(75, 110, 198);&quot;&gt;http://www.omg.org/spec/Essence/1.1/&lt;/a&gt;&lt;/u&gt;&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; color: rgb(0, 0, 0);&quot;&gt;A Ess&amp;ecirc;ncia da Engenharia de Software: Aplicando o Kernel SEMAT, por Ivar Jacobson, Pan-Wei Ng, Paul E. McMahon, Ian Spence e Svante Lidman, Addison-Wesley 2013.&lt;/li&gt;
    &lt;/ul&gt;
    &lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;/div&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Modelar o sistema&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequenciaEspacoAtividade rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequenciaEspacoAtividade>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Monitoramento -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Monitoramento">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AreaGestaoReD"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemLimiar"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConferirPlanejado"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlotarMedidasReD"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RastrearPropagacaoReD"/>
        <untitled-ontology-3:descricao>&lt;p&gt;Consiste em validar se a d&amp;iacute;vida t&amp;eacute;cnica est&amp;aacute; sendo reduzida, atrasada ou se permanece gerando custos.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Monitoramento&lt;/p&gt;</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


