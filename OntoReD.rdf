        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
        &lt;p style=&quot;text-align: justify; font-size: 1em;&quot;&gt;&lt;span style=&quot;text-align: start; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Definir as entradas de teste e resultados esperados para ajudar a avaliar se um aspecto espec&amp;iacute;fico do sistema funciona corretamente.&lt;/span&gt;&lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Caso de teste&lt;/p&gt;</untitled-ontology-3:nome>
