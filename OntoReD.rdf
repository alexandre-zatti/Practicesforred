    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RastreabilidadeREQ -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RastreabilidadeREQ">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcompanharManterRastreabilidadeRequisitos"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinidoIA"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinidoRIA"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmDesenvolvimentoIA"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmDesenvolvimentoRIA"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GerenciadoIA"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GerenciadoRIA"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GrafoRastreabilidade"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItemArtefatoRastreado"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MatrizRastreabilidade"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRastreabilidade"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RelacionamentoItensArtefatos"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcoesPreventivas"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MelhorarProcessoDesenvolvimento"/>
        <untitled-ontology-3:podeMitigar rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#SistemaGerenciamentoRequisitosAusenteIneficaz"/>
        <untitled-ontology-3:classificacaoPratica>Específica</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;em&gt;&amp;ldquo;Um projeto de desenvolvimento de software produz muitas informa&amp;ccedil;&amp;otilde;es. O esperado no resultado final &amp;eacute; que o software atenda &amp;agrave;s necessidades do cliente dentro de restri&amp;ccedil;&amp;otilde;es de custo e prazo. Assim, &amp;eacute; necess&amp;aacute;rio que haja um gerenciamento destas informa&amp;ccedil;&amp;otilde;es desde a especifica&amp;ccedil;&amp;atilde;o de requisitos at&amp;eacute; a entrega do software ao cliente.&amp;nbsp;&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;O gerenciamento de requisitos trata n&amp;atilde;o somente da entrega, mas tamb&amp;eacute;m das mudan&amp;ccedil;as que podem ocorrer nos requisitos. Ocorrem mudan&amp;ccedil;as de requisitos ao longo do ciclo de desenvolvimento de software. Portanto, a atividade de gerenciamento de mudan&amp;ccedil;as &amp;eacute; fundamental para que os requisitos negociados e aprovados com cliente sejam controlados, atendendo-se &amp;agrave;s eventuais mudan&amp;ccedil;as que venham a ocorrer.&amp;nbsp;&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;O gerenciamento de mudan&amp;ccedil;as se d&amp;aacute; com o rastreamento dos requisitos durante o desenvolvimento de software. O rastreamento permite analisar os impactos dessas mudan&amp;ccedil;as no processo de desenvolvimento&amp;rdquo;&lt;/em&gt; (Kechi 2011).&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:fluxoAtividades>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;Figura 1 - Fluxo de atividades da pr&amp;aacute;tica &amp;ldquo;Manter a rastreabilidade de requisitos&amp;rdquo;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXeJODDfWGacsryMIL3Xmzp3vIRrCuMIynF_22yTRPquVidzgP2wFfxXn4rYLFUT2g-QD_mWAl4-RJ-6MGaWAXdvbuBxBX1sZ-SIHSfi1AG4dcY-EUTglBdJk46pSWaFTMRLdHpACw?key=LwtbXbTv-BvuWWo5voqBG3yl&quot; width=&quot;449&quot; height=&quot;373&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Fonte: Elaborado pelo autor (2024)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:fluxoAtividades>
        <untitled-ontology-3:glossario>&lt;div align=&quot;left&quot;&gt;
    &lt;table style=&quot;border: none; border-collapse: collapse; width: 100%;&quot;&gt;
        &lt;tbody&gt;
