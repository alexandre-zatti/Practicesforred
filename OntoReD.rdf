    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemLimiar -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemLimiar">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Monitoramento"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinirLimitesMetricasQualidades"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmitirNotificacoesLimitesNaoAlcancados"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Abordagem baseada em limiar</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemPortfolio -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemPortfolio">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Priorizacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConsiderarItensDividasFuncionalidadesBugsAtivos"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>A abordagem de portfólio considera itens da dívida juntamente com outras novas funcionalidades e bugs como riscos e oportunidades de investimento (ou seja, ativos).</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Abordagem de portfólio</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemQuantificacao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemQuantificacao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Identificacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InformarConsequenciaManterDivida"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#QuantificarJuroDivida"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#QuantificarTamanhoDivida"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#StatusCrescimentoDivida"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;Consiste em quantificar DT e interesse t&amp;eacute;cnico, mas para isso seria necess&amp;aacute;rio responder quest&amp;otilde;es sobre investimentos, como&lt;/p&gt;
&lt;p&gt;(1) Qual o tamanho do meu DT?&amp;nbsp;&lt;/p&gt;
&lt;p&gt;(2) Quanto de juros estou pagando pelo DT?&amp;nbsp;&lt;/p&gt;
&lt;p&gt;(3) A d&amp;iacute;vida est&amp;aacute; crescendo? e qu&amp;atilde;o r&amp;aacute;pido?&amp;nbsp;&lt;/p&gt;
&lt;p&gt;(4) Qual ser&amp;aacute; a consequ&amp;ecirc;ncia de manter este DT para manuten&amp;ccedil;&amp;atilde;o futura?&lt;/p&gt;
&lt;p&gt;A D&amp;iacute;vida T&amp;eacute;cnica pode ser quantificada considerando a rela&amp;ccedil;&amp;atilde;o entre as necessidades do usu&amp;aacute;rio j&amp;aacute; eliciadas e todas as poss&amp;iacute;veis necessidades do usu&amp;aacute;rio, inclusive as negligenciadas.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Abordagem de quantificação</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemVizinhoProximo -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemVizinhoProximo">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Identificacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AproveitarExpDivResolvidas"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;Abordagem do vizinho mais pr&amp;oacute;ximo aproveita a experi&amp;ecirc;ncia adquirida em d&amp;iacute;vidas t&amp;eacute;cnicas previamente resolvidas e conta com o esfor&amp;ccedil;o necess&amp;aacute;rio para corrigir essas d&amp;iacute;vidas j&amp;aacute; identificadas.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Acredita-se que o tempo m&amp;eacute;dio para converter uma d&amp;iacute;vida t&amp;eacute;cnica &amp;eacute; semelhante &amp;agrave; corre&amp;ccedil;&amp;atilde;o de d&amp;iacute;vidas anteriores no projeto.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Abordagem do vizinho mais próximo</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcoesPreventivas -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcoesPreventivas">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Identificacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CompromissoCliente"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ComunicacaoPartesInteressadasStakeholders"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ControlarNegociarREQ"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DeclaracaoEscopoDefinido"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RastreabilidadeREQ"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequisitosBemDefinidos"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;Estudos prim&amp;aacute;rios relatam que prevenir a ocorr&amp;ecirc;ncia de uma d&amp;iacute;vida t&amp;eacute;cnica pode ser mais barato do que o seu pagamento.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;A&amp;ccedil;&amp;otilde;es preventivas apoiam profissionais e equipes de software na aplica&amp;ccedil;&amp;atilde;o de pr&amp;aacute;ticas aceit&amp;aacute;veis que minimizam sua ocorr&amp;ecirc;ncia.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;As a&amp;ccedil;&amp;otilde;es preventivas relacionadas &amp;agrave;s d&amp;iacute;vidas de requisitos s&amp;atilde;o: controlar e negociar os requisitos de software; requisitos bem definidos; boa comunica&amp;ccedil;&amp;atilde;o entre as partes interessadas; declara&amp;ccedil;&amp;atilde;o de escopo bem definida; rastreamento de mudan&amp;ccedil;as de requisitos e compromisso com o cliente.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Ações preventivas</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarDependenciaSoftware -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarDependenciaSoftware">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
