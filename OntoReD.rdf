    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AusenciaDocumentoESR -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AusenciaDocumentoESR">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CausaReD"/>
        <untitled-ontology-3:estaAssociadaA rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EspecificacaoREQ"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DocumentoESRInadequada"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InsatisfacaoStakeholders"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NaoAtendemRequisitosCliente"/>
        <untitled-ontology-3:descricao>Ausência do documento de especificação dos requisitos carcateriza que a organizações não possui registro da especificação dos seus requisitos funcionais e não funcionais.</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Ausência do documento de especificação dos requisitos</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Automacao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Automacao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Pagamento"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AutomatizarAtividadesManuais"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>A automação relaciona-se visa automatizar o trabalho repetido manualmente, como, por exemplo, testes manuais, construções manuais e implantação manual.</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Automação</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AutomatizarAtividadesManuais -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AutomatizarAtividadesManuais">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Automacao"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Automatizar atividades manuais como testes e implantação</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AvaliacaoCliente -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AvaliacaoCliente">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Identificacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RevisaoRequisitos"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;O sucesso do trabalho com requisitos de qualidade consiste em envolver as partes interessadas progressivamente, desenvolver listas de requisitos sustent&amp;aacute;veis e registrar as pend&amp;ecirc;ncias existentes.&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;Portanto, revisar os requisitos com o cliente, incluindo a equipe de desenvolvimento, deve ser considerado essencial para toda a gest&amp;atilde;o.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;As empresas podem ajustar o produto e os requisitos especificados com base no feedback do cliente para identificar DTs com mais efici&amp;ecirc;ncia.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Avaliação do cliente</untitled-ontology-3:nome>
