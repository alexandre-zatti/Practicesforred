    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ImplementacaoIncompativelComEspecificacao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ImplementacaoIncompativelComEspecificacao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConsequenciaReD"/>
        <untitled-ontology-3:estaAssociadaA rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GerenciaREQ"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DificuldadeCompreensaoDemanda"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FalhaIdentificacaoRequisitos"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#SistemaGerenciamentoRequisitosAusenteIneficaz"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidacaoRequisitosInexistente"/>
        <untitled-ontology-3:descricao>Implementação incompatível com a especificação ocorre quando os requisitos funcionais e não funcionais implementados não atendem o que foi especificado, o que pode ser motivado pela falha na especificação dos requisitos. Caracteriza-se quando identifica-se uma incompatibilidade entre o objetivo dos stakeholders enquadrado durante a especificação dos requisitos e a implementação real do sistema.</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Implementação incompatível com a especificação</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Implementado -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Implementado">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;&lt;strong&gt;O sistema de software foi aprimorado para implementar a fatia e a fatia est&amp;aacute; pronta para teste.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;O c&amp;oacute;digo cumpre a fatia:&lt;/strong&gt; O c&amp;oacute;digo dos elementos de implementa&amp;ccedil;&amp;atilde;o cumpre as responsabilidades exigidas pela fatia.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Os elementos de implementa&amp;ccedil;&amp;atilde;o s&amp;atilde;o verificados:&amp;nbsp;&lt;/strong&gt;Os elementos de implementa&amp;ccedil;&amp;atilde;o foram verificados individualmente e demonstraram cumprir seu papel dentro da fatia.&amp;nbsp;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Implementado&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


