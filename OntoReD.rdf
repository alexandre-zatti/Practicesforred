        <untitled-ontology-3:estaAssociadaA rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GerenciaREQ"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AusenciaDocumentoESR"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DificuldadeCompreensaoDemanda"/>
