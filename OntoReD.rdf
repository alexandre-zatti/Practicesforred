    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CriteriosAceitacao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CriteriosAceitacao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Alpha"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinidoCA"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ImplementadoCA"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegistradoCA"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Apresenta&amp;ccedil;&amp;atilde;o&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Crit&amp;eacute;rios de aceita&amp;ccedil;&amp;atilde;o consistem em uma parte importante de cada user story que cont&amp;eacute;m uma lista de restri&amp;ccedil;&amp;otilde;es que devem ser atendidas para que o usu&amp;aacute;rio ou stakeholders (Product Owner) aceitem a entrega e definam como &amp;ldquo;done&amp;rdquo; ao final do seu desenvolvimento&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 9px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(Audy 2015)&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&apos;font-size: 14px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Crit&amp;eacute;rios de aceita&amp;ccedil;&amp;atilde;o:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Caracterizam-se como registros sobre regras de neg&amp;oacute;cio ou requisitos de qualidade pertencentes a user story, ou seja, um checklist de requisitos que a user story, em particular, deve atender&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 9px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(Duarte 2021)&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Para descrever os crit&amp;eacute;rios de aceita&amp;ccedil;&amp;atilde;o sugere-se o seguinte padr&amp;atilde;o&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 9px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(Audy 2015)&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;:&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Dado que&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&amp;lt;contexto inicial proposto&amp;gt;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Quando&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;lt;evento ocorrido&amp;gt;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ent&amp;atilde;o&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;lt;resultado esperado&amp;gt;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Exemplos de crit&amp;eacute;rios de aceita&amp;ccedil;&amp;atilde;o HU - Realizar Check-in no sistema da companhia a&amp;eacute;rea&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-size: 9px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(Reinher &amp;nbsp;2020)&lt;/span&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;:&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;list-style-type:disc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Apresentar os assentos para o usu&amp;aacute;rio selecionar o desejado, destacando e permitindo a sele&amp;ccedil;&amp;atilde;o dos assentos dispon&amp;iacute;veis;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&quot;list-style-type:disc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Sinalizar os assentos especiais, permitindo a aquisi&amp;ccedil;&amp;atilde;o no momento do check-in.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&quot;list-style-type:disc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Apresentar a possibilidade da compra de bagagem extra, no momento do check-in.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Crit&amp;eacute;rios de aceita&amp;ccedil;&amp;atilde;o&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">11</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CriteriosEvidenciasQualidadeDescritosDC -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CriteriosEvidenciasQualidadeDescritosDC">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConcordarDefinicaoConcluidoPB"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinicaoConcluidoPB"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;A base objetiva sobre a qual cada condi&amp;ccedil;&amp;atilde;o de qualidade ser&amp;aacute; assegurada, avaliada e evidenciada est&amp;aacute; totalmente definida.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;text-align: left;color: rgb(0, 0, 0);font-size: 14.4px;&quot;&gt;Os tipos de verifica&amp;ccedil;&amp;atilde;o/teste de garantia de qualidade que precisam ser conclu&amp;iacute;dos s&amp;atilde;o descritos.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;text-align: left;color: rgb(0, 0, 0);font-size: 14.4px;&quot;&gt;Fica claro como os resultados dos testes ser&amp;atilde;o avaliados, analisados e evidenciados.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;Crit&amp;eacute;rios e Evid&amp;ecirc;ncias de Qualidade Descritos&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CustoBeneficioQuantificadoPB -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CustoBeneficioQuantificadoPB">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProductBacklogX"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;O custo-benef&amp;iacute;cio de cada item de valor a ser incorporado ao produto foi quantificado, pelo menos relativamente, o suficiente para apoiar decis&amp;otilde;es de prioriza&amp;ccedil;&amp;atilde;o, incluindo o que &amp;eacute; certo investir no pr&amp;oacute;ximo desenvolvimento.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;&lt;span&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;O valor de cada item foi quantificado pelo menos em rela&amp;ccedil;&amp;atilde;o aos outros itens.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;O tamanho/custo de implementa&amp;ccedil;&amp;atilde;o de cada item foi quantificado pelo menos em rela&amp;ccedil;&amp;atilde;o aos outros itens.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span&gt;&lt;span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;A ordem de prioridade reflete a rela&amp;ccedil;&amp;atilde;o custo-benef&amp;iacute;cio que se prev&amp;ecirc; resultar da implementa&amp;ccedil;&amp;atilde;o de cada item.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;Custo-Benef&amp;iacute;cio Quantificado&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CustoReembolsarItemDivida -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CustoReembolsarItemDivida">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Documentacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegistrarEstimativaCutoItemReD"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Custo estimado para reembolsar o item da dívida</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DTMaiorCustoBeneficio -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DTMaiorCustoBeneficio">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Priorizacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividasMaiorCustoBeneficioPrioridadeReembolso"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;A an&amp;aacute;lise de custo X benef&amp;iacute;cio voltado a prioridade de pagamento consiste em verificar se a resolu&amp;ccedil;&amp;atilde;o de um item da d&amp;iacute;vida gerar um benef&amp;iacute;cio maior do que o custo, esse item deve ser reembolsado, ou seja, itens da d&amp;iacute;vida de requisitos com maior rela&amp;ccedil;&amp;atilde;o custo/benef&amp;iacute;cio de reembolso devem ser pagos primeiro.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Análise da prioridade custo x benefício</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DataHorarioIdentificacaoDivida -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DataHorarioIdentificacaoDivida">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Documentacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InformarDataHoraItemReD"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Data e hora da identificação da dívida</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DeclaracaoEscopoDefinido -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DeclaracaoEscopoDefinido">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcoesPreventivas"/>
        <untitled-ontology-3:classificacaoPratica>Específica</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Declaração do escopo bem definido</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinicaoConcluidoPB -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinicaoConcluidoPB">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CondicoesConclusaoListadasDC"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CriteriosEvidenciasQualidadeDescritosDC"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItemProductBacklog"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConcordarDefinicaoConcluidoPB"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>Critérios de qualidade que serão usados ​​para determinar se o produto é de qualidade aceitável/liberável.</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Definição de Concluído</untitled-ontology-3:nome>
        <untitled-ontology-3:referenciaRE>&lt;ul&gt;
    &lt;li&gt;&lt;a data-fr-linked=&quot;true&quot; href=&quot;https://practicelibrary.ivarjacobson.com/content/product-backlog-essentials-publication&quot;&gt;https://practicelibrary.ivarjacobson.com/content/product-backlog-essentials-publication&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:referenciaRE>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinicaoTecnicasER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinicaoTecnicasER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OrientacoesER"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ap&amp;oacute;s identificar as fontes de requisitos, o engenheiro de software ou analista de requisitos pode iniciar a elicita&amp;ccedil;&amp;atilde;o de requisitos, por&amp;eacute;m, os requisitos apresentados s&amp;atilde;o elicitados prontos e completos. O engenheiro de software ou analista de requisitos formula os requisitos a partir das informa&amp;ccedil;&amp;otilde;es solicitadas inicialmente.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Para realizar a elicita&amp;ccedil;&amp;atilde;o de requisitos s&amp;atilde;o propostas diferentes t&amp;eacute;cnicas para obter informa&amp;ccedil;&amp;otilde;es de requisitos relevantes para defini-los corretamente. No entanto, algumas t&amp;eacute;cnicas funcionam melhor com certas classes de stakeholders do que outras&amp;nbsp;&lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2024)&amp;nbsp;&lt;/span&gt; .&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A elicita&amp;ccedil;&amp;atilde;o, por vezes, &amp;eacute; uma tarefa dif&amp;iacute;cil, pois os stakeholders podem ter dificuldade em relacionar ou descrever suas tarefas, esquecendo informa&amp;ccedil;&amp;otilde;es importantes ou deixando de relat&amp;aacute;-las propositalmente. Nessa perspectiva, o engenheiro de software ou analista de requisitos deve ter a sensibilidade de identificar poss&amp;iacute;veis conflitos de interesse e articular a comunica&amp;ccedil;&amp;atilde;o de forma que possibilite obter informa&amp;ccedil;&amp;otilde;es claras, relevantes e corretas&amp;nbsp;&lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2024)&lt;/span&gt;.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Tentando tornar a elicita&amp;ccedil;&amp;atilde;o de requisitos espec&amp;iacute;ficos, podem ser combinadas v&amp;aacute;rias t&amp;eacute;cnicas de elicita&amp;ccedil;&amp;atilde;o, conforme a necessidade do projeto e do contexto.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Dentre as t&amp;eacute;cnicas que podem ser definidas para a elicita&amp;ccedil;&amp;atilde;o, destacam-se:&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Entrevistas:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Entrevistar as partes interessadas &amp;eacute; um meio &amp;ldquo;tradicional&amp;rdquo; de elicitar requisitos. &amp;Eacute; importante entender as vantagens e limita&amp;ccedil;&amp;otilde;es das entrevistas e como elas devem ser conduzidas &lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2024)&amp;nbsp;&lt;/span&gt;.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Hist&amp;oacute;rias de usu&amp;aacute;rio&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2024)&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;: E&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;ssa t&amp;eacute;cnica &amp;eacute; comumente usada em m&amp;eacute;todos &amp;aacute;geis e se refere &amp;agrave;s especifica&amp;ccedil;&amp;otilde;es e de alto n&amp;iacute;vel da funcionalidade necess&amp;aacute;ria expressa em termos do cliente. Uma hist&amp;oacute;ria de usu&amp;aacute;rio t&amp;iacute;pica tem o formato: &amp;ldquo;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Como &amp;lt;fun&amp;ccedil;&amp;atilde;o&amp;gt;, eu quero &amp;lt;objetivo/desejo&amp;gt; para que &amp;lt;benef&amp;iacute;cio&amp;gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;rdquo;.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Cen&amp;aacute;rios de uso:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;Os cen&amp;aacute;rios fornecem um meio interessante e detalhado para fornecer contexto para a elicita&amp;ccedil;&amp;atilde;o dos requisitos do usu&amp;aacute;rio. Permitimos que o engenheiro de software forne&amp;ccedil;a uma estrutura para perguntas sobre tarefas do usu&amp;aacute;rio, permitindo que perguntas do tipo &amp;ldquo;&amp;nbsp;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;e se&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;rdquo; e &amp;ldquo;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;como isso &amp;eacute; feito&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;rdquo; sejam realizadas. O tipo mais comum de cen&amp;aacute;rio &amp;eacute; a descri&amp;ccedil;&amp;atilde;o do caso de uso&amp;nbsp;&lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2024;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;SOMMERVILLE 2018)&lt;/span&gt;.&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Observa&amp;ccedil;&amp;atilde;o (Etnografia):&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A import&amp;acirc;ncia do contexto do software dentro do ambiente organizacional levou &amp;agrave; adapta&amp;ccedil;&amp;atilde;o de t&amp;eacute;cnicas observacionais, como a etnografia, para a obten&amp;ccedil;&amp;atilde;o de requisitos. Engenheiros de software aprendem sobre as tarefas do usu&amp;aacute;rio emergindo no ambiente e observando como os usu&amp;aacute;rios realizam suas tarefas, interagem entre si e com ferramentas de software e outros recursos&amp;nbsp;&lt;span style=&quot;font-size: 8px;&quot;&gt;(SOMMERVILLE 2018)&lt;/span&gt;.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Prototipagem de interface de usu&amp;aacute;rio de baixa ou alta fidelidade&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2024)&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;Esta t&amp;eacute;cnica &amp;eacute; uma ferramenta poderosa para requisitos claros amb&amp;iacute;guos, ausentes ou conflitantes. Fornecemos aos usu&amp;aacute;rios um contexto dentro do qual eles podem entender melhor quais informa&amp;ccedil;&amp;otilde;es precisam fornecer por meio de prot&amp;oacute;tipos.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Reuni&amp;otilde;es, incluindo brainstorming:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp;O objetivo dessas reuni&amp;otilde;es &amp;eacute; proporcionar um efeito somativo, por meio do qual um grupo de pessoas pode apresentar mais insights sobre seus requisitos de software que trabalham individualmente. Podem um brainstorming e refinar ideias dif&amp;iacute;ceis de trazer &amp;agrave; tona usando entrevistas&amp;nbsp;&lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2024)&lt;/span&gt;.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Outras t&amp;eacute;cnicas:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp;Existe uma s&amp;eacute;rie de outras t&amp;eacute;cnicas para dar suporte &amp;agrave; entrega de informa&amp;ccedil;&amp;otilde;es de requisitos como, por exemplo: grupos focais; desenvolvimento de aplicativo conjunto (JAD); planejamento de requisitos conjuntos (JRP); an&amp;aacute;lise de protocolo; question&amp;aacute;rios e pesquisas de mercado&amp;nbsp;&lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2024)&lt;/span&gt; . Informa&amp;ccedil;&amp;otilde;es sobre as t&amp;eacute;cnicas mencionadas, entre outras, podem ser acessadas por meio do guia facetado &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;color: rgb(74, 74, 74); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;de&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;t&amp;eacute;cnicas de elicita&amp;ccedil;&amp;atilde;o de requisitos, &amp;nbsp;&lt;/span&gt;&lt;span style=&apos;color: rgb(74, 74, 74); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;dispon&amp;iacute;vel em: &amp;nbsp;&lt;/span&gt;&lt;a href=&quot;https://retraining.inf.ufsc.br/guia/app&quot;&gt;&lt;span style=&apos;color: rgb(11, 87, 208); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;https://retraining.inf.ufsc.br/guia/app&lt;/span&gt;&lt;/a&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;span style=&quot;font-size: 8px;&quot;&gt;(&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&apos;color: rgb(74, 74, 74); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif; font-size: 8px;&apos;&gt;IGN&amp;Aacute;CIO; BENITTI 2020)&lt;/span&gt;&lt;span style=&apos;color: rgb(74, 74, 74); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(74, 74, 74); background-color: rgb(255, 255, 255); font-family: Roboto, sans-serif;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;color: rgb(74, 74, 74); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Em Swebok (2024) s&amp;atilde;o citadas outras t&amp;eacute;cnicas e fontes de requisitos sem a presen&amp;ccedil;a direta das partes interessadas como:&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Vers&amp;otilde;es mais antigas do sistema;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Banco de dados de rastreamento de defeitos de vers&amp;otilde;es anteriores do sistema;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Benchmarking competitivo.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Decomposi&amp;ccedil;&amp;atilde;o (por exemplo, recursos em &amp;eacute;picos em recursos em hist&amp;oacute;rias).&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Design thinking (empatia, defini&amp;ccedil;&amp;atilde;o, idealiza&amp;ccedil;&amp;atilde;o, prototipa&amp;ccedil;&amp;atilde;o, teste).&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:11pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Defini&amp;ccedil;&amp;atilde;o das t&amp;eacute;cnicas de elicita&amp;ccedil;&amp;atilde;o de requisitos&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequenciaAtividadeUC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequenciaAtividadeUC>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Definido -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Definido">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ColetarConsolidarProblemas"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConsolidarRegistrarUnificacaoProblemas"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinirEscopoRevisao"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DetectarFalhasRevReq"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Erro"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Definida a categoriza&amp;ccedil;&amp;atilde;o dos erros detectados no artefato revisado durante o processo de requisitos.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Existe uma compreens&amp;atilde;o compartilhada da classifica&amp;ccedil;&amp;atilde;o do erro detectado e seu contexto.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Para cada erro identificado, deve ser informada, al&amp;eacute;m da identifica&amp;ccedil;&amp;atilde;o e descri&amp;ccedil;&amp;atilde;o, a categoria do erro e a prioridade para corre&amp;ccedil;&amp;atilde;o, a qual &amp;eacute; acordada com os stakeholders.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Deve manter uma recomenda&amp;ccedil;&amp;atilde;o de solu&amp;ccedil;&amp;atilde;o para cada erro detectado.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Definido&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


