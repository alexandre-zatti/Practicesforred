        <untitled-ontology-3:nome>Apoio à decisão de arquitetura, avaliando o potencial da dívida</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApontarIdentificadorExclusivoItemReD -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApontarIdentificadorExclusivoItemReD"/>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApresentacaoResultadosRevReq -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApresentacaoResultadosRevReq">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRevisaoRequisitos"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Neste n&amp;iacute;vel os revisores compartilham com a equipe do projeto e, caso necess&amp;aacute;rio, tamb&amp;eacute;m com os stakeholders, os resultados da revis&amp;atilde;o de requisitos com as informa&amp;ccedil;&amp;otilde;es sintetizadas no n&amp;iacute;vel de fechamento da revis&amp;atilde;o de requisitos para adequa&amp;ccedil;&amp;otilde;es e encaminhamentos.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ap&amp;oacute;s as adequa&amp;ccedil;&amp;otilde;es, se for relevante, poder&amp;aacute; realizar uma nova &amp;nbsp;revis&amp;atilde;o dos requisitos do artefato j&amp;aacute; revisado.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Apresenta&amp;ccedil;&amp;atilde;o dos Resultados&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApresentarResultadoRevReq -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApresentarResultadoRevReq">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AtividadeProdutoTrabalho"/>
