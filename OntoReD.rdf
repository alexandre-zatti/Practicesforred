    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MonitorarPropagacaoReDAtributosQualidade -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MonitorarPropagacaoReDAtributosQualidade">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RastrearPropagacaoReD"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Monitorar a propagação da dívida de requisitos por meio de atributos de qualidade</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MontanteJuros -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MontanteJuros">
