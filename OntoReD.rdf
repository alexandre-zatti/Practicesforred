        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Refatora&amp;ccedil;&amp;atilde;o de c&amp;oacute;digo visa reescrever o c&amp;oacute;digo que cont&amp;eacute;m d&amp;iacute;vida t&amp;eacute;cnica.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Refatoração de código</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RefatorarCodigoContemDT -->

