    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NaoAtendemRequisitosCliente -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NaoAtendemRequisitosCliente">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConsequenciaReD"/>
        <untitled-ontology-3:estaAssociadaA rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GerenciaREQ"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AusenciaDocumentoESR"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DificuldadeCompreensaoDemanda"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DocumentoESRMalElaborado"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FalhaIdentificacaoRequisitos"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#SistemaGerenciamentoRequisitosAusenteIneficaz"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidacaoRequisitosInexistente"/>
        <untitled-ontology-3:descricao>A falta de gerência nos requisitos, rastreabilidade, bem como a falta do gerenciamento de mudanças promove uma dificuldade em atender as expectativas e as necessidades dos stakeholders.</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Não atendem as necessidades/requisitos do cliente</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NarrativaCasoUso -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NarrativaCasoUso">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DescritoResumidamente"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EsbocoEssencial"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EsbocoMarcadores"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TotalmenteDescrito"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoUso"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ParteCasoUso"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EcontrarAtoreseUC"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Narrativa de caso de uso&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Descreva as hist&amp;oacute;rias usadas para explorar os requisitos e identificar as fatias dos casos de uso.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Descreva uma sequ&amp;ecirc;ncia de a&amp;ccedil;&amp;otilde;es, incluindo variantes, que um Sistema de Software e seus atores podem realizar para atingir um objetivo.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;S&amp;atilde;o apresentados como um conjunto de fluxos.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Capture as informa&amp;ccedil;&amp;otilde;es de requisitos necess&amp;aacute;rias para conduzir as atividades de desenvolvimento.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Apresenta&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;As narrativas de casos de uso podem ser capturadas de muitas maneiras diferentes; como parte de um Wiki, em fichas, como documentos do Microsoft Word ou usando uma das muitas ferramentas de gerenciamento de trabalho, gerenciamento de requisitos ou modelagem visual dispon&amp;iacute;veis comercialmente.&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;A narrativa de casos de uso &amp;eacute; um produto de trabalho muito flex&amp;iacute;vel que pode ser expandido para capturar a quantidade de detalhes necess&amp;aacute;ria para ter sucesso, independentemente das circunst&amp;acirc;ncias.&amp;nbsp;Se voc&amp;ecirc; faz parte de uma pequena equipe que trabalha em colabora&amp;ccedil;&amp;atilde;o com o cliente em um projeto explorat&amp;oacute;rio, os esbo&amp;ccedil;os com marcadores fornecem uma abordagem muito leve para descobrir os requisitos.&amp;nbsp;Se voc&amp;ecirc; estiver trabalhando em um ambiente mais r&amp;iacute;gido, onde h&amp;aacute; pouco acesso aos verdadeiros especialistas, ent&amp;atilde;o esbo&amp;ccedil;os essenciais ou narrativas totalmente descritas podem ser usados para preencher as lacunas no conhecimento da equipe.&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Nem toda narrativa de casos de uso precisa ser levada ao mesmo n&amp;iacute;vel de detalhe; n&amp;atilde;o &amp;eacute; incomum que os casos de uso mais importantes e arriscados sejam mais detalhados que os outros. O mesmo vale para as se&amp;ccedil;&amp;otilde;es da narrativa do caso de uso; as partes mais importantes, complexas ou arriscadas de um caso de uso s&amp;atilde;o frequentemente descritas com mais detalhes do que as outras.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Informa&amp;ccedil;&amp;otilde;es adicionais&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;h2 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.75em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Conte&amp;uacute;do essencial&lt;/u&gt;&lt;/span&gt;&lt;/h2&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1 Nome: O nome do caso de uso. Utilize um nome, composto por um verbo e um substantivo, que descreva o resultado alcan&amp;ccedil;ado pelo caso de uso e o valor oferecido ao ator. Quando o nome do caso de uso &amp;eacute; anexado ao ator iniciador, uma frase significativa deve ser formada, por exemplo, Cliente retira dinheiro. Neste exemplo, &amp;apos;Cliente&amp;apos; &amp;eacute; o ator e &amp;apos;Retirar Dinheiro&amp;apos; &amp;eacute; o caso de uso.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1 Breve Descri&amp;ccedil;&amp;atilde;o: Uma breve descri&amp;ccedil;&amp;atilde;o do prop&amp;oacute;sito do caso de uso e do valor oferecido aos seus atores.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Fluxo B&amp;aacute;sico: Este &amp;eacute; o fluxo de eventos iniciado pelo ator e &amp;eacute; o caminho normal e esperado atrav&amp;eacute;s do caso de uso.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;0..N Fluxos Alternativos: S&amp;atilde;o fluxos adicionais de eventos que estendem o fluxo b&amp;aacute;sico para fornecer (i) formas alternativas de atingir o objetivo do caso de uso, (ii) comportamento opcional e (iii) tratamento de erros e exce&amp;ccedil;&amp;otilde;es.&lt;/li&gt;
&lt;/ul&gt;
&lt;h2 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.75em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;u&gt;Conte&amp;uacute;do adicional&lt;/u&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/h2&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Pr&amp;eacute;-condi&amp;ccedil;&amp;otilde;es: Descri&amp;ccedil;&amp;otilde;es do estado em que o sistema deve estar antes que o caso de uso possa ser iniciado.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N P&amp;oacute;s-condi&amp;ccedil;&amp;otilde;es: Descri&amp;ccedil;&amp;otilde;es do estado em que o sistema deve estar quando o caso de uso for conclu&amp;iacute;do.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;1..N Requisitos Especiais: Declara&amp;ccedil;&amp;otilde;es de requisitos n&amp;atilde;o funcionais que se aplicam ao caso de uso.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Narrativa dos casos de uso&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:referenciaRE>&lt;table style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;tbody&gt;
        &lt;tr&gt;
            &lt;td style=&quot;border: none;&quot;&gt;
                &lt;p style=&quot;font-size: 1em; text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Refer&amp;ecirc;ncias&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
                &lt;p style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;sup&gt;&lt;sup style=&quot;font-size: smaller;&quot;&gt;1&lt;/sup&gt;&lt;/sup&gt; Modelagem de casos de uso, por Kurt Bittner e Ian Spence, Addison-Wesley Professional, Parte 2: Escrevendo e revisando descri&amp;ccedil;&amp;otilde;es de casos de uso.&lt;/span&gt;&lt;/p&gt;
                &lt;p style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;sup&gt;&lt;sup style=&quot;font-size: smaller;&quot;&gt;2&lt;/sup&gt;&lt;/sup&gt; Use Case Patterns and Blueprints, por Gunnar &amp;Ouml;vergaard e Karin Palmkvist, Addison Wesley, Cap&amp;iacute;tulo 13 Descrevendo Casos de Uso.&lt;/span&gt;&lt;/p&gt;
            &lt;/td&gt;
        &lt;/tr&gt;
    &lt;/tbody&gt;
&lt;/table&gt;</untitled-ontology-3:referenciaRE>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">9</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NormaIsoIecIeee291482018 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NormaIsoIecIeee291482018">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Identificacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConfrontarNormaProjetosEspecificados"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;A norma ISO/IEC/IEEE 29148:2018 descreve a qualidade dos requisitos desde a especifica&amp;ccedil;&amp;atilde;o at&amp;eacute; outras atividades de engenharia de requisitos no ciclo de vida do desenvolvimento de software.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;Essa norma fornece detalhes para descrever requisitos textuais consistentes, incluindo caracter&amp;iacute;sticas, atributos e crit&amp;eacute;rios dos requisitos.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;A partir do momento que esses padr&amp;otilde;es de qualidade s&amp;atilde;o violados, podem surgir requirements semells e d&amp;iacute;vidas t&amp;eacute;cnicas.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;Analisar o documento de acordo com os projetos especificados e os requisitos documentados ajuda a identificar inconsist&amp;ecirc;ncias, baixos n&amp;iacute;veis de qualidade e viola&amp;ccedil;&amp;otilde;es e, consequentemente, identificar d&amp;iacute;vidas de requisitos.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Identificação através da ISO/IEC/IEEE 29148:2018</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NotacoesModeloESR -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NotacoesModeloESR">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloEspecificacaoRequisitos"/>
        <untitled-ontology-3:descricao>&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; text-indent: 36pt; text-align: center; margin-top: 0pt; margin-bottom: 0pt;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;&amp;nbsp;Poss&amp;iacute;veis nota&amp;ccedil;&amp;otilde;es que podem ser usadas para escrever requisitos do sistema&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;(Sommerville 2018):&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Frases em linguagem natural:&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Os requisitos s&amp;atilde;o escritos usando frases numeradas em linguagem natural. Cada frase deve expressar um requisito.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Linguagem natural estruturada:&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Os requisitos s&amp;atilde;o escritos em linguagem natural em um formul&amp;aacute;rio ou modelo padr&amp;atilde;o. Cada campo fornece informa&amp;ccedil;&amp;otilde;es sobre um aspecto do requisito.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Nota&amp;ccedil;&amp;otilde;es gr&amp;aacute;ficas: &amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Modelos gr&amp;aacute;ficos complementados por anota&amp;ccedil;&amp;otilde;es de texto, s&amp;atilde;o usados para definir os requisitos funcionais para o sistema; diagramas da UML (Linguagem de Modelagem Unificada), como diagramas de caso de uso s&amp;atilde;o comumente usados.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Especifica&amp;ccedil;&amp;otilde;es matem&amp;aacute;ticas:&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Essas nota&amp;ccedil;&amp;otilde;es s&amp;atilde;o baseadas em conceitos matem&amp;aacute;ticos como m&amp;aacute;quinas ou conjuntos de estado finito. Embora essas especifica&amp;ccedil;&amp;otilde;es inequ&amp;iacute;vocas possam reduzir a ambiguidade em um documento de requisitos, a maioria dos clientes n&amp;atilde;o entende uma previs&amp;atilde;o formal. Eles n&amp;atilde;o verificaram se ela representa o que querem e relutam em aceit&amp;aacute;-la como um contrato de sistema.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; padding-inline-start: 48px; font-size: initial;&quot;&gt;
    &lt;li dir=&quot;ltr&quot; style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre; margin-left: 36pt;&apos; aria-level=&quot;2&quot;&gt;
        &lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;&amp;nbsp;Modelos gr&amp;aacute;ficos s&amp;atilde;o mais &amp;uacute;teis quando voc&amp;ecirc; precisa mostrar como um estado muda ou quando &amp;eacute; preciso descrever uma sequ&amp;ecirc;ncia de a&amp;ccedil;&amp;otilde;es. &amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li dir=&quot;ltr&quot; style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre; margin-left: 36pt;&apos; aria-level=&quot;2&quot;&gt;
        &lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;&amp;nbsp;Os diagramas de sequ&amp;ecirc;ncia e de estado da UML mostram a sequ&amp;ecirc;ncia de a&amp;ccedil;&amp;otilde;es que ocorrem em resposta a uma determinada mensagem ou evento. &amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li dir=&quot;ltr&quot; style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre; margin-left: 36pt;&apos; aria-level=&quot;2&quot;&gt;
        &lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;&amp;nbsp;Especifica&amp;ccedil;&amp;otilde;es matem&amp;aacute;ticas formais s&amp;atilde;o algumas vezes usadas para descrever os requisitos para sistemas cr&amp;iacute;ticos de seguran&amp;ccedil;a, mas s&amp;atilde;o raramente usadas em outras situa&amp;ccedil;&amp;otilde;es.&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(12, 52, 61); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Nota&amp;ccedil;&amp;otilde;es&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OrientacoesER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OrientacoesER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinicaoTecnicasER"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizacaoTecnicaER"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FonteInformacaoER"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TecnicaER"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoTER"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizacaoER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:apresentacao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Elicita&amp;ccedil;&amp;atilde;o de requisitos caracterizando-se como a primeira atividade na constru&amp;ccedil;&amp;atilde;o de uma compreens&amp;atilde;o do problema que o software precisa resolver. Resumindo,&amp;nbsp;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&amp;eacute; um processo de aquisi&amp;ccedil;&amp;atilde;o de conhecimento, onde se aplicam t&amp;eacute;cnicas para compreender o neg&amp;oacute;cio a ser impactado pelo projeto de software, identificar as partes interessadas e para identificar e refinar os requisitos de software&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(V&amp;Aacute;ZQUEZ; SIM&amp;Otilde;ES 2016).&lt;/span&gt;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt; &amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;Eacute; limitado &amp;agrave; atividade humana, na qual as partes interessadas s&amp;atilde;o identificadas e os relacionamentos s&amp;atilde;o definidos entre o tempo de desenvolvimento e as partes interessadas, sendo um dos princ&amp;iacute;pios essenciais de um bom processo de elicita&amp;ccedil;&amp;atilde;o de requisitos, uma comunica&amp;ccedil;&amp;atilde;o eficaz entre as v&amp;aacute;rias partes interessadas .&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Informar o escopo do projeto &amp;eacute; considerado um elemento delicado da elicita&amp;ccedil;&amp;atilde;o de requisitos, pois consiste em fornecer uma descri&amp;ccedil;&amp;atilde;o do software que est&amp;aacute; sendo especificado, sua finalidade e priorizar as entregas para garantir que as necessidades comerciais mais importantes do cliente sejam atendidas primeiro&lt;/span&gt; &lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2014 )&lt;/span&gt;. &lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;No entanto, essas informa&amp;ccedil;&amp;otilde;es iniciais minimizam o risco de especialistas em requisitos distribu&amp;iacute;dos em tempo elicitando requisitos de baixa import&amp;acirc;ncia ou aqueles pouco relevantes, quando o software &amp;eacute; entregue. Sobretudo, a descri&amp;ccedil;&amp;atilde;o deve ser escal&amp;aacute;vel e extens&amp;iacute;vel para disposi&amp;ccedil;&amp;atilde;o de outros requisitos n&amp;atilde;o planejados inicialmente&lt;/span&gt; &lt;span style=&quot;font-size: 8px;&quot;&gt;(SWEBOK 2014)&amp;nbsp;&lt;/span&gt;.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:apresentacao>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os requisitos de software podem ser obtidos de diferentes fontes e &amp;eacute; fundamental que as fontes potenciais sejam indicadas e comprovadas&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 8px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;(SWEBOK 2024) &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Uma parte interessada pode ser qualquer pessoa, grupo ou organiza&amp;ccedil;&amp;atilde;o que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Esteja participou diretamente no projeto;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Seja afetado pelo resultado do projeto;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Possa interferir no resultado do projeto.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;As partes interessadas para projetos de software normalmente incluem (mas n&amp;atilde;o est&amp;atilde;o limitadas a essas):&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Clientes: Respons&amp;aacute;veis pela solicita&amp;ccedil;&amp;atilde;o e pagamento do software que ser&amp;aacute; desenvolvido &amp;nbsp; &amp;nbsp;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;e/ou respons&amp;aacute;veis pela decis&amp;atilde;o se o produto de software ser&amp;aacute; colocado em produ&amp;ccedil;&amp;atilde;o.&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Usu&amp;aacute;rios: Intera&amp;ccedil;&amp;atilde;o direta ou indireta com o software e podem ser classificados em classes distintas de usu&amp;aacute;rios, como: usu&amp;aacute;rios que variam em frequ&amp;ecirc;ncia de uso, tarefas executadas, habilidade, n&amp;iacute;vel de conhecimento, prefer&amp;ecirc;ncias&amp;hellip;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Especialistas do dom&amp;iacute;nio.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Equipe de opera&amp;ccedil;&amp;otilde;es.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Equipe de suporte de produto de primeiro n&amp;iacute;vel.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;Oacute;rg&amp;atilde;os profissionais relevantes.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ag&amp;ecirc;ncias reguladoras.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Grupos de interesse especial.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Desenvolvedores.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Classes de partes interessadas s&amp;atilde;o grupos de partes interessadas que possuem perspectivas e necessidades semelhantes. Trabalhar em um projeto de software em termos de classes de partes interessadas em vez de com partes interessadas individuais pode produzir insights importantes adicionais.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Muitos projetos se beneficiam da realiza&amp;ccedil;&amp;atilde;o de uma an&amp;aacute;lise de partes interessadas para identificar o m&amp;aacute;ximo poss&amp;iacute;vel de classes de partes interessadas importantes. Isso reduz a possibilidade de que os requisitos sejam tendenciosos para partes interessadas mais bem representadas e para longe de partes interessadas menos bem representadas. A an&amp;aacute;lise das partes interessadas tamb&amp;eacute;m pode informar a negocia&amp;ccedil;&amp;atilde;o e a resolu&amp;ccedil;&amp;atilde;o de conflitos quando os requisitos de uma classe de partes interessadas entram em conflito com os requisitos de outra.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Outras fontes de requisitos que e n&amp;atilde;o s&amp;atilde;o partes interessadas, podem incluir:&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Documenta&amp;ccedil;&amp;atilde;o, como requisitos para vers&amp;otilde;es anteriores, declara&amp;ccedil;&amp;otilde;es de miss&amp;atilde;o, conceito de opera&amp;ccedil;&amp;otilde;es;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Outros sistemas;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Contexto empresarial que pode incluir pol&amp;iacute;ticas e processos organizacionais;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ambiente de computa&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Pontos importantes na elicita&amp;ccedil;&amp;atilde;o de requisitos&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; (SWEBOK 2014)&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;:&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Metas:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; Refere-se aos objetivos gerais de alto n&amp;iacute;vel do software. Os objetivos visam a motiva&amp;ccedil;&amp;atilde;o para o software, mas geralmente s&amp;atilde;o vagamente formulados. Engenheiros de software ou analistas de requisitos precisam ter aten&amp;ccedil;&amp;atilde;o &amp;agrave; proposta de valor (relativo &amp;agrave; prioridade) e ao custo dos objetivos. Realizar um estudo de solu&amp;ccedil;&amp;otilde;es &amp;eacute; um mecanismo de baixo custo para atender a essa necessidade.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Conhecimento de dom&amp;iacute;nio:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; O engenheiro de software ou analista de requisitos precisa compreender o dom&amp;iacute;nio do software. O conhecimento de dom&amp;iacute;nio fornece a&amp;nbsp;&lt;/span&gt;&lt;em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;base&amp;nbsp;&lt;/span&gt;&lt;/em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;necess&amp;aacute;ria para absorver todo o conhecimento de requisitos durante a elicita&amp;ccedil;&amp;atilde;o. As associa&amp;ccedil;&amp;otilde;es entre conceitos relevantes dentro do dom&amp;iacute;nio do aplicativo devem ser identificadas.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Partes interessadas:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; O engenheiro de software ou analista de requisitos precisa identificar e gerenciar as percep&amp;ccedil;&amp;otilde;es de muitos tipos diferentes de partes interessadas quando necess&amp;aacute;rio, pois, &amp;agrave;s vezes, as partes interessadas podem entrar em conflito. Para minimizar esses conflitos, &amp;eacute; importante organizar reuni&amp;otilde;es regulares com as partes interessadas, oportunizando-lhes expressarem suas preocupa&amp;ccedil;&amp;otilde;es para chegarem em um ponto comum a todos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Regras de neg&amp;oacute;cios:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;Representam as declara&amp;ccedil;&amp;otilde;es que definem ou restringem algum aspecto da estrutura ou do comportamento do pr&amp;oacute;prio neg&amp;oacute;cio. Por exemplo: &amp;ldquo;Um aluno n&amp;atilde;o pode se registrar nos componentes curriculares do pr&amp;oacute;ximo semestre se houver pend&amp;ecirc;ncias de pagamento das mensalidades&amp;rdquo;. Essa regra de neg&amp;oacute;cio seria uma fonte de requisitos para o software de registro de cursos de uma universidade.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O ambiente operacional:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; Os requisitos ser&amp;atilde;o definidos do ambiente para que o software seja executado. Como exemplos de ambientes operacionais, destacam-se, restri&amp;ccedil;&amp;otilde;es de tempo de software associadas ao tempo real ou restri&amp;ccedil;&amp;otilde;es de desempenho em um ambiente de neg&amp;oacute;cios. Estes devem ser produzidos porque podem variar de acordo com as op&amp;ccedil;&amp;otilde;es e o custo do software, assim como as restri&amp;ccedil;&amp;otilde;es &amp;agrave;s escolhas de design.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O ambiente organizacional:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O software geralmente &amp;eacute; desenvolvido para dar suporte a um processo de neg&amp;oacute;cios, cuja sele&amp;ccedil;&amp;atilde;o pode estar condicionada &amp;agrave; estrutura, cultura e pol&amp;iacute;tica interna da organiza&amp;ccedil;&amp;atilde;o. O engenheiro de software ou analista de requisitos precisa ser sens&amp;iacute;vel a isso, pois um novo software n&amp;atilde;o deve importar mudan&amp;ccedil;as n&amp;atilde;o planejadas no processo de neg&amp;oacute;cios.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Orienta&amp;ccedil;&amp;otilde;es gerais voltadas &amp;agrave; elicita&amp;ccedil;&amp;atilde;o de requisitos&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OtimizarCodigo -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OtimizarCodigo">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Pagamento"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OtimizarCodigo"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Otimizar c&amp;oacute;digo requer agrupar m&amp;oacute;dulos coesos com depend&amp;ecirc;ncias gerenci&amp;aacute;veis para simplificar o c&amp;oacute;digo.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Otimizar código</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PadraoOrientacoesRegistroER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PadraoOrientacoesRegistroER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConfirmacaoResultadosER"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ExecucaoER"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoER"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FonteInformacaoER"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TecnicaER"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConfirmacaoInformacaoER"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoTER"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizacaoER"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RegistroInformacaoER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:apresentacao>&lt;p&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Definir um padr&amp;atilde;o e algumas orienta&amp;ccedil;&amp;otilde;es sobre as atividades que comp&amp;otilde;em a elicita&amp;ccedil;&amp;atilde;o de requisitos &amp;eacute; importante para estabelecer uma comunica&amp;ccedil;&amp;atilde;o unificada, na qual todos os analistas tenham a mesma compreens&amp;atilde;o do processo de elicita&amp;ccedil;&amp;atilde;o seguindo as mesmas diretrizes, independente da t&amp;eacute;cnica adotada.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:apresentacao>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Independente da t&amp;eacute;cnica empregada na elicita&amp;ccedil;&amp;atilde;o de requisitos, &amp;eacute; importante atender atividades fundamentais para sistematizar o processo de elicita&amp;ccedil;&amp;atilde;o: (i) prepara&amp;ccedil;&amp;atilde;o para elicita&amp;ccedil;&amp;atilde;o de requisitos; (ii) execu&amp;ccedil;&amp;atilde;o da elicita&amp;ccedil;&amp;atilde;o de requisitos e, (iii) confirma&amp;ccedil;&amp;atilde;o das informa&amp;ccedil;&amp;otilde;es da elicita&amp;ccedil;&amp;atilde;o de requisitos.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Padr&amp;atilde;o e orienta&amp;ccedil;&amp;otilde;es para a atividade de elicita&amp;ccedil;&amp;atilde;o de requisitos&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Pagamento -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Pagamento">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AreaGestaoReD"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Automacao"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CorrigirErro"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OtimizarCodigo"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Reengenharia"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ReestruturacaoCodigoProjeto"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RefatoracaoCodigo"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ToleranciaErro"/>
        <untitled-ontology-3:descricao>&lt;p&gt;Consiste no pagamento parcial ou total da d&amp;iacute;vida t&amp;eacute;cnica, evitando o seu adiamento caso afete negativamente o projeto.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Pagamento&lt;/p&gt;</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PainelItensReD -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PainelItensReD">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Comunicacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterItensReDVisiveis"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Exibir visualmente os itens da d&amp;iacute;vida de requisitos&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Painel com os itens da dívida de requisitos</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ParteCasoUso -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ParteCasoUso">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Alpha"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarParteCasoUso"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DividirCasosUso"/>
        <untitled-ontology-3:eProgredidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InspecionarCasoUso"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Analisado"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Escopo"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Implementado"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Preparado"/>
        <untitled-ontology-3:possui rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Verificado"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Apresenta&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;ul&gt;
        &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Uma fatia de casos de uso compreende tudo o que h&amp;aacute; para saber sobre as hist&amp;oacute;rias que ela cont&amp;eacute;m. Faz refer&amp;ecirc;ncia a hist&amp;oacute;rias na narrativa de casos de uso e a um conjunto de casos de teste relacionados; atua como um espa&amp;ccedil;o reservado para todo o trabalho necess&amp;aacute;rio para concluir a implementa&amp;ccedil;&amp;atilde;o das hist&amp;oacute;rias e evolui para incluir as fatias equivalentes atrav&amp;eacute;s do design, implementa&amp;ccedil;&amp;atilde;o e teste.&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Os casos de uso cobrem muitas hist&amp;oacute;rias relacionadas de import&amp;acirc;ncia e prioridade variadas.&amp;nbsp;Freq&amp;uuml;entemente, h&amp;aacute; muitas hist&amp;oacute;rias para serem entregues em um &amp;uacute;nico lan&amp;ccedil;amento e, geralmente, muitas para serem trabalhadas em um &amp;uacute;nico incremento.&amp;nbsp;Por causa disso, precisamos de uma maneira de dividir os casos de uso em partes menores que a) nos permita selecionar quais partes do caso de uso ser&amp;atilde;o entregues e quando, b) forne&amp;ccedil;a uma unidade adequada para implementa&amp;ccedil;&amp;atilde;o e teste pela equipe de desenvolvimento e c) nos permitem ter trabalhos pequenos e de tamanho semelhante que fluem rapidamente durante o desenvolvimento.&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Muitas vezes descobrimos que o caso de uso compreende muitas hist&amp;oacute;rias para serem abordadas ou desenvolvidas de uma s&amp;oacute; vez.&amp;nbsp;Por exemplo, um caso de uso pode conter 15 fluxos de eventos, alguns dos quais s&amp;atilde;o de maior prioridade que os outros e podem precisar ser desenvolvidos primeiro.&amp;nbsp;Seria bom se pud&amp;eacute;ssemos indicar claramente quais conjuntos de fluxos (e as hist&amp;oacute;rias que eles contam) ser&amp;atilde;o trabalhados em determinado momento.&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Cada fatia de caso de uso captura uma ou mais hist&amp;oacute;rias do caso de uso subjacente, permitindo facilmente que as diferentes fatias do caso de uso progridam de forma independente. As fatias de casos de uso combinam requisitos de um caso de uso, juntamente com casos de teste, para especificar claramente um aspecto do sistema que pode ser constru&amp;iacute;do e testado de forma independente.&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Uma ou mais hist&amp;oacute;rias selecionadas de um caso de uso para formar um item de trabalho que tenha valor claro para o cliente.&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
&lt;/div&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;div style=&quot;text-align: center; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Fatias de casos de uso:&lt;/strong&gt;&lt;/span&gt;&lt;/div&gt;
&lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Permita que os casos de uso sejam divididos em unidades de trabalho menores e com entrega independente.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Permita que os requisitos contidos em um conjunto de casos de uso sejam ordenados, priorizados e abordados em paralelo.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Vincule os diferentes modelos de sistema (requisitos, an&amp;aacute;lise, design, implementa&amp;ccedil;&amp;atilde;o e teste) usados no desenvolvimento orientado a casos de uso.&lt;/li&gt;
&lt;/ul&gt;
&lt;h1 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 2.375em;&quot;&gt;&lt;br&gt;&lt;/h1&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Partes de Casos de Uso&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Planejada -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Planejada">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MatrizRastreabilidade"/>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Os elementos da matriz de rastreabilidade de requisitos s&amp;atilde;o definidos:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O projeto de software foi identificado.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A finalidade da rastreabilidade de requisitos.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os respons&amp;aacute;veis pela rastreabilidade de requisitos foram definidos.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A data foi informada.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O tipo de rastreabilidade foi definida (pr&amp;eacute;, p&amp;oacute;s rastreabilidade ou ambos; rastreabilidade horizontal ou vertical).&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os itens a serem rastreados foram definidos.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Planejada&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoFonteInformacaoER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoFonteInformacaoER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoTER"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FonteInformacaoER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&apos;color: rgb(0, 0, 0);font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;color: rgb(0, 0, 0);font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A fonte de informa&amp;ccedil;&amp;atilde;o foi definida conforme a necessidade do projeto e da empresa.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Planejado&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoGR -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoGR">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GrafoRastreabilidade"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Planejado&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Os elementos do gr&amp;aacute;fico de rastreabilidade de requisitos s&amp;atilde;o definidos:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O projeto de software foi identificado.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A prop&amp;oacute;sito da rastreabilidade de requisitos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os respons&amp;aacute;veis pela rastreabilidade de requisitos foram definidos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os dados foram informados.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os artefatos e sua identifica&amp;ccedil;&amp;atilde;o a serem rastreados foram definidos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Foram definidos um tipo de n&amp;oacute; para cada tipo de artefato, bem como as linhas que representam os tr&amp;ecirc;s tipos de relacionamento: &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;executado por&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;; &amp;nbsp;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;eacute; origem&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;; &amp;nbsp;&lt;/span&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;refinar&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoTecnicaER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejadoTecnicaER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoTER"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#TecnicaER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A t&amp;eacute;cnica de elicita&amp;ccedil;&amp;atilde;o de requisitos foi definida conforme a necessidade do projeto e da empresa, como informa&amp;ccedil;&amp;otilde;es sobre analista de requisitos, partes interessadas e demais fontes de informa&amp;ccedil;&amp;otilde;es e objetivos da t&amp;eacute;cnica e cronograma.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Planejado&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejamentoCustoCicloVida -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejamentoCustoCicloVida">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Prevencao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DesenvolverPlanosEconomicosMinimizarReD"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Consiste em desenvolver planos econ&amp;ocirc;micos para minimizar a d&amp;iacute;vida de requisitos.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Planejamento de custos do ciclo de vida</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejamentoPreparacaoRevReq -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejamentoPreparacaoRevReq">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRevisaoRequisitos"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;O primeiro passo para realizar a revis&amp;atilde;o de requisitos &amp;eacute; definir, neste n&amp;iacute;vel:&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os envolvidos na revis&amp;atilde;o, ou seja, os revisores que revisar&amp;atilde;o o artefato.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O projeto no qual o artefato que ser&amp;aacute; revisado est&amp;aacute; vinculado.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O artefato que ser&amp;aacute; revisado e sua vers&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;O objetivo da revis&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A &amp;nbsp;previs&amp;atilde;o da data da revis&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;A estimativa de esfor&amp;ccedil;o que ser&amp;aacute; dedicada &amp;agrave; revis&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;S&amp;atilde;o envolvidas, de tr&amp;ecirc;s a cinco pessoas em uma revis&amp;atilde;o (normalmente). Realizar uma prepara&amp;ccedil;&amp;atilde;o antecipada por&amp;eacute;m, a revis&amp;atilde;o n&amp;atilde;o deve exigir mais do que duas horas de trabalho de cada pessoa (PRESSMAN; MAXIM &amp;nbsp;2021).&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Planejamento e Prepara&amp;ccedil;&amp;atilde;o&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejarRastreabilidadeRequisitos -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejarRastreabilidadeRequisitos">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AtividadeProdutoTrabalho"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#GrafoRastreabilidade"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MatrizRastreabilidade"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloRastreabilidade"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Atividade Produto Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;No planejamento da rastreabilidade de requisitos, devem ser definidas as seguintes informa&amp;ccedil;&amp;otilde;es fundamentais:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Informar o projeto, data e respons&amp;aacute;veis pela rastreabilidade de requisitos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Descrever a finalidade da rastreabilidade de requisitos, justificando sua necessidade.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Informar o tipo de rastreabilidade de requisitos, conforme sua classifica&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Informar os itens e/ou artefatos da rastreabilidade de requisitos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Definir o mecanismo para realizar a rastreabilidade de requisitos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&quot;text-align: justify;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Recomenda&amp;ccedil;&amp;atilde;o:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;Pode ser utilizada uma ferramenta de gest&amp;atilde;o para incluir essas informa&amp;ccedil;&amp;otilde;es sobre a rastreabilidade centralizando-a e a deixando vis&amp;iacute;vel para os membros do time de desenvolvimento.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Planejar a rastreabilidade de requisitos&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4</untitled-ontology-3:sequencia>
        <untitled-ontology-3:sequenciaAtividadeUC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequenciaAtividadeUC>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlotarMedidasReD -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlotarMedidasReD">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Monitoramento"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlotarMedidasReDObservarTendencias"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Plotar medidas agregadas à dívida de requisitos</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlotarMedidasReDObservarTendencias -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlotarMedidasReDObservarTendencias">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlotarMedidasReD"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Plotar v&amp;aacute;rias medidas de d&amp;iacute;vidas de requisitos para observar a curva para identificar tend&amp;ecirc;ncias.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Observar a curva para identificar tendências</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PadraoOrientacoesRegistroER"/>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;A prepara&amp;ccedil;&amp;atilde;o para elicita&amp;ccedil;&amp;atilde;o consiste em garantir que todos os recursos necess&amp;aacute;rios estejam organizados e preservados para a sua realiza&amp;ccedil;&amp;atilde;o e &amp;eacute; fundamental para garantir um bom resultado na elicita&amp;ccedil;&amp;atilde;o.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Entende-se como recursos:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Agenda das pessoas envolvidas&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Disponibilidade de salas&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Planejamento de viagens, quando necess&amp;aacute;rio&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Quest&amp;otilde;es log&amp;iacute;sticas de modo geral&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Tamb&amp;eacute;m, &amp;eacute; o momento de selecionar as t&amp;eacute;cnicas que ser&amp;atilde;o utilizadas durante a elicita&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;. A escolha das t&amp;eacute;cnicas pode ser influenciada pelo: dom&amp;iacute;nio do neg&amp;oacute;cio, cultura empresarial, habilidades da equipe e recursos dispon&amp;iacute;veis.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;N&amp;atilde;o existe a melhor t&amp;eacute;cnica, mas sim, aquela que se adapta melhor em determinada necessidade ou projeto.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Normalmente, na elicita&amp;ccedil;&amp;atilde;o se utiliza mais de uma t&amp;eacute;cnica.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Importante que o analista tenha familiaridade com v&amp;aacute;rias t&amp;eacute;cnicas para que seja usada a mais adequada conforme o projeto ou perfil dos stakeholders.&lt;/span&gt;&lt;/p&gt;
        &lt;ul style=&quot;font-size: initial;&quot;&gt;
            &lt;li style=&apos;list-style-type: circle;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Para auxiliar na escolha da t&amp;eacute;cnica, recomenda-se consultar as orienta&amp;ccedil;&amp;otilde;es do guia&amp;nbsp;facetado&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;color: rgb(74, 74, 74);background-color: rgb(255, 255, 255);font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;de&lt;/strong&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(74, 74, 74);background-color: rgb(255, 255, 255);font-family: Roboto, sans-serif;&quot;&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;t&amp;eacute;cnicas de elicita&amp;ccedil;&amp;atilde;o de requisitos:&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;color: rgb(74, 74, 74);background-color: rgb(255, 255, 255);font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;strong&gt;&lt;a href=&quot;https://retraining.inf.ufsc.br/guia/app&quot;&gt;&lt;span style=&apos;color: rgb(11, 87, 208);background-color: rgb(255, 255, 255);font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;https://retraining.inf.ufsc.br/guia/app&lt;/span&gt;&lt;/a&gt;&lt;/strong&gt;&lt;span style=&apos;color: rgb(74, 74, 74);background-color: rgb(255, 255, 255);font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 8px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;(&lt;/span&gt;&lt;span style=&apos;color: rgb(74, 74, 74);background-color: rgb(255, 255, 255);font-size: 8px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;IGN&amp;Aacute;CIO; BENITTI 2020)&lt;/span&gt;&lt;span style=&apos;color: rgb(74, 74, 74);background-color: rgb(255, 255, 255);font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Para qualquer necessidade de informa&amp;ccedil;&amp;atilde;o deve-se manter na prepara&amp;ccedil;&amp;atilde;o para a elicita&amp;ccedil;&amp;atilde;o:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Lista de stakeholders com pap&amp;eacute;is e responsabilidades definidas&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span style=&apos;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;(com quem o analista ir&amp;aacute; interagir).&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 14px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Prepara&amp;ccedil;&amp;atilde;o para elicita&amp;ccedil;&amp;atilde;o de requisitos&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequenciaAtividadeUC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequenciaAtividadeUC>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoTER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparacaoTER">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AtividadeProdutoTrabalho"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OrientacoesER"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PadraoOrientacoesRegistroER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Atividade Produto Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:apresAtividade>&lt;p&gt;&lt;span class=&quot;fr-close-ul&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;Esta atividade consiste em:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;&lt;span class=&quot;fr-close-ul&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;Definir&lt;/span&gt;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;&amp;nbsp;&amp;nbsp; as informa&amp;ccedil;&amp;otilde;es iniciais do projeto.&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Defini&amp;ccedil;&amp;atilde;o das fontes de informa&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Definir&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;&amp;nbsp;uma t&amp;eacute;cnica de elicita&amp;ccedil;&amp;atilde;o de requisitos.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:apresAtividade>
        <untitled-ontology-3:nome>&lt;p&gt;Preparar o treinamento de elicita&amp;ccedil;&amp;atilde;o de requisitos&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
        <untitled-ontology-3:sequenciaAtividadeUC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequenciaAtividadeUC>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Preparado -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Preparado">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;&lt;strong&gt;A fatia do caso de uso foi preparada aprimorando a &lt;span style=&apos;color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&apos;&gt;narrativa&amp;nbsp;&lt;/span&gt; e os casos de teste para definir claramente o que significa implementar a fatia com sucesso.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;&lt;strong&gt;Os requisitos dentro do escopo s&amp;atilde;o acordados:&amp;nbsp;&lt;/strong&gt;Os fluxos de casos de uso no escopo, os requisitos especiais e as informa&amp;ccedil;&amp;otilde;es de apoio foram detalhados o suficiente para serem acordados pelas partes interessadas relevantes e pela equipe do projeto.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;&lt;strong&gt;Os casos de teste s&amp;atilde;o suficientes para verifica&amp;ccedil;&amp;atilde;o:&amp;nbsp;&lt;/strong&gt;O(s) caso(s) de teste fornecem informa&amp;ccedil;&amp;otilde;es suficientes para que n&amp;atilde;o haja d&amp;uacute;vidas sobre os testes a serem executados para verificar o sucesso da implementa&amp;ccedil;&amp;atilde;o da fatia.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;&lt;strong&gt;Os testes s&amp;atilde;o bem definidos:&lt;/strong&gt; Os testes foram definidos com amplitude e profundidade suficientes, com crit&amp;eacute;rios de aceita&amp;ccedil;&amp;atilde;o claros, para verificar se o sistema funciona conforme especificado pela fatia. &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Preparado&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararItemProductBacklog -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararItemProductBacklog">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AtividadeProdutoTrabalho"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoTestePB"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Atividade Produto Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
        &lt;p style=&quot;text-align: justify; font-size: 1em;&quot;&gt;&lt;span style=&quot;text-align: start; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Certificar-se de que o item do Backlog do Produto esteja pronto para desenvolvimento e que esteja claro de como ele ser&amp;aacute; testado.&lt;/span&gt;&lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Preparar um item do Backlog do Produto&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AtividadeProdutoTrabalho"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CasoTesteUC"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NarrativaCasoUso"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Atividade Produto Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:abordagens>&lt;ul&gt;
    &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;O objetivo de preparar uma fatia de caso de uso &amp;eacute; comunicar as necessidades das partes interessadas aos desenvolvedores e testadores.&amp;nbsp;O formato da narrativa do caso de uso pode variar desde as formas textuais mais comuns, passando por fluxogramas e diagramas at&amp;eacute; sequ&amp;ecirc;ncias animadas.&amp;nbsp;Contudo a comunica&amp;ccedil;&amp;atilde;o n&amp;atilde;o acontece simplesmente porque algu&amp;eacute;m descreve algo e outros consomem a descri&amp;ccedil;&amp;atilde;o.&amp;nbsp;Em vez disso, a comunica&amp;ccedil;&amp;atilde;o mais eficaz consiste em pessoas trabalhando juntas enquanto criam algo.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.75em;&quot;&gt;&lt;span style=&quot;text-align: start;color: rgb(0, 0, 0);background-color: rgb(255, 255, 255);font-size: 12px;&quot;&gt;______________________&lt;/span&gt;&lt;/h2&gt;
&lt;h2 style=&quot;text-align: center; color: rgb(0, 0, 0); font-size: 1.75em;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Autoria em pares&lt;/u&gt;&lt;/span&gt;&lt;/h2&gt;
&lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;ul&gt;
        &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;strong&gt;Esta &amp;eacute; a abordagem recomendada.&lt;/strong&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Para melhorar a comunica&amp;ccedil;&amp;atilde;o, comprove que cada narrativa de caso de uso seja detalhada por um par com as compet&amp;ecirc;ncias An&amp;aacute;lise, Representa&amp;ccedil;&amp;atilde;o das Partes Interessadas e Teste.&amp;nbsp;A situa&amp;ccedil;&amp;atilde;o ideal &amp;eacute; quando um indiv&amp;iacute;duo tamb&amp;eacute;m tem compet&amp;ecirc;ncia de Desenvolvedor &amp;ndash; ent&amp;atilde;o essa pessoa pode levar a fatia do caso de uso at&amp;eacute; o c&amp;oacute;digo funcional.&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Se a cria&amp;ccedil;&amp;atilde;o em pares n&amp;atilde;o for poss&amp;iacute;vel, use uma das pr&amp;oacute;ximas duas abordagens com base em sua prefer&amp;ecirc;ncia;&amp;nbsp;&amp;ldquo;Autoria do cliente&amp;rdquo; ou &amp;ldquo;Autoria da equipe&amp;rdquo;.&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
    &lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;_____________________&lt;/span&gt;&lt;/p&gt;
    &lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
        &lt;h2 style=&quot;font-size: 1.75em; text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Autoria do cliente&lt;/u&gt;&lt;/span&gt;&lt;/h2&gt;
        &lt;ul&gt;
            &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Nesta abordagem, deixe que o pr&amp;oacute;prio cliente seja o autor da narrativa do caso de uso, dos casos de teste e das informa&amp;ccedil;&amp;otilde;es de suporte.&lt;/span&gt;&lt;/li&gt;
            &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Em seguida, pessoas com compet&amp;ecirc;ncia em An&amp;aacute;lise, Desenvolvedor e Teste fornecem feedback.&amp;nbsp;Esse feedback deve focar nos problemas comuns nas narrativas de casos de uso e nos casos de teste.&lt;/span&gt;&lt;/li&gt;
            &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Esse processo &amp;eacute; repetido at&amp;eacute; que a parte da narrativa do caso de uso alocada pela fatia do caso de uso seja adequada ao prop&amp;oacute;sito.&lt;/span&gt;&lt;/li&gt;
        &lt;/ul&gt;
        &lt;p style=&quot;font-size: 1em;&quot;&gt;&lt;span style=&apos;color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&apos;&gt;_____________________&lt;/span&gt;&lt;/p&gt;
        &lt;h2 style=&quot;font-size: 1.75em; text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Autoria de equipe&lt;/u&gt;&lt;/span&gt;&lt;/h2&gt;
        &lt;ul&gt;
            &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Deixar que algu&amp;eacute;m com a compet&amp;ecirc;ncia de Representa&amp;ccedil;&amp;atilde;o das Partes Interessadas comece explicando informalmente os objetivos e as hist&amp;oacute;rias do caso de uso desejado aos membros da equipe de desenvolvimento com as compet&amp;ecirc;ncias de An&amp;aacute;lise, Teste e Desenvolvedor, que ser&amp;atilde;o respons&amp;aacute;veis pela prepara&amp;ccedil;&amp;atilde;o, implementa&amp;ccedil;&amp;atilde;o e teste da fatia do caso de uso.&lt;/span&gt;&lt;/li&gt;
            &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;A equipe de desenvolvimento rebate documentando as necessidades percebidas, utilizando o formato escolhido para detalhar casos de uso e casos de teste.&amp;nbsp;Neste processo a equipe de desenvolvimento tamb&amp;eacute;m deve fazer perguntas e fornecer sugest&amp;otilde;es para resolver problemas comuns em narrativas de casos de uso e casos de teste.&lt;/span&gt;&lt;/li&gt;
            &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Em seguida, uma pessoa com compet&amp;ecirc;ncia em Representa&amp;ccedil;&amp;atilde;o das Partes Interessadas decide o que fazer com as sugest&amp;otilde;es e tenta responder &amp;agrave;s perguntas, enviando as respostas de volta &amp;agrave; equipe de desenvolvimento antes que o ciclo se repita.&lt;/span&gt;&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;
    &lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;br&gt;&lt;/div&gt;
&lt;/div&gt;</untitled-ontology-3:abordagens>
        <untitled-ontology-3:apresAtividade>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Esta atividade atualiza a fatia do caso de uso para que todos os requisitos no escopo e seus casos de teste sejam descritos.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Preparar uma fatia de caso de uso &amp;eacute; uma atividade colaborativa;&amp;nbsp;voc&amp;ecirc; precisa da contribui&amp;ccedil;&amp;atilde;o das partes interessadas, desenvolvedores e testadores para esclarecer a narrativa do caso de uso e definir os casos de teste apropriados.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Ao preparar uma fatia de caso de uso, deve se concentrar nas necessidades dos desenvolvedores e testadores que ir&amp;atilde;o implementar e verificar a fatia. Pense em como eles acessar&amp;atilde;o as informa&amp;ccedil;&amp;otilde;es de que precisam. Eles conseguir&amp;atilde;o conversar com especialistas no assunto para dar corpo &amp;agrave;s hist&amp;oacute;rias ou precisar&amp;atilde;o que tudo seja documentado para eles? Voc&amp;ecirc; tamb&amp;eacute;m precisa equilibrar o trabalho entre o detalhamento da narrativa dos casos de uso e o detalhamento dos casos de teste. Quanto mais detalhes voc&amp;ecirc; colocar na narrativa do caso de uso, mais f&amp;aacute;cil ser&amp;aacute; criar os casos de teste; por outro lado, quanto mais leve for a narrativa do caso de uso, menos duplica&amp;ccedil;&amp;atilde;o e repeti&amp;ccedil;&amp;atilde;o haver&amp;aacute; entre ela e os casos de teste. Voc&amp;ecirc; deve criar a narrativa do caso de uso e os casos de teste ao mesmo tempo para que os autores possam equilibrar suas pr&amp;oacute;prias necessidades e as de seus stakeholders. Ainda pode haver trabalho a fazer se os casos de teste forem automatizados, mas n&amp;atilde;o haver&amp;aacute; d&amp;uacute;vidas sobre o que precisa ser alcan&amp;ccedil;ado para uma implementa&amp;ccedil;&amp;atilde;o bem-sucedida.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Executar esta atividade pelo menos uma vez para cada fatia. Repita esta atividade sempre que houver altera&amp;ccedil;&amp;otilde;es aplicadas &amp;agrave; fatia.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;/p&gt;</untitled-ontology-3:apresAtividade>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;/p&gt;
&lt;p style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Uma fatia de caso de uso &amp;eacute; preparada para desenvolvimento elaborando sua narrativa e casos de teste.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;/p&gt;
&lt;div style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Depois que uma fatia &amp;eacute; selecionada para desenvolvimento, &amp;eacute; necess&amp;aacute;rio mais trabalho para:&lt;/strong&gt;&lt;/span&gt;&lt;/div&gt;
&lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Prepar&amp;aacute;-lo para o desenvolvimento.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Definir claramente o que significa implementar a fatia com sucesso.&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Definir as caracter&amp;iacute;sticas exigidas (ou seja, requisitos n&amp;atilde;o funcionais).&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Concentrar o desenvolvimento de software nos casos de teste que ele deve atender.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:infAdicionais>&lt;div style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;
    &lt;h2 style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 1.75em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Participantes&lt;/u&gt;&lt;/span&gt;&lt;/h2&gt;
    &lt;ul&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;S&amp;atilde;o diversas compet&amp;ecirc;ncias para preparar com sucesso uma fatia de caso de uso.&amp;nbsp;Normalmente esta &amp;eacute; uma atividade de grupo formada por membros da equipe com compet&amp;ecirc;ncias de An&amp;aacute;lise, Teste e Representa&amp;ccedil;&amp;atilde;o de Stakeholders.&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Representa&amp;ccedil;&amp;atilde;o das Partes Interessadas&lt;/u&gt;&lt;/span&gt;&lt;/h3&gt;
    &lt;ul&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;A compet&amp;ecirc;ncia Representa&amp;ccedil;&amp;atilde;o das Partes Interessadas desempenha o importante papel de garantir que uma fatia do caso de uso atenda &amp;agrave;s necessidades e expectativas mais importantes da comunidade das partes interessadas.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
    &lt;p style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Um conhecimento profundo do dom&amp;iacute;nio do problema e da situa&amp;ccedil;&amp;atilde;o em que o sistema ser&amp;aacute; utilizado &amp;eacute; fundamental para:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
    &lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Capture os objetivos essenciais do caso de uso.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Sugira formas eficazes para os atores interagirem com o sistema, a fim de atingir o objetivo do caso de uso.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Compreender e comunicar as alternativas prov&amp;aacute;veis ao fluxo b&amp;aacute;sico.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Confirme se o conjunto de casos de teste fornece uma verifica&amp;ccedil;&amp;atilde;o v&amp;aacute;lida dos fluxos de casos de uso, requisitos especiais ou mesmas informa&amp;ccedil;&amp;otilde;es de suporte envolvidos nos cen&amp;aacute;rios de teste.&lt;/li&gt;
    &lt;/ul&gt;
    &lt;p style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;O n&amp;iacute;vel espec&amp;iacute;fico de conhecimento do assunto necess&amp;aacute;rio depende da complexidade e do risco associado ao caso de uso que est&amp;aacute; sendo especificado.&lt;/span&gt;&lt;/p&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;An&amp;aacute;lise&lt;/u&gt;&lt;/span&gt;&lt;/h3&gt;
    &lt;p style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;O respons&amp;aacute;vel por esta atividade deve:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
    &lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Compreender, capturar e comunicar os requisitos expressos pelo caso de uso.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Utilize a oportunidade como ponto de partida ao descrever o caso de uso.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;se de que as pessoas envolvidas entendam e possam concordar com a narrativa do caso de uso.&lt;/li&gt;
    &lt;/ul&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Teste&lt;/u&gt;&lt;/span&gt;&lt;/h3&gt;
    &lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Para concluir esta atividade, os casos de teste da parcela de casos de uso devem ser definidos. O c&amp;oacute;digo &amp;eacute; fornecido por um recurso de teste especializado ou por indiv&amp;iacute;duo autor da narrativa do caso de uso.&lt;/span&gt;&lt;/p&gt;
    &lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;A compet&amp;ecirc;ncia Teste &amp;eacute; necess&amp;aacute;ria para:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
    &lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
        &lt;li style=&quot;font-size: 12px;&quot;&gt;Identifique casos de teste adequados.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px;&quot;&gt;Identifique vari&amp;aacute;veis dentro de casos de teste.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px;&quot;&gt;Escolha a amplitude e profundidade adequadas das restri&amp;ccedil;&amp;otilde;es de entrada, sa&amp;iacute;da e condi&amp;ccedil;&amp;atilde;o para os casos de teste.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px;&quot;&gt;Garante que requisitos n&amp;atilde;o funcionais e especiais sejam cobertos conforme prote&amp;ccedil;&amp;atilde;o.&lt;/li&gt;
    &lt;/ul&gt;
    &lt;p style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Se um indiv&amp;iacute;duo diferente escreveu a narrativa do caso de uso (ou seja, outro que n&amp;atilde;o &amp;eacute; o autor do caso de teste), ent&amp;atilde;o esse indiv&amp;iacute;duo dever&amp;aacute; ler os casos de teste e fornecer feedback sobre eles.&lt;/span&gt;&lt;/p&gt;
    &lt;h2 style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 1.75em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Dicas e sugest&amp;otilde;es&lt;/u&gt;&lt;/span&gt;&lt;/h2&gt;
    &lt;ul&gt;
        &lt;li&gt;
            &lt;h3 style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Conclua hist&amp;oacute;rias e fatias com base nos objetivos do projeto.&lt;/span&gt;&lt;/h3&gt;
        &lt;/li&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;As hist&amp;oacute;rias de um caso de uso n&amp;atilde;o s&amp;atilde;o igualmente cr&amp;iacute;ticas e, em particular, n&amp;atilde;o precisam ser inventadas e verificadas ao mesmo tempo.&amp;nbsp;Isso significa que, em geral, a hist&amp;oacute;ria contada pelo fluxo b&amp;aacute;sico &amp;eacute; mais importante que as outras hist&amp;oacute;rias.&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Portanto, deixe que a necessidade de conclus&amp;atilde;o oportuna da hist&amp;oacute;ria e seus riscos orientem quando detalhar cada hist&amp;oacute;ria em cada caso de uso.&amp;nbsp;Isso pode significar que alguns casos de uso t&amp;ecirc;m apenas seu fluxo b&amp;aacute;sico descrito inicialmente, j&amp;aacute; que isso &amp;eacute; tudo o que &amp;eacute; necess&amp;aacute;rio para implementar e verificar as hist&amp;oacute;rias mais urgentes.&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Se a fatia n&amp;atilde;o tiver casos de teste, ela n&amp;atilde;o foi adequada.&lt;/span&gt;&lt;/h3&gt;
    &lt;ul&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Ao preparar uma fatia de casos de uso, lembre-se de definir os casos de teste que ser&amp;atilde;o usados para verifica&amp;ccedil;&amp;atilde;o.&amp;nbsp;&amp;Eacute; observar os casos de teste que sabemos o que realmente significa &amp;ldquo;pronto&amp;rdquo; para a fatia.&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Os casos de teste fornecem aos desenvolvedores uma &amp;ldquo;defini&amp;ccedil;&amp;atilde;o de pronto&amp;rdquo; emp&amp;iacute;rica.&amp;nbsp;Eles saber&amp;atilde;o que o desenvolvimento da fatia n&amp;atilde;o ser&amp;aacute; completo at&amp;eacute; que o sistema passe os casos de teste a um n&amp;iacute;vel aceit&amp;aacute;vel para as partes interessadas.&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Testar a compet&amp;ecirc;ncia, validade, integridade e clareza&lt;/u&gt;&lt;/span&gt;&lt;/h3&gt;
    &lt;ul&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Algu&amp;eacute;m com compet&amp;ecirc;ncia em Teste precisa escrever casos de teste com base nos casos de uso. Eles n&amp;atilde;o poder&amp;atilde;o fazer isso se um caso de uso for amb&amp;iacute;guo ou incompleto; como resultado, &amp;eacute; prov&amp;aacute;vel que identifiquem esses problemas.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Portanto &amp;nbsp; , quando (a) algu&amp;eacute;m com a compet&amp;ecirc;ncia de Teste diz que o caso de uso est&amp;aacute; completamente definido e (b) algu&amp;eacute;m com a compet&amp;ecirc;ncia de Representa&amp;ccedil;&amp;atilde;o das Partes Interessadas acha que est&amp;aacute; correto, ent&amp;atilde;o o caso de uso provavelmente &amp;eacute; claro e completo .&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Revis&amp;atilde;o por pares&lt;/u&gt;&lt;/span&gt;&lt;/h3&gt;
    &lt;ul&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Transfira conhecimento para colegas, como desenvolvedores e testadores, permitindo que forne&amp;ccedil;am feedback sobre as narrativas de casos de uso e os casos de teste.&amp;nbsp;Isto melhorar&amp;aacute; a narrativa e for&amp;ccedil;ar&amp;aacute; os pares a compreender a fatia do caso de uso.&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Gera&amp;ccedil;&amp;atilde;o de casos de teste baseados em hist&amp;oacute;rias&lt;/u&gt;&lt;/span&gt;&lt;/h3&gt;
    &lt;ul&gt;
        &lt;li style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;No desenvolvimento orientado a casos de uso, os casos de teste s&amp;atilde;o derivados das hist&amp;oacute;rias de um caso de uso.&amp;nbsp;Aqui assumimos que as hist&amp;oacute;rias certas foram selecionadas (em atividades anteriores) para desenvolvimento e verifica&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/li&gt;
        &lt;li style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Agora, identifique as vari&amp;aacute;veis do cen&amp;aacute;rio considerando a entrada, a sa&amp;iacute;da e os estados internos do caso de uso especificado. Os casos de teste podem ent&amp;atilde;o ser gerados a partir de cada hist&amp;oacute;ria selecionada, selecionando dados de teste adequados.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;/ul&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Dados de teste de dimensionamento inteligente&lt;/u&gt;&lt;/span&gt;&lt;/h3&gt;
    &lt;p style=&quot;text-align: justify; color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Seja inteligente ao decidir sobre dados de teste para entrada, sa&amp;iacute;da e condi&amp;ccedil;&amp;otilde;es.&amp;nbsp;O objetivo &amp;eacute; encontrar uma amplitude de dados de teste com valor ideal para cada caso de teste, dadas as restri&amp;ccedil;&amp;otilde;es de tempo e custo.&lt;/span&gt;&lt;/p&gt;
    &lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Ainda assim, &amp;eacute; sempre necess&amp;aacute;rio que os casos de teste:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
    &lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
        &lt;li style=&quot;font-size: 12px;&quot;&gt;Descubra os fluxos de casos de uso percorridos pela hist&amp;oacute;ria.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px;&quot;&gt;Envolve dados v&amp;aacute;lidos e inv&amp;aacute;lidos para cada entrada, sa&amp;iacute;da e estado interno da hist&amp;oacute;ria.&lt;/li&gt;
    &lt;/ul&gt;
    &lt;h2 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.75em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Erros comuns&lt;/u&gt;&lt;/span&gt;&lt;/h2&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Um erro comum &amp;eacute; que uma pessoa seja autora da narrativa do caso de uso.&lt;/span&gt;&lt;/h3&gt;
    &lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;strong&gt;Problema&lt;/strong&gt;&lt;/strong&gt;&amp;nbsp; : Isso pode resultar em uma vis&amp;atilde;o polarizada das hist&amp;oacute;rias de casos de uso, levando &amp;agrave; falta de fluxos ou requisitos especiais. O consenso e a compreens&amp;atilde;o plena s&amp;atilde;o quase imposs&amp;iacute;veis de alcan&amp;ccedil;ar sozinhos.&lt;/span&gt;&lt;/p&gt;
    &lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;strong&gt;Solu&amp;ccedil;&amp;atilde;o&lt;/strong&gt;&lt;/strong&gt;&amp;nbsp; : Se isso j&amp;aacute; ocorreu, considere&lt;strong&gt;&amp;nbsp;aplicar as abordagens de autoria do cliente, autoria da equipe ou de revis&amp;atilde;o por pares.&lt;/strong&gt;&lt;u&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/sites/default/files/embedded-practices/Use_Case_2.0_Essentials_HTML_guidelines6/html/_m71tUSyJEeGkkOC4K2RI6A/Prepare%20a%20Use-Case%20Slice_gd.html#approach2&quot; style=&quot;color: rgb(75, 110, 198);&quot;&gt;&lt;/a&gt;&lt;/u&gt;&lt;/span&gt;&lt;/p&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Problemas comuns em narrativas de casos de uso&lt;/u&gt;&lt;/span&gt;&lt;/h3&gt;
    &lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Ambiguidades em termos de sequ&amp;ecirc;ncia, fazem com que o sistema deve fazer e das entradas e sa&amp;iacute;das dos operadores.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Faltam fluxos alternativos para lidar com falhas do sistema, entradas erradas e regras de neg&amp;oacute;cios que imp&amp;otilde;em fluxos alternativos.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Expressar o design da interface do usu&amp;aacute;rio, como refer&amp;ecirc;ncia a bot&amp;otilde;es, listas e janelas.&amp;nbsp;A raz&amp;atilde;o para evitar isto &amp;eacute; que o assunto deve ser tratado posteriormente por especialistas espec&amp;iacute;ficos e n&amp;atilde;o implicitamente neste momento.&lt;/li&gt;
    &lt;/ul&gt;
    &lt;h3 style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 1.3125em;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Problemas comuns nas especifica&amp;ccedil;&amp;otilde;es de casos de teste&lt;/u&gt;&lt;/span&gt;&lt;/h3&gt;
    &lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Os casos de teste n&amp;atilde;o s&amp;atilde;o baseados em hist&amp;oacute;rias definidas pelos fluxos de casos de uso.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Os dados de entrada n&amp;atilde;o s&amp;atilde;o escolhidos para garantir que limites, cantos e outros casos sejam especiais avaliados.&lt;/li&gt;
        &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;Os casos de teste n&amp;atilde;o s&amp;atilde;o escritos de forma que todos os fluxos e requisitos especiais definidos em um caso de uso sejam cobertos.&lt;/li&gt;
    &lt;/ul&gt;
&lt;/div&gt;
&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;_______________&lt;/p&gt;
&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;Refer&amp;ecirc;ncias de apoio&lt;/u&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;sup&gt;&lt;sup style=&quot;font-size: smaller;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;1&lt;/span&gt;&lt;/sup&gt;&lt;/sup&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;Use Case Modeling, by Kurt Bittner and Ian Spence, Addison-Wesley Professional, Part 2: Writing and Reviewing Use-Case Descriptions.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;sup&gt;&lt;sup style=&quot;font-size: smaller;&quot;&gt;2&lt;/sup&gt;&lt;/sup&gt; &lt;u&gt;&lt;a href=&quot;http://www.extremeprogramming.org/rules/functionaltests.html&quot; target=&quot;_blank&quot; style=&quot;color: rgb(75, 110, 198);&quot;&gt;www.extremeprogramming.org/rules/functionaltests.html&lt;/a&gt;&lt;/u&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;sup&gt;&lt;sup style=&quot;font-size: smaller;&quot;&gt;3&lt;/sup&gt;&lt;/sup&gt; Use Case Patterns and Blueprints, by Gunnar &amp;Ouml;vergaard and Karin Palmkvist, Addison Wesley, et. al, chapter 13.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:infAdicionais>
        <untitled-ontology-3:nome>&lt;p&gt;Preparar uma parte do caso de uso&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4</untitled-ontology-3:sequencia>
        <untitled-ontology-3:sequenciaAtividadeUC>&lt;p&gt;3&lt;/p&gt;</untitled-ontology-3:sequenciaAtividadeUC>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparaçãoER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PreparaçãoER">
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#OrientacoesER"/>
        <untitled-ontology-3:produz rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PadraoOrientacoesRegistroER"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Atividade Produto Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:apresentacao>&lt;p&gt;&lt;span class=&quot;fr-close-ul&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;Esta atividade consiste em:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;&lt;span class=&quot;fr-close-ul&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;Definir&lt;/span&gt;&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;&amp;nbsp;&amp;nbsp; as informa&amp;ccedil;&amp;otilde;es iniciais do projeto.&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Defini&amp;ccedil;&amp;atilde;o das fontes de informa&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;Definir&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; font-size: 12px;&apos;&gt;&amp;nbsp;uma t&amp;eacute;cnica de elicita&amp;ccedil;&amp;atilde;o de requisitos.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:apresentacao>
        <untitled-ontology-3:nome>&lt;p&gt;Prepara&amp;ccedil;&amp;atilde;o&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequenciaAtividadeUC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequenciaAtividadeUC>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Prevencao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Prevencao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AreaGestaoReD"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarFH"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApoioDecisaoArquitetura"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MelhorarProcessoDesenvolvimento"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejamentoCustoCicloVida"/>
        <untitled-ontology-3:descricao>&lt;p&gt;Objetiva verificar os artefatos existentes do projeto com o objetivo de evitar que poss&amp;iacute;veis d&amp;iacute;vidas de requisitos sejam incorridas.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Prevenção</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Priorizacao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Priorizacao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AreaGestaoReD"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AbordagemPortfolio"/>
        <untitled-ontology-3:eConstituidaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DTMaiorCustoBeneficio"/>
        <untitled-ontology-3:descricao>&lt;p&gt;Visa organizar o pagamento das d&amp;iacute;vidas t&amp;eacute;cnicas por ordem de import&amp;acirc;ncia, analisando fatores como quest&amp;otilde;es t&amp;eacute;cnicas e implica&amp;ccedil;&amp;otilde;es financeiras.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Proriza&amp;ccedil;&amp;atilde;o&lt;/p&gt;</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PriorizarCorrecaoAltoCusto -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PriorizarCorrecaoAltoCusto">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
