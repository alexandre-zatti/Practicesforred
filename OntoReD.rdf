                &lt;td style=&quot;border-left:solid #000000 1pt;border-right:solid #000000 1pt;border-top:solid #000000 0.5pt;border-bottom:solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;color:#333333;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo;Um espa&amp;ccedil;o reservado para algo a ser feito no empreendimento de engenharia de software. &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;rdquo;(Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;&lt;br&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Alfa&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXf-80w0n-VulIvVl3axoJ5ToMEHZSeVejS5vG3rloexhqj6PHwI2v5-AiLZlZ5wBkDxKn-l8unLY4wPHC5eJjAOdpo04m5RKEs-AGTWnjdjpIgJc1yPdSc2W8h-tlmkmR9Un-rBIg?key=3fwmoAqsw09K6pLWlOyGIhYi&quot; width=&quot;25&quot; height=&quot;25&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;color:#333333;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Um alfa representa e mant&amp;eacute;m o estado de algum elemento, apar&amp;ecirc;ncia ou abstra&amp;ccedil;&amp;atilde;o em um empreendimento que tem um estado discern&amp;iacute;vel e o conhecimento de cujo estado &amp;eacute; necess&amp;aacute;rio para entender o estado de progresso e/ou sa&amp;uacute;de do empreendimento&amp;rdquo;&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;(Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Estado Alpha&lt;/font&gt;
                                &lt;/font&gt;
                            &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color:#333333;background-color:#ffffff;font-size:10.5pt;font-family:&apos;Helvetica Neue&apos;,sans-serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXdrHm5ey3ePKToqK4164qe01anSdG7ipdC5OUqXT2-A-oxfKsHHhTosa0fkPzBwPicaFCqbzB42TGHqbwnj8HCQlJnaYm_jrAIc-DSxncukxq7odOoM7qgtVhuW8SelHiOTzpEG?key=3fwmoAqsw09K6pLWlOyGIhYi&quot; width=&quot;25&quot; height=&quot;25&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;color:#333333;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo;Um estado alfa &amp;eacute; uma previs&amp;atilde;o do estado de progresso de um alfa. O estado de um alfa &amp;eacute; determinado pela avalia&amp;ccedil;&amp;atilde;o de itens da lista de verifica&amp;ccedil;&amp;atilde;o&amp;rdquo;&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;(Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
        &lt;/tbody&gt;
    &lt;/table&gt;
&lt;/div&gt;</untitled-ontology-3:glossario>
        <untitled-ontology-3:nome>Clareza no documento de especificação de requisitos</untitled-ontology-3:nome>
        <untitled-ontology-3:referenciaRE>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&apos;font-size: 14px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;Refer&amp;ecirc;ncias&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;AUDY, Jorge. Scrum 360: um guia completo e pr&amp;aacute;tico de agilidade. S&amp;atilde;o Paulo, SP: Casa do C&amp;oacute;digo, 2015. &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;E-livro&lt;/span&gt;&lt;/em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;. Dispon&amp;iacute;vel em: &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;a href=&quot;https://plataforma.bvirtual.com.br&quot;&gt;&lt;u&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;https://plataforma.bvirtual.com.br&lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; (PEARSON). Acesso em: 13 conjuntos. 2024.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;SABAGH, Rafael. Scrum: gest&amp;atilde;o &amp;aacute;gil para produtos de sucesso. S&amp;atilde;o Paulo, SP: Casa do C&amp;oacute;digo, 2022. &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;E-book&lt;/span&gt;&lt;/em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;. Dispon&amp;iacute;vel em: &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;a href=&quot;https://plataforma.bvirtual.com.br&quot;&gt;&lt;u&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;https://plataforma.bvirtual.com.br&lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; (PEARSON). Acesso em: 12 conjuntos. 2024.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;DUARTE, Luiz. Scrum e M&amp;eacute;todos &amp;Aacute;geis - Um Guia Pr&amp;aacute;tico. (2021). 2. Ed. ISBN: 978-65-900538-5-5.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;FOWLER, Martin Fowler, Martin UML essencial: um breve guia para a UML essencial [recurso eletr&amp;ocirc;nico] : um breve guia para a linguagem-padr&amp;atilde;o de modelagem de objetos / Martin Fowler ; linguagem-padr&amp;atilde;o de modelagem de objetos / Martin Fowler ; tradu&amp;ccedil;&amp;atilde;o Jo&amp;atilde;o tradu&amp;ccedil;&amp;atilde;o Jo&amp;atilde;o Tortello. &amp;ndash; 3. ed. &amp;ndash; Dados eletr&amp;ocirc;nicos. &amp;ndash; Porto ortello. &amp;ndash; 3. ed. &amp;ndash; Dados eletr&amp;ocirc;nicos. &amp;ndash; Porto Alegre: Bookman, 2007. Alegre: Bookman, 2007. Esta edi&amp;ccedil;&amp;atilde;o abrange a vers&amp;atilde;o UML Esta edi&amp;ccedil;&amp;atilde;o abrange a vers&amp;atilde;o UML 2.0 OMG 2.0 OMG. ISBN 978-85-60031-38-2&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;IEEE. ISO/IEC/IEEE 29148. Norma internacional. Engenharia de sistemas e software - Processos de ciclo de vida - Engenharia de requisitos (2018).&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;INCOSE. Grupo de Trabalho de Requisitos - Conselho Internacional de Engenharia de Sistemas. Guia para Escrever Requisitos (2023).&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;OLIVEIRA Jr, Edson. &amp;amp; GERALDI, Ricardo Theis. (2017). Tipos de Defeitos e T&amp;eacute;cnicas de Inspe&amp;ccedil;&amp;atilde;o de Software: Um Estudo de Mapeamento Sistem&amp;aacute;tico. &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Jornal de Ci&amp;ecirc;ncia da Computa&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&amp;nbsp;, &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;13&lt;/span&gt;&lt;/em&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(10), 470-495. &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;a href=&quot;https://doi.org/10.3844/jcssp.2017.470.495&quot;&gt;&lt;u&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;https://doi.org/10.3844/jcssp.2017.470.495&lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;POHL, Klaus; Rupp, Chris. Fundamentos da Engenharia de Requisitos (2015). Conselho Internacional de Engenharia de Requisitos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;REINEHR, Sheila. Engenharia de Requisitos (2020). ISBN 978-65-5690-067-4. Porto Alegre: SAGAH.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc;font-size: 12px;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;SOMMERVILLE, Ian. Engenharia de software. (2018). 10. Ed. ISBN: 978-85-430-2497-4.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:referenciaRE>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterItensReDVisiveis -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterItensReDVisiveis">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PainelItensReD"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterMapaPagamentoDecisoesEliminacaoDivida -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterMapaPagamentoDecisoesEliminacaoDivida">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MapaPagamento"/>
        <untitled-ontology-3:classificacaoPratica>&lt;p&gt;Comum&lt;/p&gt;</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;Manter mapa de pagamento para orientar decis&amp;otilde;es sobre a elimina&amp;ccedil;&amp;atilde;o da d&amp;iacute;vida.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Manter mapa de pagamento</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterPraticasMinimizeReD -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterPraticasMinimizeReD">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AnalisarFH"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:nome>Manter a cultura de práticas que minimize a dívida de requisitos</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MapaGuiaConjuntoPraticasPagamentoDivida -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MapaGuiaConjuntoPraticasPagamentoDivida">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MapaPagamento"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;Mapa como um guia para manter um conjunto de pr&amp;aacute;ticas conforme a necessidade de pagamento da d&amp;iacute;vida.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Mapa como um guia&lt;/p&gt;</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MapaPagamento -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MapaPagamento">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:eParteDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Identificacao"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterMapaPagamentoDecisoesEliminacaoDivida"/>
        <untitled-ontology-3:implementadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MapaGuiaConjuntoPraticasPagamentoDivida"/>
        <untitled-ontology-3:classificacaoPratica>Geral</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;O mapa de pagamento consiste em um guia, &amp;nbsp;e pode informar um conjunto de pr&amp;aacute;ticas em resposta &amp;agrave; necessidade de pagamento da d&amp;iacute;vida t&amp;eacute;cnica.&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;O mapa pode ser usado como um dispositivo de comunica&amp;ccedil;&amp;atilde;o para apoiar as equipes a comunicar efetivamente as d&amp;iacute;vidas existentes aos gerentes e decidir melhor sobre o pagamento da d&amp;iacute;vida de requisitos.&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;
&lt;p&gt;Os profissionais de software podem consultar este mapa para orientar suas decis&amp;otilde;es sobre a elimina&amp;ccedil;&amp;atilde;o de d&amp;iacute;vida de requisitos em seus projetos.&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Mapa de pagamento</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MatrizRastreabilidade -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MatrizRastreabilidade">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EmExecucao"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Planejada"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Realizada"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItemArtefatoRastreado"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RelacionamentoItensArtefatos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#AcompanharManterRastreabilidadeRequisitos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PlanejarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarRastreabilidadeRequisitos"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-size: 14px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Matriz de rastreabilidade&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;T&amp;eacute;cnica que facilita a visualiza&amp;ccedil;&amp;atilde;o da rastreabilidade documentada entre requisitos&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: italic; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;versus&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;requisitos e requisitos&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: italic; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;versus&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;outros itens. Na matriz, incluem-se os itens rastreados nos eixos de uma tabela e marcam-se os pontos de interse&amp;ccedil;&amp;atilde;o&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 8px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;(&lt;/span&gt;&lt;span style=&apos;font-size: 8px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;VAZQUEZ; &amp;nbsp;SIM&amp;Otilde;ES 2016)&lt;/span&gt;&lt;span style=&apos;font-size: 8px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;Caso o projeto tenha poucos requisitos, uma tabela ou planilha normalmente &amp;eacute; suficiente. Por&amp;eacute;m, se o projeto manter um grande volume de requisitos, recomenda-se usar uma ferramenta especializada, pois uma planilha &amp;eacute; invi&amp;aacute;vel para atender o esfor&amp;ccedil;o da manuten&amp;ccedil;&amp;atilde;o na rastreabilidade.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;A matriz serve de atividade complementar &amp;agrave;s an&amp;aacute;lises de impactos das mudan&amp;ccedil;as de requisitos solicitadas.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; text-align: center; margin-top: 0pt; margin-bottom: 0pt;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;Apresenta&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-indent: 36pt;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 700; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;Uma matriz de rastreabilidade possui &amp;nbsp;linhas e colunas:&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0;margin-bottom:0;padding-inline-start:48px;&quot;&gt;
    &lt;li dir=&quot;ltr&quot; style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre; margin-left: 36pt;&apos; aria-level=&quot;1&quot;&gt;
        &lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;As linhas da matriz de rastreabilidade s&amp;atilde;o rotuladas com os nomes dos requisitos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li dir=&quot;ltr&quot; style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre; margin-left: 36pt;&apos; aria-level=&quot;1&quot;&gt;
        &lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;As colunas podem ser rotuladas com o nome de um outro artefato da engenharia de software, como &amp;nbsp;um elemento do projeto ou um caso de teste.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li dir=&quot;ltr&quot; style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre; margin-left: 36pt;&apos; aria-level=&quot;1&quot;&gt;
        &lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;A presen&amp;ccedil;a de um v&amp;iacute;nculo (relacionamento) entre os dois artefatos &amp;eacute; sinalizada na c&amp;eacute;lula da matriz.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li dir=&quot;ltr&quot; style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre; margin-left: 36pt;&apos; aria-level=&quot;1&quot;&gt;
        &lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: justify;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&apos;&gt;As matrizes de rastreabilidade podem ser usadas para garantir que os artefatos de engenharia considerem todos os requisitos.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:#ffffff;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;Figura 1: Exemplo 1 de matriz de &amp;nbsp;rastreabilidade entre requisitos&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;color:#0c343d;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXchh54D9nTlXViXvDXLjBCzYyIIuyfYlOYVmCR3m67_5tlxwm39SlBKUWoU52CkgCJS9kYXpaMDPkO_VFxjkbUpm38XUr1J-Tu4QrVn66VYl25n7PO_2IqXfgdkZUHYNL-RBkAB1jBZ79UZkkxDyD6Gf-IL?key=bWYZdeVOtJgVilXi-41QBQ&quot; width=&quot;352&quot; height=&quot;119&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:#ffffff;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;Fonte: Kechi, 2011&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;br&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:#ffffff;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;Figura 2: Exemplo 2 de matriz de &amp;nbsp;rastreabilidade entre requisitos&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:#ffffff;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;&lt;span style=&quot;color:#0c343d;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXfJBfkf0SnWwEDuod2-ORs1WBS577o-s5_ziNyxov-IjL05yCbKxv7xoX4w0Qh7gafxMozO5EY1YH3CePiuI74dY93hkGUdXbjgAhcMbqnnL3ZTc7oLtIDKEUrV_gfMOcs-Qxsn99xnGsJ5F4b9tKAY4_Pn?key=bWYZdeVOtJgVilXi-41QBQ&quot; width=&quot;391&quot; height=&quot;146&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:#ffffff;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;Fonte: Kechi, 2011&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;br&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:#ffffff;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;Figura 3: &amp;nbsp;Exemplo 3 de matriz de rastreabilidade de requisitos elaborada em planilha eletr&amp;ocirc;nica&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;color:#0c343d;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;border:none;&quot;&gt;&lt;img src=&quot;https://lh7-rt.googleusercontent.com/docsz/AD_4nXcxPqnq9jz5Azbs0hu6BSPKW7NteEoVwYnqdnM99z6sHWabVYFMhbKcEJKJGEpRuY5r6OYSzvlbEVI6YgFo7R0ysdr1i5dKWgC7eBVQqZ9lSulwE-z02Y0ZEpfQkh2-03llB326ayD2LJJiP5AC6Xddqw8?key=bWYZdeVOtJgVilXi-41QBQ&quot; width=&quot;315&quot; height=&quot;229&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size:8pt;font-family:&apos;Times New Roman&apos;,serif;color:#000000;background-color:#ffffff;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;Fonte: Reinehr, 2018&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Matriz de rastreabilidade&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


