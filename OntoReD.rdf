        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ApresentarResultadoRevReq"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ColetarConsolidarProblemas"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CompreenderDocumentoEspecRequisitos"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConcluidoRevReq"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConsolidarRegistrarUnificacaoProblemas"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CorrigirErrosUnificacao"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Definido"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DefinirEscopoRevisao"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DetectarFalhasRevReq"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EntenderRequisitos"/>
        <untitled-ontology-3:descritoEmTermosDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Erro"/>
