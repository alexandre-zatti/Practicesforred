    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequirementsSmells -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequirementsSmells">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ConsequenciaReD"/>
        <untitled-ontology-3:estaAssociadaA rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EspecificacaoREQ"/>
        <untitled-ontology-3:ocasionadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FalhaIdentificacaoRequisitos"/>
        <untitled-ontology-3:descricao>Requirements smells surgem quando as construções linguísticas podem indicar uma violação da norma ISO/IEC/IEEE 29148:2018, que se refere à qualidade dos requisitos. Esses smells também existem para outras abordagens de documentação de requisitos, por exemplo, UML. 
Caso os smells não forem removidos, o requisito pode ser implementado incorretamente, dificultando sua reutilização e avaliação.</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Requirements smells</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


