        <untitled-ontology-3:nome>Probabilidade de juros</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProbabilidadeJurosItemReDReembolsados -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProbabilidadeJurosItemReDReembolsados">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProbabilidadeJuros"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Informar a probabilidade que os juros do item da d&amp;iacute;vida de requisitos ser&amp;atilde;o considerados ao serem reembolsados.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Probabilidade dos juros das dívidas de requisitos reembolsados</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProductBacklog -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProductBacklog">
        <untitled-ontology-3:nome>Uma lista ordenada de itens a serem incorporados ao produto para aumentar seu valor.</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProductBacklogX -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProductBacklogX">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProdutoTrabalhoPratica"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CustoBeneficioQuantificadoPB"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItensColetadosPB"/>
        <untitled-ontology-3:contem rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItensPriorizadosPB"/>
        <untitled-ontology-3:eOrganizadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItemProductBacklog"/>
        <untitled-ontology-3:eProduzidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RefinarProductBacklog"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Produto de Trabalho&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:apresentacao>&lt;p&gt;&lt;span style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;Capturar o que os usu&amp;aacute;rios de um sistema desejam que ele fa&amp;ccedil;a como uma lista classificada por prioridade de itens que podem ser constru&amp;iacute;dos de forma independente.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:apresentacao>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;Uma lista ordenada de itens a serem incorporados ao produto para aumentar seu valor.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Product Backlog&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:referenciaRE>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/product-backlog-essentials-publication&quot;&gt;https://practicelibrary.ivarjacobson.com/content/product-backlog-essentials-publication&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul style=&quot;text-align: start;color: rgb(0, 0, 0);font-size: 16px;&quot;&gt;
    &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;strong&gt;&lt;strong&gt;Agile Backlog&lt;/strong&gt;&lt;/strong&gt;: A backlog as a ranked to-do list is common to many agile approaches, see &lt;u&gt;&lt;a href=&quot;https://www.agilealliance.org/glossary/backlog/&quot; target=&quot;_blank&quot; style=&quot;color: rgb(75, 110, 198);&quot;&gt;https://www.agilealliance.org/glossary/backlog/&lt;/a&gt;&lt;/u&gt;.&lt;/li&gt;
    &lt;li style=&quot;font-size: 1em; text-align: justify;&quot;&gt;&lt;strong&gt;&lt;strong&gt;Product Backlog in Scrum&lt;/strong&gt;&lt;/strong&gt;: A &amp;lsquo;Product Backlog&amp;rsquo; is part of Scrum, see &lt;u&gt;&lt;a href=&quot;http://www.scrumguides.org/scrum-guide.html#artifacts-productbacklog&quot; target=&quot;_blank&quot; style=&quot;color: rgb(75, 110, 198);&quot;&gt;http://www.scrumguides.org/scrum-guide.html#artifacts-productbacklog&lt;/a&gt;&lt;/u&gt;.&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:referenciaRE>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProntoDesenvolvimentoIPB -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProntoDesenvolvimentoIPB">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararItemProductBacklog"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ItemProductBacklog"/>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;O item est&amp;aacute; suficientemente compreendido para que a equipe respons&amp;aacute;vel por adicion&amp;aacute;-lo ao produto, possa planejar e iniciar o trabalho para realiz&amp;aacute;-lo.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;O&lt;span style=&quot;text-align: left;color: rgb(0, 0, 0);font-size: 14.4px;&quot;&gt;&amp;nbsp;item &amp;eacute; bem compreendido pelas partes interessadas e pela equipe para que seja priorizado para desenvolvimento.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;text-align: left;color: rgb(0, 0, 0);font-size: 14.4px;&quot;&gt;O valor &amp;eacute; compreendido o suficiente para prosseguir.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span&gt;&lt;span&gt;&lt;span style=&quot;text-align: left;color: rgb(0, 0, 0);font-size: 14.4px;&quot;&gt;O tamanho do item &amp;eacute; compreendido o suficiente para prosseguir.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
    &lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span&gt;&lt;span&gt;&lt;span&gt;&lt;span style=&quot;text-align: left;color: rgb(0, 0, 0);font-size: 14.4px;&quot;&gt;A prioridade relativa do item &amp;eacute; acordada.&lt;strong&gt;&lt;/strong&gt;&lt;strong&gt;&lt;/strong&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;b&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;&lt;strong&gt;Pronto para Desenvolvimento&lt;/strong&gt;&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span&gt;&lt;span&gt;&lt;span&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProntoparaCorrecao -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ProntoparaCorrecao">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CorrigirErrosUnificacao"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Erro"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;strong&gt;Os erros detectados e unificados pelos revisores s&amp;atilde;o encaminhados para corre&amp;ccedil;&amp;atilde;o.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;Existe um profissional destinado para corre&amp;ccedil;&amp;atilde;o dos erros.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;A descri&amp;ccedil;&amp;atilde;o do erro &amp;eacute; suficientemente compreendida pelo respons&amp;aacute;vel pela corre&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;Pronto para corre&amp;ccedil;&amp;atilde;o&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


