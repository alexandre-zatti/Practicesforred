                &lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;&lt;br&gt;&lt;/td&gt;
                &lt;td style=&quot;border: solid #000000 1pt;&quot;&gt;
                    &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;Um elemento pode ser um produto de trabalho, atividade, atividade, alfa ou estado alfa.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
