                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;&amp;ldquo;Um estado alfa &amp;eacute; uma previs&amp;atilde;o do estado de progresso de um alfa. O estado de um alfa &amp;eacute; determinado pela avalia&amp;ccedil;&amp;atilde;o de itens da lista de verifica&amp;ccedil;&amp;atilde;o&amp;rdquo;&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt;(Jacobson, 2018). Dispon&amp;iacute;vel em:&amp;nbsp; &lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;a href=&quot;https://practicelibrary.ivarjacobson.com/content/essence-language-key&quot;&gt;&lt;u&gt;&lt;span style=&quot;color:#1155cc;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                                    &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                        &lt;font style=&quot;vertical-align: inherit;&quot;&gt;https://practicelibrary.ivarjacobson.com/content/essence-language-key&lt;/font&gt;
                                    &lt;/font&gt;
                                &lt;/span&gt;&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;
                            &lt;font style=&quot;vertical-align: inherit;&quot;&gt;
                                &lt;font style=&quot;vertical-align: inherit;&quot;&gt; &amp;nbsp;Acesso em maio de 2023.&lt;/font&gt;
                            &lt;/font&gt;
                        &lt;/span&gt;&lt;/p&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
        &lt;/tbody&gt;
    &lt;/table&gt;
&lt;/div&gt;</untitled-ontology-3:glossario>
        <untitled-ontology-3:introducao>&lt;p&gt;A elicita&amp;ccedil;&amp;atilde;o envolve t&amp;eacute;cnicas, comunica&amp;ccedil;&amp;atilde;o estruturada e an&amp;aacute;lise das diversas fontes de informa&amp;ccedil;&amp;atilde;o: stakeholders, documentos, sistemas existentes e ambiente organizacional. Ressalta-se a import&amp;acirc;ncia do Product Owner formular, refinar e validar as informa&amp;ccedil;&amp;otilde;es coletadas, pois &amp;eacute; necess&amp;aacute;rio compreender o dom&amp;iacute;nio, regras de neg&amp;oacute;cio e contexto operacional para garantir requisitos claros, relevantes e alinhados ao escopo.&lt;/p&gt;</untitled-ontology-3:introducao>
        <untitled-ontology-3:nome>Treinamento de padrões para elicitação de requisitos</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidacaoREQ -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidacaoREQ">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#FaseEngenhariaRequisitos"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DificuldadeManterUX"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InsatisfacaoStakeholders"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Retrabalho"/>
        <untitled-ontology-3:eEvidenciadaPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidacaoRequisitosInexistente"/>
        <untitled-ontology-3:faseER rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4</untitled-ontology-3:faseER>
        <untitled-ontology-3:nome>Validação de Requisitos</untitled-ontology-3:nome>
        <untitled-ontology-3:sigla>VR</untitled-ontology-3:sigla>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidacaoRequisitosInexistente -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidacaoRequisitosInexistente">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#CausaReD"/>
        <untitled-ontology-3:estaAssociadaA rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidacaoREQ"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ManterDescreverClarezaDREQ"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#MonitorarProgressoREQ"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrototipoValidacaoREQ"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RealizarCerimonias"/>
        <untitled-ontology-3:mitigadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RevisaoRequisitos"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ImplementacaoIncompativelComEspecificacao"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#InsatisfacaoStakeholders"/>
        <untitled-ontology-3:ocasiona rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#NaoAtendemRequisitosCliente"/>
        <untitled-ontology-3:descricao>Validação de requisitos inexistente ocorre quando os stakeholders não participam do processo de verificação das necessidades para conferência, especificadas pela organização.</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Validação dos requisitos inexistente</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Validado -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Validado">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DescreverInformacoesAdd"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DesenvolverModelagemRequisitos"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RevisaoInspecaoManterClarezaDER"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequisitosUsuario"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os requisitos de usu&amp;aacute;rio foram validados levando &amp;agrave; obten&amp;ccedil;&amp;atilde;o do produto, metas e objetivos, expectativas das partes interessadas, riscos e conceitos de ciclo de vida dentro das restri&amp;ccedil;&amp;otilde;es (como custo, cronograma, conformidade t&amp;eacute;cnica, legal e regulat&amp;oacute;ria) com risco aceit&amp;aacute;vel&lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt; &lt;/span&gt;&lt;span style=&apos;font-size: 9px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(INCOSE 2023)&lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Validado&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidadoRS -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValidadoRS">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DescreverInformacoesAdd"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#DesenvolverModelagemRequisitos"/>
        <untitled-ontology-3:avancadoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RevisaoInspecaoManterClarezaDER"/>
        <untitled-ontology-3:eSequenciaDe rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#RequisitosSistema"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Os requisitos de sistema foram validados levando &amp;agrave; obten&amp;ccedil;&amp;atilde;o do produto, metas e objetivos, expectativas das partes interessadas, riscos e conceitos de ciclo de vida dentro das restri&amp;ccedil;&amp;otilde;es (como custo, cronograma, conformidade t&amp;eacute;cnica, legal e regulat&amp;oacute;ria) com risco aceit&amp;aacute;vel&lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;font-size: 9px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;(INCOSE 2023)&lt;/span&gt;&lt;span style=&quot;font-size:10pt;font-family:&apos;Times New Roman&apos;,serif;&quot;&gt;.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Validado&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValorEstabelecido -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValorEstabelecido">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EcontrarAtoreseUC"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloCasoUso"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;O primeiro passo para um modelo de casos de uso completo &amp;eacute; identificar os atores e casos de uso mais importantes, ou seja, os principais. Os principais casos de uso s&amp;atilde;o aqueles que fornecem o valor mais importante.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Uma mera lista de atores e casos de uso n&amp;atilde;o &amp;eacute; suficiente para comunicar o modelo de casos de uso. O modelo deve ser ilustrado e explicado. O formato para isso costuma ser diagramas com atores e casos de uso, acompanhados de texto explicativo (aqui denominado &amp;ldquo;explica&amp;ccedil;&amp;atilde;o do modelo como um todo&amp;rdquo;).&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Este &amp;eacute; o n&amp;iacute;vel de detalhe mais leve. &amp;Eacute; adequado para a maioria dos projetos, especialmente aqueles que adicionam novas funcionalidades a sistemas existentes, onde h&amp;aacute; pouco ou nenhum valor em modelar tudo o que o sistema j&amp;aacute; faz.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Os atores prim&amp;aacute;rios foram nomeados e brevemente descritos.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Os casos de uso prim&amp;aacute;rios foram nomeados e descritos resumidamente, ou seja, no estado descrito resumidamente ou al&amp;eacute;m.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Exista uma explica&amp;ccedil;&amp;atilde;o do modelo de casos de uso como um todo.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;Valor estabelecido&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValorEstabelecidoModeloESR -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ValorEstabelecidoModeloESR">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:estaContidoEm rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ModeloEspecificacaoRequisitos"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;Para realizar a elabora&amp;ccedil;&amp;atilde;o de requisitos recomenda-se definir e registrar informa&amp;ccedil;&amp;otilde;es organizando-as por meio de um documento de concep&amp;ccedil;&amp;atilde;o de requisitos.&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify; font-size: 12px;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;O quadro 1 apresenta uma sugest&amp;atilde;o de organiza&amp;ccedil;&amp;atilde;o do documento de requisitos, que pode ser adaptada conforme a necessidade da organiza&amp;ccedil;&amp;atilde;o, do tipo de software que est&amp;aacute; sendo desenvolvido e da abordagem de desenvolvimento&amp;nbsp;&lt;span style=&quot;font-size: 9px;&quot;&gt;(IEEE, 2018)&lt;/span&gt;&amp;nbsp; . &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;&amp;Eacute; &amp;nbsp;poss&amp;iacute;vel incluir informa&amp;ccedil;&amp;otilde;es sobre a evolu&amp;ccedil;&amp;atilde;o prevista no sistema, pois ser&amp;aacute; &amp;uacute;til na manuten&amp;ccedil;&amp;atilde;o do sistema&lt;/span&gt;&lt;span style=&apos;font-size: 7pt; font-family: &quot;Times New Roman&quot;, serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;&amp;nbsp; (Sommerville 2018).&lt;/span&gt;&lt;span style=&apos;font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/div&gt;
&lt;ul&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;As informa&amp;ccedil;&amp;otilde;es recomendadas podem ser registradas em documentos textuais ou ferramentas que fornecem o suporte para o registro e a rela&amp;ccedil;&amp;atilde;o entre as informa&amp;ccedil;&amp;otilde;es.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;A abordagem de cada elemento descrito na recomenda&amp;ccedil;&amp;atilde;o da estrutura de organiza&amp;ccedil;&amp;atilde;o do documento de concep&amp;ccedil;&amp;atilde;o de requisitos ser&amp;aacute; descrita ap&amp;oacute;s a apresenta&amp;ccedil;&amp;atilde;o do &amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;quadro1.&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; text-indent: 36pt; margin-top: 0pt; margin-bottom: 0pt;&quot;&gt;&lt;span style=&apos;font-size: 7pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;Quadro 1 - Recomenda&amp;ccedil;&amp;atilde;o de informa&amp;ccedil;&amp;otilde;es para o documento&lt;/span&gt; &lt;span style=&apos;font-size: 8pt; font-family: &quot;Times New Roman&quot;, serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;table&gt;
    &lt;tbody&gt;
        &lt;tr style=&quot;height:0pt;&quot;&gt;
            &lt;td style=&quot;border-width: 1pt; border-color: rgb(0, 0, 0); vertical-align: top; padding: 5pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;1.1 Prop&amp;oacute;sito&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;1.2 Escopo&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;1.3 Vis&amp;atilde;o do produto&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;&amp;nbsp; &amp;nbsp;1.3.1 Perspectiva do produto&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;&amp;nbsp; &amp;nbsp;1.3.2 Fun&amp;ccedil;&amp;otilde;es do produto&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;&amp;nbsp; &amp;nbsp;1.3.3 Caracter&amp;iacute;sticas dos usu&amp;aacute;rios&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;&amp;nbsp; 1.3.4 Limita&amp;ccedil;&amp;otilde;es&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;1.4 Defini&amp;ccedil;&amp;otilde;es&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;2.1 Defini&amp;ccedil;&amp;atilde;o dos requisitos do usu&amp;aacute;rio&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;2.2 Especifica&amp;ccedil;&amp;atilde;o dos requisitos do sistema&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;2.3 Modelos de sistema&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;5.1 Gloss&amp;aacute;rio&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;5.2 Acr&amp;ocirc;nimos e abrevia&amp;ccedil;&amp;otilde;es&lt;/span&gt;&lt;/p&gt;
                &lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; margin-left: 72pt; margin-top: 0pt; margin-bottom: 0pt; text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 9pt; font-family: &quot;Times New Roman&quot;, serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;5.3 &amp;ldquo;outras informa&amp;ccedil;&amp;otilde;es relevantes&amp;rdquo;&lt;/span&gt;&lt;/p&gt;
            &lt;/td&gt;
        &lt;/tr&gt;
    &lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;&lt;span style=&apos;font-size: 8pt; font-family: &quot;Times New Roman&quot;, serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; vertical-align: baseline; white-space-collapse: preserve;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Fonte: Informa&amp;ccedil;&amp;otilde;es adaptadas de IEEE, 2018; Summerville, 2018&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.2; text-indent: 21.2598pt; margin-top: 0pt; margin-bottom: 0pt; text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Descri&amp;ccedil;&amp;atilde;o dos itens do documento:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Introdu&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
        &lt;ul style=&quot;font-size: initial;&quot;&gt;
            &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Prop&amp;oacute;sito:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;Deve apresentar o prop&amp;oacute;sito do software a ser especificado.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
            &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Escopo:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&amp;nbsp;Deve considerar:&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;a) identifica&amp;ccedil;&amp;atilde;o do produto de software a ser produzido pelo nome (por exemplo, Host DBMS, Report Generator, etc.);&lt;/span&gt;
            &lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; b) explica&amp;ccedil;&amp;atilde;o de que o produto de software far&amp;aacute;;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; c) a aplica&amp;ccedil;&amp;atilde;o do software que esteja sendo especificado, incluindo benef&amp;iacute;cios, objetivos e metas relevantes; e&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; d) ser consistente com declara&amp;ccedil;&amp;otilde;es semelhantes em especifica&amp;ccedil;&amp;otilde;es de n&amp;iacute;vel superior (por exemplo, uma concep&amp;ccedil;&amp;atilde;o de requisitos de sistema), se existirem.&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Vis&amp;atilde;o do Produto:&lt;/span&gt;&lt;/strong&gt;&lt;/li&gt;
    &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Perspectiva do produto:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;Definir o relacionamento do sistema com outros produtos relacionados. Considere um diagrama de blocos mostrando os principais elementos do sistema maior, interconex&amp;otilde;es e interfaces externas.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Fun&amp;ccedil;&amp;otilde;es do produto:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&amp;nbsp;Fornecer um resumo das principais fun&amp;ccedil;&amp;otilde;es que o software executar&amp;aacute;. Por exemplo, um programa de contabilidade pode usar esta parte para abordar a manuten&amp;ccedil;&amp;atilde;o da conta do cliente, extrato do cliente e prepara&amp;ccedil;&amp;atilde;o de faturas sem mencionar a vasta quantidade de detalhes que cada uma dessas fun&amp;ccedil;&amp;otilde;es requer.&lt;/span&gt;&lt;/p&gt;
        &lt;ul style=&quot;font-size: initial;&quot;&gt;
            &lt;li style=&apos;list-style-type: square; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;Agrave;s vezes, o resumo da fun&amp;ccedil;&amp;atilde;o necess&amp;aacute;ria para esta parte pode ser retirado diretamente da se&amp;ccedil;&amp;atilde;o da especifica&amp;ccedil;&amp;atilde;o de n&amp;iacute;vel superior (se houver) que aloca fun&amp;ccedil;&amp;otilde;es espec&amp;iacute;ficas ao produto de software.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
            &lt;li style=&apos;list-style-type: square; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Casos de uso, hist&amp;oacute;rias de usu&amp;aacute;rios e cen&amp;aacute;rios tamb&amp;eacute;m s&amp;atilde;o usados para descrever as fun&amp;ccedil;&amp;otilde;es do produto.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
            &lt;/li&gt;
            &lt;li style=&apos;list-style-type: square; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Para fins de compreens&amp;atilde;o:&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; a) as fun&amp;ccedil;&amp;otilde;es do produto devem ser organizadas de forma que tornem a lista de fun&amp;ccedil;&amp;otilde;es gratuitas para o adquirente ou para qualquer outra pessoa que esteja lendo o documento pela primeira vez.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;b) m&amp;eacute;todos textuais ou gr&amp;aacute;ficos podem ser usados para mostrar as diferentes fun&amp;ccedil;&amp;otilde;es e seus relacionamentos.&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Caracter&amp;iacute;sticas do usu&amp;aacute;rio:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;D&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;escrever as caracter&amp;iacute;sticas gerais dos grupos pretendidos de usu&amp;aacute;rios do produto, revelando caracter&amp;iacute;sticas que influenciam a usabilidade, como n&amp;iacute;vel educacional, experi&amp;ecirc;ncia, defici&amp;ecirc;ncias e conhecimento t&amp;eacute;cnico. Esta descri&amp;ccedil;&amp;atilde;o deve declarar os motivos pelos quais certos requisitos espec&amp;iacute;ficos s&amp;atilde;o especificados posteriormente.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Limita&amp;ccedil;&amp;otilde;es:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&amp;nbsp; fornecemos uma descri&amp;ccedil;&amp;atilde;o geral de quaisquer outros itens que limitam as op&amp;ccedil;&amp;otilde;es do fornecedor, incluindo:&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;a) requisitos e pol&amp;iacute;ticas regulat&amp;oacute;rias;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;b) especifica&amp;ccedil;&amp;otilde;es de hardware (por exemplo, requisitos de temporiza&amp;ccedil;&amp;atilde;o de sinal);&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;c) interfaces para outros aplicativos;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;d) opera&amp;ccedil;&amp;atilde;o paralela;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;e) fun&amp;ccedil;&amp;otilde;es de auditoria;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;f) fun&amp;ccedil;&amp;otilde;es de controle;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;g) requisitos de linguagem de ordem superior;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;h) protocolos de handshake de sinal (por exemplo, XON-XOFF, ACK-NACK);&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;i) requisitos de qualidade (por exemplo, confiabilidade);&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;j) criticidade do aplicativo;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; k) considera&amp;ccedil;&amp;otilde;es de seguran&amp;ccedil;a;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; l) considera&amp;ccedil;&amp;otilde;es f&amp;iacute;sicas/mentais; e&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;m) especifica&amp;ccedil;&amp;otilde;es originadas de outros sistemas, incluindo requisitos em tempo real do sistema controlado por meio de interfaces.&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Requisitos&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
        &lt;ul style=&quot;font-size: initial;&quot;&gt;
            &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Defini&amp;ccedil;&amp;atilde;o de requisitos do usu&amp;aacute;rio: Descreva&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;os servi&amp;ccedil;os fornecidos ao usu&amp;aacute;rio. Os requisitos n&amp;atilde;o funcionais do sistema tamb&amp;eacute;m devem ser descritos nesta se&amp;ccedil;&amp;atilde;o. Esta descri&amp;ccedil;&amp;atilde;o pode usar linguagem natural, diagramas ou outras nota&amp;ccedil;&amp;otilde;es que sejam compreens&amp;iacute;veis para os clientes. Os padr&amp;otilde;es de produto e processo que devem ser seguidos devem ser especificados.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
            &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Especifica&amp;ccedil;&amp;atilde;o de requisitos de sistemas:&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Descrever os requisitos funcionais e n&amp;atilde;o funcionais em mais detalhes. Se necess&amp;aacute;rio, outros detalhes tamb&amp;eacute;m podem ser adicionais aos requisitos n&amp;atilde;o funcionais. Interfaces para outros sistemas podem ser acrescentadas.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
            &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Modelos de sistemas:&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Pode incluir modelos gr&amp;aacute;ficos de sistema mostrando os relacionamentos entre os componentes do sistema, o sistema e seu ambiente. Exemplos de modelos poss&amp;iacute;veis s&amp;atilde;o modelos de objetos, modelos de fluxo de dados ou modelos de dados sem&amp;acirc;nticos.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; color: rgb(12, 52, 61); font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Arquitetura do sistema:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Este item deve apresentar uma vis&amp;atilde;o geral de alto n&amp;iacute;vel da arquitetura planejada para o sistema, mostrando a distribui&amp;ccedil;&amp;atilde;o de fun&amp;ccedil;&amp;otilde;es entre os m&amp;oacute;dulos do sistema. Os componentes reutilizados devem ser destacados.&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; color: rgb(12, 52, 61); font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Evolu&amp;ccedil;&amp;atilde;o do sistema:&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;Descrever as suposi&amp;ccedil;&amp;otilde;es fundamentais nas quais o sistema &amp;eacute; baseado e quaisquer mudan&amp;ccedil;as antecipadas devido &amp;agrave; evolu&amp;ccedil;&amp;atilde;o do hardware, mudan&amp;ccedil;as nas necessidades do usu&amp;aacute;rio e assim por diante. Esta se&amp;ccedil;&amp;atilde;o &amp;eacute; &amp;uacute;til para projetistas de sistemas, pois pode ajud&amp;aacute;-los a evitar decis&amp;otilde;es de design que restrinjam mudan&amp;ccedil;as futuras prov&amp;aacute;veis no sistema.&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Ap&amp;ecirc;ndices:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&amp;nbsp;Fornecer informa&amp;ccedil;&amp;otilde;es detalhadas e espec&amp;iacute;ficas relacionadas ao sistema que est&amp;aacute; sendo desenvolvido. Por exemplo: autoridade de hardware e banco de dados. Os requisitos de hardware definem como configura&amp;ccedil;&amp;otilde;es m&amp;iacute;nimas e ideais para o sistema. Os requisitos do banco de dados definem a organiza&amp;ccedil;&amp;atilde;o l&amp;oacute;gica dos dados usados pelo sistema e pelos relacionamentos entre os dados.&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
        &lt;ul style=&quot;font-size: initial;&quot;&gt;
            &lt;li style=&apos;list-style-type: circle; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
                &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;Gloss&amp;aacute;rio: &amp;nbsp;&lt;/span&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;deve definir os termos t&amp;eacute;cnicos usados no documento. N&amp;atilde;o deve-se expor suposi&amp;ccedil;&amp;otilde;es sobre a experi&amp;ecirc;ncia ou conhecimento do leitor.&lt;/span&gt;&lt;/p&gt;
            &lt;/li&gt;
        &lt;/ul&gt;
    &lt;/li&gt;
    &lt;li style=&apos;list-style-type: disc; font-size: 12px; font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;
        &lt;p style=&quot;text-align: justify;&quot;&gt;&lt;strong&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;Iacute;ndice:&amp;nbsp;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&apos;color: rgb(12, 52, 61); background-color: rgb(255, 255, 255); font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;V&amp;aacute;rios &amp;iacute;ndices para o documento podem ser inclu&amp;iacute;dos. Al&amp;eacute;m de um &amp;iacute;ndice alfab&amp;eacute;tico normal, pode haver um &amp;iacute;ndice de diagramas, um &amp;iacute;ndice de fun&amp;ccedil;&amp;otilde;es e assim por diante.&lt;/span&gt;&lt;span style=&apos;font-family: &quot;Times New Roman&quot;, serif;&apos;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;
    &lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Valor estabelecido&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#VariaveisIdentificadas -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#VariaveisIdentificadas">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PassosElementosPrática"/>
        <untitled-ontology-3:atendidoPor rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PrepararParteCasoUso"/>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;Um caso de teste recebe algumas entradas, manipula os estados do sistema e produz alguns resultados. Estes aparecem como entradas, estados internos e sa&amp;iacute;das nos requisitos que o cen&amp;aacute;rio cobre. Neste n&amp;iacute;vel de detalhe, os intervalos aceit&amp;aacute;veis para as principais vari&amp;aacute;veis envolvidas no cen&amp;aacute;rio s&amp;atilde;o explicitamente identificados.&lt;/li&gt;
    &lt;li style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Use as entradas, sa&amp;iacute;das e estados internos dos requisitos relevantes para identificar vari&amp;aacute;veis adequadas.&lt;/li&gt;
    &lt;li style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Este n&amp;iacute;vel de detalhe &amp;eacute; adequado para os casos de teste em que solicitar a opini&amp;atilde;o do testador &amp;eacute; uma parte essencial do teste, por exemplo, ao realizar testes de usabilidade.&amp;nbsp;Tamb&amp;eacute;m pode ser usado quando &amp;eacute; necess&amp;aacute;ria mais estrutura para testes explorat&amp;oacute;rios e investigativos.&lt;/li&gt;
    &lt;li style=&quot;text-align: left; color: rgb(0, 0, 0); font-size: 12px;&quot;&gt;Uma vez identificadas, as vari&amp;aacute;veis podem ser caracterizadas e faixas mais detalhadas de insumos e resultados esperados podem ser especificados.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;strong&gt;Espera-se que:&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;Vari&amp;aacute;veis relevantes foram identificadas.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;Os intervalos aceit&amp;aacute;veis para as principais vari&amp;aacute;veis s&amp;atilde;o conhecidos. &lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;strong&gt;Vari&amp;aacute;veis identificadas&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Verificado -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Verificado">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
        <untitled-ontology-3:Icone>&lt;p&gt;Icone Estado Alpha&lt;/p&gt;</untitled-ontology-3:Icone>
        <untitled-ontology-3:descricao>&lt;ul&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: left; color: rgb(0, 0, 0);&quot;&gt;&lt;strong&gt;A fatia do caso de uso foi verificada como conclu&amp;iacute;da e est&amp;aacute; pronta para inclus&amp;atilde;o em uma vers&amp;atilde;o.&lt;/strong&gt;&lt;/span&gt;&lt;strong&gt;Os testes foram executados com sucesso: Os&lt;/strong&gt; testes foram executados com sucesso e um resultado aceit&amp;aacute;vel.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;&lt;strong&gt;O sistema de software passa em casos de teste suficientes:&amp;nbsp;&lt;/strong&gt;O sistema de software passa por um n&amp;uacute;mero suficiente de casos de teste para ser considerado de qualidade aceit&amp;aacute;vel pelas partes interessadas e pela equipe do projeto.&amp;nbsp;&lt;/li&gt;
    &lt;li style=&quot;font-size: 12px; text-align: justify;&quot;&gt;&lt;strong&gt;Casos de teste adicionados ao conjunto de regress&amp;atilde;o:&lt;/strong&gt; Os casos de teste s&amp;atilde;o adicionados ao(s) conjunto(s) de testes de regress&amp;atilde;o apropriado(s). &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Verificado&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</untitled-ontology-3:nome>
        <untitled-ontology-3:sequencia rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5</untitled-ontology-3:sequencia>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#VerificarListaCenariosDividaOcorre -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#VerificarListaCenariosDividaOcorre">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#PraticaDivida"/>
        <untitled-ontology-3:implementa rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#ListaControle"/>
        <untitled-ontology-3:classificacaoPratica>Comum</untitled-ontology-3:classificacaoPratica>
        <untitled-ontology-3:descricao>&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Verificar a lista de cen&amp;aacute;rios em que a d&amp;iacute;vida ocorre.&lt;/span&gt;&lt;/p&gt;</untitled-ontology-3:descricao>
        <untitled-ontology-3:nome>Lista de cenários da dívida</untitled-ontology-3:nome>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Viavel -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#Viavel">
        <rdf:type rdf:resource="http://www.semanticweb.org/vivid/ontologies/2023/2/untitled-ontology-3#EstadoAlpha"/>
